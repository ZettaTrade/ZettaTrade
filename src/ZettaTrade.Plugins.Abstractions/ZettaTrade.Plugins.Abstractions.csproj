<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ZettaTrade.Plugins.Abstractions</RootNamespace>
    <AssemblyName>ZettaTrade.Plugins.Abstractions</AssemblyName>
    <Version>1.0.0</Version>
    <Description>Versioned out-of-tree plugin contract (T-131): the manifest, the lifecycle, the services access and the UI extension descriptors. SemVer-governed — a breaking change bumps the major version and the pinned public surface fails CI.</Description>
  </PropertyGroup>

  <!-- The plugin SDK contract (T-131): plugin authors compile against this
       assembly alone — the app internals never leak into the surface. Core
       is referenced for the services a plugin legitimately reaches
       (market data adapters, settings, risk/confirmation); Livery stays
       out so the surface carries no Avalonia dependency — UI plugins bring
       their own and non-UI plugins stay light. -->
  <ItemGroup>
    <ProjectReference Include="..\ZettaTrade.Core\ZettaTrade.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
  </ItemGroup>

</Project>
