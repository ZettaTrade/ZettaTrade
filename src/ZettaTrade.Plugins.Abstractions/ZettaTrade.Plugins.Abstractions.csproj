<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ZettaTrade.Plugins.Abstractions</RootNamespace>
    <AssemblyName>ZettaTrade.Plugins.Abstractions</AssemblyName>
    <!-- NuGet packaging (T-163: the contract ships as a package on the
         private GitHub Packages feed; out-of-tree packs build against it).
         The version is the CONTRACT version - it moves only when the
         SemVer-governed golden surface test rewrites, never per alpha
         release. -->
    <PackageId>ZettaTrade.Plugins.Abstractions</PackageId>
    <Version>2.1.0</Version>
    <Authors>ZettaTrade Contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ZettaTrade/ZettaTrade.git</RepositoryUrl>
    <Description>Versioned out-of-tree plugin contract (T-131): the manifest, the lifecycle, the services access, the UI extension descriptors, the indicator seam (IIndicator + IndicatorBar, contract 2.0.0) and the strategy seam (IStrategy + StrategyContext + StrategyStance, contract 2.1.0). SemVer-governed — a breaking change bumps the major version and the pinned public surface fails CI.</Description>
  </PropertyGroup>

  <!-- The plugin SDK contract (T-131): plugin authors compile against this
       assembly alone - the app internals never leak into the surface. The
       pinned baseline test proves no app type ever reaches the public
       surface (only BCL and Microsoft.Extensions shapes ride it), so the
       package flows no dependency on the app's own projects: a stable
       package cannot carry the app's prerelease version, and out-of-tree
       consumers could not restore such a dependency (T-163). Livery stays
       out so the surface carries no Avalonia dependency - UI plugins bring
       their own and non-UI plugins stay light. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
  </ItemGroup>

</Project>
