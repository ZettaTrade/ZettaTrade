<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-visible on purpose: this project implements the EF design-
         time context factory; PrivateAssets keeps it out of consumers. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageReference Include="System.Reactive" Version="7.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Livery\Livery.csproj" />
    <ProjectReference Include="..\ZettaTrade.Charting\ZettaTrade.Charting.csproj" />
    <ProjectReference Include="..\ZettaTrade.Core\ZettaTrade.Core.csproj" />
  </ItemGroup>

  <!-- The test project pins the tolerant-number parser directly; assembly
       signature remains internal (no public surface). -->
  <ItemGroup>
    <InternalsVisibleTo Include="ZettaTrade.Infrastructure.Tests" />
  </ItemGroup>

</Project>
