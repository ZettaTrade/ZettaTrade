<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ZettaTrade.App.App"
             RequestedThemeVariant="Dark">
    <!-- The type/spacing/numeric tokens (T-155): the Livery dictionary the
         views read their ramp steps, scale steps and the numeric stack
         from. Static constants — merged once here, read everywhere. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Livery/Themes/Tokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <!-- The window chrome and the shell control restyling from Livery
             (T-066); after FluentTheme so the palette setters win. -->
        <StyleInclude Source="avares://Livery/Themes/Controls.axaml" />
    </Application.Styles>
</Application>
