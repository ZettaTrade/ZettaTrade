<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ZettaTrade.App.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        <!-- The window chrome and the shell control restyling from Livery
             (T-066); after FluentTheme so the palette setters win. -->
        <StyleInclude Source="avares://Livery/Themes/Controls.axaml" />
    </Application.Styles>
</Application>
