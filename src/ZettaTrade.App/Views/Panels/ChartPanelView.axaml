<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ZettaTrade.App.ViewModels"
             xmlns:loc="using:Livery.Localization"
             xmlns:charting="using:ZettaTrade.UI.Charting"
             xmlns:tools="using:ZettaTrade.Charting"
             xmlns:panels="using:ZettaTrade.App.Views.Panels"
             xmlns:controls="using:ZettaTrade.App.Controls"
             x:Class="ZettaTrade.App.Views.Panels.ChartPanelView"
             x:DataType="vm:ChartViewModel"
             x:Name="Root">

    <UserControl.Styles>
        <!-- The rail's splitter grip (T-177): the T-172 column-handle
             look, row-wise — the quiet hairline the drag grabs, tinting
             to the Accent on hover while the whole track keeps the
             north-south cursor. The styles live on the panel itself: the
             ONE panel instance carries the handle cross-window (the
             detached chart window hosts it too). -->
        <Style Selector="controls|RowResizeHandle">
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Cursor" Value="SizeNorthSouth" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <Border Background="Transparent" />
                        <Border x:Name="GripLine"
                                Height="1"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Border}" />
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="controls|RowResizeHandle:pointerover /template/ Border#GripLine">
            <Setter Property="Height" Value="3" />
            <Setter Property="CornerRadius" Value="1.5" />
            <Setter Property="Background" Value="{DynamicResource Accent}" />
        </Style>
        <!-- The overlay toggles (T-182): the chart's quiet overlay switches
             read dim ink at rest — the palette's own secondary role, so a
             theme retints the rest state deliberately — and the armed state
             answers in the kit's on-ink. The window-scoped rest would defeat
             the app-scoped .on (the T-181 mechanism), so the class ships its
             own .on sibling explicitly; no Background setter rides the
             class, so the generic hover/focus stay alive. -->
        <Style Selector="Button.overlay-toggle">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
        <Style Selector="Button.overlay-toggle.on">
            <Setter Property="Foreground" Value="{DynamicResource Highlight}" />
        </Style>
    </UserControl.Styles>

    <!-- The chart workspace panel (T-103): the exact content the main
         window's chart column carried, extracted one-for-one so the SAME
         control instance hosts in the main window's workspace column or in
         the detached chart window (the detach moves the control, never a
         copy). The HUD's frame-tap gate rides the panel's own
         HudFrameTapSource property: the main window binds it to the HUD
         visibility, the detached window leaves it off — the HUD tap readout
         freezes while the chart lives in its own window (the HUD is a
         main-window overlay; its detached counterpart is out of T-103
         scope). -->
    <Grid x:Name="PanelGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <!-- The rail's splitter track (T-177): the thin band the row
                 handle rides, between the chart's star row and the rail's
                 persisted-height row. -->
            <RowDefinition Height="8" />
            <RowDefinition Height="{Binding SignalRail.RailHeight, Mode=TwoWay}"
                           MinHeight="{Binding SignalRail.MinRailHeight}"
                           MaxHeight="{Binding SignalRail.MaxRailHeight}" />
        </Grid.RowDefinitions>
        <!-- Header: the symbol picker owns a stretch row; the controls
             ride a finite wrap band BELOW it (T-145: the old one-line
             16-column header's auto sum overflowed the panel width, and
             the chart Border — the workspace grid's last child — painted
             the spillover over the book, tape and watchlist panels; the
             wrap band folds onto further lines when the column narrows;
             the port rides the T-103 panel host, where the header lives
             since the chart's ONE control instance moves cross-window).
             The star badge marks the favorites (both marks are managed
             in the settings window's pairs tab); the time frame picker
             rides the same load key, so a flip reloads the chart live;
             the overlay toggles (T-093) sit next to it, the persisted
             choices mirroring their on/off state through the toggles'
             own class, the candles export writes the loaded series to
             a user-chosen CSV file, and the drawing tools (T-091) ride
             the same band. -->
        <Grid Grid.Row="0"
              RowDefinitions="Auto,Auto"
              RowSpacing="{StaticResource SpaceS}"
              Margin="0,0,0,8">
            <ComboBox Grid.Row="0"
                      ItemsSource="{Binding AvailableSymbols}"
                      SelectedItem="{Binding SelectedSymbolRow}">
                <ComboBox.ItemTemplate>
                    <!-- One row: the star badge on the favorites,
                         the symbol name. The row record carries the
                         mark (rebuilt on every change), so the
                         template binds within its own data type. -->
                    <DataTemplate x:DataType="vm:SymbolRow">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                            <TextBlock Text="★"
                                       Foreground="{DynamicResource Highlight}"
                                       FontSize="{StaticResource SubtitleStrongFontSize}"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding IsFavorite}" />
                            <TextBlock Text="{Binding Symbol.Normalized}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <WrapPanel Grid.Row="1">
                <TextBlock Text="{loc:Localized Chart.TimeFrame}"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0" />
                <ComboBox MinWidth="72"
                          ItemsSource="{Binding TimeFrames}"
                          SelectedItem="{Binding SelectedTimeFrame}" />
                <!-- Chart type selector (T-089): five static localized
                     items bound by index (the SelectedThemeIndex shim
                     precedent) — the localized strings never touch the
                     ViewModel, and the language switch re-inks them live. -->
                <TextBlock Text="{loc:Localized Chart.Type}"
                           VerticalAlignment="Center"
                           Margin="12,0,4,0" />
                <ComboBox MinWidth="92"
                          SelectedIndex="{Binding SelectedChartTypeIndex}"
                          ToolTip.Tip="{loc:Localized Chart.Type.Tip}">
                    <TextBlock Text="{loc:Localized Chart.Type.Candles}" />
                    <TextBlock Text="{loc:Localized Chart.Type.Line}" />
                    <TextBlock Text="{loc:Localized Chart.Type.Area}" />
                    <TextBlock Text="{loc:Localized Chart.Type.Bars}" />
                    <TextBlock Text="{loc:Localized Chart.Type.HeikinAshi}" />
                </ComboBox>
                <!-- Y-axis scale mode selector (T-090): three static
                     localized items bound by index (the chart-type
                     shim precedent) — the localized strings never
                     touch the ViewModel, and the language switch
                     re-inks them live. -->
                <TextBlock Text="{loc:Localized Chart.ScaleMode}"
                           VerticalAlignment="Center"
                           Margin="12,0,4,0" />
                <ComboBox MinWidth="92"
                          SelectedIndex="{Binding SelectedScaleModeIndex}"
                          ToolTip.Tip="{loc:Localized Chart.ScaleMode.Tip}">
                    <TextBlock Text="{loc:Localized Chart.ScaleMode.Linear}" />
                    <TextBlock Text="{loc:Localized Chart.ScaleMode.Log}" />
                    <TextBlock Text="{loc:Localized Chart.ScaleMode.Percent}" />
                </ComboBox>
                <Button Content="{loc:Localized Chart.Vwap}"
                        Command="{Binding ToggleVwapCommand}"
                        ToolTip.Tip="{loc:Localized Chart.Vwap.Tip}"
                        Classes.on="{Binding ShowVwap}"
                        MinWidth="72"
                        Margin="8,4,0,4"
                        Classes="overlay-toggle" />
                <Button Content="{loc:Localized Chart.VolumeProfile}"
                        Command="{Binding ToggleVolumeProfileCommand}"
                        ToolTip.Tip="{loc:Localized Chart.VolumeProfile.Tip}"
                        Classes.on="{Binding ShowVolumeProfile}"
                        MinWidth="92"
                        Margin="8,4,0,4"
                        Classes="overlay-toggle" />
                <!-- The export flyout (T-160): the three export actions
                     gather under one icon — the band's narrowest step
                     wins without hiding any action. Each item keeps its
                     caption (the header text is the item's automation
                     name) and its own command; the two exported-shape
                     tips stay on their items. The flyout button itself
                     is named for the screen reader: an icon-only
                     control's name never rides its tooltip. -->
                <Button Classes="icon"
                        ToolTip.Tip="{loc:Localized Chart.Export}"
                        AutomationProperties.Name="{loc:Localized Chart.Export}"
                        Margin="8,4,0,4">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="{loc:Localized Chart.ExportCandlesCsv}"
                                      Command="{Binding ExportCandlesCommand}" />
                            <!-- The export pair (T-094): the PNG snapshot
                                 renders the current frame (same lens, same
                                 annotations) at a fixed scale with the
                                 symbol/timeframe watermark; the second CSV
                                 item exports exactly the visible range. -->
                            <MenuItem Header="{loc:Localized Chart.ExportPng}"
                                      ToolTip.Tip="{loc:Localized Chart.ExportPng.Tip}"
                                      Command="{Binding ExportPngCommand}" />
                            <MenuItem Header="{loc:Localized Chart.ExportVisibleCsv}"
                                      ToolTip.Tip="{loc:Localized Chart.ExportVisibleCsv.Tip}"
                                      Command="{Binding ExportVisibleCandlesCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>
                    <Path Stretch="None"
                          StrokeThickness="1.5"
                          Stroke="{DynamicResource TextPrimary}"
                          Data="M 6 8 V 2 M 3 5 L 6 2 L 9 5 M 1 8 V 11 H 11 V 8" />
                </Button>
                <!-- The compare action (T-124): a second series of
                     the standing interval alongside the workspace
                     one, each percent-rebased to its own zero. The
                     pick rides the global palette's compare mode;
                     the chart's legend chips carry their own detach
                     press zones. -->
                <Button Content="{loc:Localized Chart.Compare}"
                        Command="{Binding CompareCommand}"
                        ToolTip.Tip="{loc:Localized Chart.Compare.Tip}"
                        MinWidth="92"
                        Margin="8,4,0,4" />
                <!-- The drawing tools palette (T-091, T-160): each toggle
                     arms its tool on the chart control (a same-tool
                     press stands it down); the controls speak the kit's
                     icon shape — borderless glyph buttons whose armed
                     state rides the .on class (full-bright, the glyph
                     stroking in the armed ink) and whose captions became
                     the automation names (the icon-only controls' names
                     never ride their tooltips). The glyphs draw like the
                     title-bar strip's: explicit strokes, no inheritance
                     chain; a placed drawing persists through the chart
                     ViewModel. -->
                <Button Classes="icon"
                        Classes.on="{Binding IsTrendLineToolActive}"
                        Command="{Binding ToolCommand}"
                        CommandParameter="{x:Static tools:ChartDrawingTool.TrendLine}"
                        ToolTip.Tip="{loc:Localized Chart.Tool.TrendLine.Tip}"
                        AutomationProperties.Name="{loc:Localized Chart.Tool.TrendLine}"
                        Margin="8,4,0,4">
                    <Path Stretch="None"
                          StrokeThickness="1.5"
                          Stroke="{DynamicResource TextPrimary}"
                          Data="M 1.5 10.5 L 10.5 1.5" />
                </Button>
                <Button Classes="icon"
                        Classes.on="{Binding IsLevelToolActive}"
                        Command="{Binding ToolCommand}"
                        CommandParameter="{x:Static tools:ChartDrawingTool.HorizontalLevel}"
                        ToolTip.Tip="{loc:Localized Chart.Tool.Level.Tip}"
                        AutomationProperties.Name="{loc:Localized Chart.Tool.Level}"
                        Margin="8,4,0,4">
                    <Path Stretch="None"
                          StrokeThickness="1.5"
                          Stroke="{DynamicResource TextPrimary}"
                          Data="M 1 6 H 11" />
                </Button>
                <Button Classes="icon"
                        Classes.on="{Binding IsFibToolActive}"
                        Command="{Binding ToolCommand}"
                        CommandParameter="{x:Static tools:ChartDrawingTool.FibRetracement}"
                        ToolTip.Tip="{loc:Localized Chart.Tool.Fib.Tip}"
                        AutomationProperties.Name="{loc:Localized Chart.Tool.Fib}"
                        Margin="8,4,0,4">
                    <Path Stretch="None"
                          StrokeThickness="1.5"
                          Stroke="{DynamicResource TextPrimary}"
                          Data="M 1 2 H 11 M 1 6 H 11 M 1 10 H 11" />
                </Button>
                <!-- The wave-2 kinds (T-200): the zone's band, the text
                     annotation's prompt and the measure ruler's readout.
                     Same grammar as the wave-1 tools: a press arms (or
                     toggles off), the control's placement machine owns the
                     gesture, the chart ViewModel owns persistence. -->
                <Button Classes="icon"
                        Classes.on="{Binding IsZoneToolActive}"
                        Command="{Binding ToolCommand}"
                        CommandParameter="{x:Static tools:ChartDrawingTool.Zone}"
                        ToolTip.Tip="{loc:Localized Chart.Tool.Zone.Tip}"
                        AutomationProperties.Name="{loc:Localized Chart.Tool.Zone}"
                        Margin="8,4,0,4">
                    <Path Stretch="None"
                          StrokeThickness="1.5"
                          Stroke="{DynamicResource TextPrimary}"
                          Data="M 2.5 3.5 H 9.5 V 8.5 H 2.5 Z" />
                </Button>
                <Button Classes="icon"
                        Classes.on="{Binding IsTextToolActive}"
                        Command="{Binding ToolCommand}"
                        CommandParameter="{x:Static tools:ChartDrawingTool.Text}"
                        ToolTip.Tip="{loc:Localized Chart.Tool.Text.Tip}"
                        AutomationProperties.Name="{loc:Localized Chart.Tool.Text}"
                        Margin="8,4,0,4">
                    <Path Stretch="None"
                          StrokeThickness="1.5"
                          Stroke="{DynamicResource TextPrimary}"
                          Data="M 2 3 H 10 M 6 3 V 9 M 4.5 9 H 7.5" />
                </Button>
                <Button Classes="icon"
                        Classes.on="{Binding IsMeasureToolActive}"
                        Command="{Binding ToolCommand}"
                        CommandParameter="{x:Static tools:ChartDrawingTool.Measure}"
                        ToolTip.Tip="{loc:Localized Chart.Tool.Measure.Tip}"
                        AutomationProperties.Name="{loc:Localized Chart.Tool.Measure}"
                        Margin="8,4,0,4">
                    <Path Stretch="None"
                          StrokeThickness="1.5"
                          Stroke="{DynamicResource TextPrimary}"
                          Data="M 2.5 8.5 L 9.5 3.5 M 4.2 4.3 L 4.9 5 M 6 5.6 L 6.7 6.3 M 7.8 6.9 L 8.5 7.6" />
                </Button>
                <!-- The delete affordance (T-178): the selected drawing's
                     removal is discoverable — the button rides the same
                     route the chart's Delete key names (the selection
                     clears, the layer saves), and its standing-selection
                     gate leaves it disabled with nothing selected. The
                     chart's own Delete/Escape keys surface in the tooltip:
                     the hotkey registry carries only the window-level
                     actions, the chart control's keys live here. -->
                <Button Classes="icon"
                        x:Name="DeleteDrawingButton"
                        Command="{Binding DeleteSelectedDrawingCommand}"
                        ToolTip.Tip="{loc:Localized Chart.Drawing.Delete.Tip}"
                        AutomationProperties.Name="{loc:Localized Chart.Drawing.Delete}"
                        Margin="8,4,0,4">
                    <Path Stretch="None"
                          StrokeThickness="1.5"
                          Stroke="{DynamicResource TextPrimary}"
                          Data="M 2.5 4.5 H 9.5 M 4.5 4.5 V 2.5 H 7.5 V 4.5 M 3.5 4.5 L 4.2 11.5 H 7.8 L 8.5 4.5" />
                </Button>
            </WrapPanel>
        </Grid>

        <!-- Export failure -->
        <TextBlock Grid.Row="1"
                   Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource Error}"
                   TextWrapping="Wrap"
                   IsVisible="{Binding HasErrorMessage}"
                   Margin="0,0,0,8" />

        <!-- Deep-history end note (T-086): where the feed's
             candle series ends — shown while the loaded
             history proved a limit. -->
        <TextBlock Grid.Row="2"
                   Text="{Binding HistoryLimitNote}"
                   Foreground="{DynamicResource TextPrimary}"
                   TextWrapping="Wrap"
                   IsVisible="{Binding HasHistoryLimitNote}"
                   Margin="0,0,0,8" />

        <!-- Chart: the T-093 overlays ride the same
             publish path the indicator lines do (the
             VWAP computed against the loaded series;
             the toggled profile recomputes with the
             visible window on every pass). The T-089
             selector switches the renderer variant;
             the Heikin-Ashi series publishes smoothed
             HA bars aligned with the loaded series. The
             frame-tap gate rides the panel's own
             HudFrameTapSource (the host decides whether
             the HUD counts this panel's frames). -->
        <charting:CandlestickChart x:Name="CandlesChart" Grid.Row="3"
                                   Bars="{Binding Bars}"
                                   Use12HourClock="{Binding Use12HourClock}"
                                   VwapOverlay="{Binding VwapOverlay}"
                                   VolumeProfileVisible="{Binding ShowVolumeProfile}"
                                   IndicatorLines="{Binding IndicatorLines}"
                                   SeriesType="{Binding ChartType}"
                                   ScaleMode="{Binding ScaleMode}"
                                   HeikinAshiBars="{Binding HeikinAshiBars}"
                                   SignalMarkers="{Binding SignalMarkers}"
                                   TradingPosition="{Binding TradingPosition}"
                                   TradingOrders="{Binding TradingOrders}"
                                   TradingFills="{Binding TradingFills}"
                                   MainSeriesLabel="{Binding MainSeriesLabel}"
                                   CompareLayers="{Binding CompareLayers}"
                                   Drawings="{Binding Drawings}"
                                   ActiveTool="{Binding ActiveDrawingTool}"
                                   SelectedDrawingId="{Binding SelectedDrawingId}"
                                   MeasureStopPrice="{Binding MeasureStopPrice}"
                                   FrameTapEnabled="{Binding $parent[panels:ChartPanelView].HudFrameTapSource}" />
                                    <!-- T-122: the trading footprint — my own position entry, working orders and fills, overlay-only (nothing routes back toward an order). -->
                                    <!-- T-124: the compare overlays — the chip strip's main label follows the workspace symbol; the layers are transient chart-level state. -->
                                    <!-- T-091: the drawings layer — the persisted annotation list, the palette's armed tool and the selection ride one-way in; the control's interaction events mirror out through the host window's subscriptions. -->

        <!-- Signal rail (T-112): the latest strategy readings
             streaming under the chart — one coalesced rows
             replacement per window, a bounded newest-first
             ring (the coalescing lives in the rail's own
             VM). A row press rides the host window's PREFILL
             route (the same transient dialog path the
             order book's level presses share); a signal
             never sends an order itself — the human
             decides on the ticket. The rail's height is
             persisted state (T-177): its row rides the
             TwoWay RailHeight binding above, the splitter
             track row feeds the drags in, and the overflow
             scrolls once the rows outgrow the rail. -->
        <controls:RowResizeHandle x:Name="RailRowHandle" Grid.Row="4" />
        <Border x:Name="RailBorder"
                Grid.Row="5"
                Padding="4,4,4,0"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="0,1,0,0"
                DataContext="{Binding SignalRail}">
            <Grid RowDefinitions="Auto,*">
                <!-- The rail head rides the kit's panel-header scaffold
                     (T-160): the one padding grammar and the title
                     treatment live in the kit — no hand-typed margins.
                     The host Border's own planar padding stays the
                     rows' inset; the head's effective inset rides the
                     scaffold on top of it. -->
                <DockPanel Grid.Row="0" Classes="panel-header">
                    <TextBlock Text="{loc:Localized Signal.Rail.Title}" />
                </DockPanel>
                <Grid Grid.Row="1">
                    <TextBlock Text="{loc:Localized Signal.Rail.Empty}"
                               Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center"
                               Margin="4,0"
                               IsVisible="{Binding IsEmpty}" />
                    <!-- The rows surface scrolls (T-177): the overflow
                         stays reachable — the newest-first order is the
                         rows list's own, the scroller only reveals the
                         ring's tail. -->
                    <ScrollViewer x:Name="RailRowsScroller"
                                  IsVisible="{Binding HasRows}"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Rows, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SignalRailRow">
                                    <!-- One reading: the side accent dot
                                         (the stance's direction read), the
                                         composed facts, the time. The row is
                                         a Button: the whole line is the
                                         prefill affordance; the tooltip names
                                         what a click does and does not do. -->
                                    <Button Command="{Binding PrefillCommand}"
                                            ToolTip.Tip="{Binding Tooltip}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Padding="8,4"
                                            Background="Transparent"
                                            BorderThickness="0">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                                            <Ellipse Width="8"
                                                     Height="8"
                                                     VerticalAlignment="Center"
                                                     Classes.long="{Binding IsEntryLong}"
                                                     Classes.flat="{Binding IsEntryFlat}">
                                                <Ellipse.Styles>
                                                    <Style Selector="Ellipse.long">
                                                        <Setter Property="Fill" Value="{DynamicResource CandleUp}" />
                                                    </Style>
                                                    <Style Selector="Ellipse.flat">
                                                        <Setter Property="Fill" Value="{DynamicResource TextSecondary}" />
                                                    </Style>
                                                </Ellipse.Styles>
                                            </Ellipse>
                                            <TextBlock Text="{Binding CandleTime}"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding StrategyId}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding StanceLabel}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding SymbolText}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding PriceText}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
