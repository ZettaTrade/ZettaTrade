<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ZettaTrade.App.ViewModels"
        xmlns:loc="using:Livery.Localization"
        xmlns:charting="using:ZettaTrade.UI.Charting"
        xmlns:tools="using:ZettaTrade.Charting"
        xmlns:app="using:ZettaTrade.App"
        x:Class="ZettaTrade.App.Views.MainWindow"
        Classes="chrome"
        x:DataType="vm:MainViewModel"
        Title="{loc:Localized Chrome.Title}"
        Width="1400" Height="900"
        MinWidth="1024" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Background}">

    <!-- The global hotkeys (T-102): no static KeyBindings remain — the
         window's only key route is the code-behind handler in
         OnOpened (OnGlobalKeyDown), which translates every pressed
         combination through the live registry map (TryMatch) into
         MainViewModel.RouteHotkey. The menu items below print their
         advertised gestures from the SAME live map, so the advertised
         and the real binding never diverge. -->

    <!-- The window content root is a grid so the T-095 palette overlay can
         ride ON TOP of the workspace as a sibling: the overlay only receives
         keys routed from inside itself, which keeps the palette route and the
         workspace's own key surface strictly apart. -->
    <Grid>
        <DockPanel>
        <!-- Top menu bar -->
        <Menu DockPanel.Dock="Top" DataContext="{Binding Menu}">
            <MenuItem Header="{loc:Localized Menu.File}">
                <MenuItem Header="{loc:Localized Menu.File.Settings}" Command="{Binding OpenSettingsCommand}" InputGesture="{Binding Hotkeys.SettingsGesture}" />
                <Separator />
                <MenuItem Header="{loc:Localized Menu.File.Exit}" Command="{Binding ExitCommand}" InputGesture="Alt+F4" />
            </MenuItem>
            <MenuItem Header="{loc:Localized Menu.Trading}">
                <MenuItem Header="{loc:Localized Menu.Trading.NewOrder}" Command="{Binding NewOrderCommand}" InputGesture="{Binding Hotkeys.NewOrderGesture}" />
                <MenuItem Header="{loc:Localized Menu.Trading.Positions}" Command="{Binding ShowPositionsCommand}" />
                <MenuItem Header="{loc:Localized Menu.Trading.Balances}" Command="{Binding ShowBalancesCommand}" />
                <MenuItem Header="{loc:Localized Menu.Trading.OrderHistory}" Command="{Binding ShowOrderHistoryCommand}" />
                <MenuItem Header="{loc:Localized Menu.Trading.Stats}" Command="{Binding ShowTradeStatsCommand}" />
                <MenuItem Header="{loc:Localized Menu.Trading.Backtest}" Command="{Binding ShowBacktestCommand}" />
                <MenuItem Header="{loc:Localized Menu.Trading.Notifications}" Command="{Binding ShowNotificationsCommand}" />
                <MenuItem Header="{loc:Localized Menu.Trading.Alerts}" Command="{Binding ShowAlertsCommand}" />
            </MenuItem>
            <MenuItem Header="{loc:Localized Menu.AI}">
                <MenuItem Header="{loc:Localized Menu.AI.Chat}"
                          Command="{Binding ToggleAiChatCommand}"
                          ToggleType="CheckBox"
                          IsChecked="{Binding IsAiChatVisible, Mode=OneWay}"
                          InputGesture="{Binding Hotkeys.AiChatGesture}" />
                <MenuItem Header="{loc:Localized Menu.AI.Servers}" Command="{Binding ManageMcpServersCommand}" />
            </MenuItem>
            <!-- Help: the log viewer (T-101) — the file-only Serilog sinks are
                 otherwise reachable only through a text editor — and the
                 disclaimer re-show path ("About / Disclaimer"): the SAME
                 dialog the first run shows, so the alpha wording stays
                 discoverable after the acknowledgment lives in the settings. -->
            <MenuItem Header="{loc:Localized Menu.Help}">
                <MenuItem Header="{loc:Localized Menu.Help.LogViewer}" Command="{Binding ShowLogViewerCommand}" />
                <!-- The performance HUD (T-108): the checkable dev-mode
                     readout (chart fps, book rate and latency, memory,
                     backpressure gauge) — off by default, the flip
                     persists into Diagnostics.HudEnabled. -->
                <MenuItem Header="{loc:Localized Menu.Help.PerformanceHud}"
                          Command="{Binding ToggleHudCommand}"
                          ToggleType="CheckBox"
                          IsChecked="{Binding IsHudVisible, Mode=OneWay}" />
                <!-- The hotkey cheat sheet (T-102): the checkable "?" that
                     lists the live gesture map — the overlay is a palette
                     sibling below, and the press routes the sheet's own
                     toggle command (the checkbox mirrors OneWay). -->
                <MenuItem Header="{loc:Localized Menu.Help.Hotkeys}"
                          Command="{Binding Hotkeys.ToggleSheetCommand}"
                          ToggleType="CheckBox"
                          IsChecked="{Binding Hotkeys.IsSheetVisible, Mode=OneWay}" />
                <Separator />
                <MenuItem Header="{loc:Localized Menu.Help.AboutDisclaimer}" Command="{Binding ShowDisclaimerCommand}" />
            </MenuItem>
        </Menu>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SystemAccentColorLight2}"
                Padding="8,4"
                DataContext="{Binding StatusBar}">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{loc:Localized Status.Ready}" VerticalAlignment="Center" />
                <!-- One concept, one control (T-016 anti-confusion rules): the
                     exchange picker renders only when two or more adapters are
                     registered; the trading mode never folds into the picker —
                     exchange and mode are two different decisions. -->
                <ComboBox Grid.Column="1"
                          IsVisible="{Binding HasExchangeChoice}"
                          ItemsSource="{Binding ExchangeNames}"
                          SelectedItem="{Binding SelectedExchangeName, Mode=TwoWay}"
                          MinWidth="96"
                          Margin="16,0"
                          VerticalAlignment="Center"
                          ToolTip.Tip="{loc:Localized Status.ExchangePicker}" />
                <!-- The trading lane chip (T-123): the always-visible
                     PAPER/TESTNET/LIVE pill next to the active exchange
                     name. The lane is a property of the TRADED surface (the
                     trading-mode service's stream), never of the market
                     data picker (T-016: exchange and mode are two
                     different decisions). Colors reuse the palette keys the
                     adapter health dots already speak — calm CandleUp,
                     prompt Highlight, danger Error — and re-tint live on
                     theme switches; the caption and tooltip are dynamic
                     localized data from the view model. -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            Margin="16,0"
                            VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="{Binding ActiveExchangeName}" />
                    </TextBlock>
                    <Border CornerRadius="9"
                            Padding="8,2"
                            VerticalAlignment="Center"
                            ToolTip.Tip="{Binding TradingLaneTooltip}"
                            Classes.paper="{Binding IsPaperLane}"
                            Classes.testnet="{Binding IsTestnetLane}"
                            Classes.live="{Binding IsLiveLane}">
                        <Border.Styles>
                            <Style Selector="Border.paper">
                                <Setter Property="Background" Value="{DynamicResource CandleUp}" />
                            </Style>
                            <Style Selector="Border.testnet">
                                <Setter Property="Background" Value="{DynamicResource Highlight}" />
                            </Style>
                            <Style Selector="Border.live">
                                <Setter Property="Background" Value="{DynamicResource Error}" />
                            </Style>
                        </Border.Styles>
                        <TextBlock Text="{Binding TradingLaneLabel}"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
                <TextBlock Grid.Column="3" Text="{Binding ConnectionStatus}" Margin="16,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="{Binding CurrentThemeName}" Margin="16,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="{Binding CurrentLanguage}" Margin="16,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="6" Text="{Binding AppVersion}" Margin="16,0" VerticalAlignment="Center" />
                <!-- The adapter health strip (T-098): one dot per registered
                     adapter. The palette keys re-tint live on theme switches
                     (DynamicResource); the state flags are what the dot's
                     styles pick the fill from — connected / reconnecting /
                     down / unsupervised, and the localized tooltip carries
                     the last event moment and the failure counter. -->
                <ItemsControl Grid.Column="7"
                              ItemsSource="{Binding AdapterHealthRows}"
                              Margin="8,0"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Ellipse Width="9"
                                     Height="9"
                                     VerticalAlignment="Center"
                                     ToolTip.Tip="{Binding Tooltip}"
                                     Classes.connected="{Binding IsConnected}"
                                     Classes.reconnecting="{Binding IsReconnecting}"
                                     Classes.down="{Binding IsDown}"
                                     Classes.unsupervised="{Binding IsUnsupervised}">
                                <Ellipse.Styles>
                                    <Style Selector="Ellipse.connected">
                                        <Setter Property="Fill" Value="{DynamicResource CandleUp}" />
                                    </Style>
                                    <Style Selector="Ellipse.reconnecting">
                                        <Setter Property="Fill" Value="{DynamicResource Highlight}" />
                                    </Style>
                                    <Style Selector="Ellipse.down">
                                        <Setter Property="Fill" Value="{DynamicResource Error}" />
                                    </Style>
                                    <Style Selector="Ellipse.unsupervised">
                                        <Setter Property="Fill" Value="{DynamicResource TextSecondary}" />
                                    </Style>
                                </Ellipse.Styles>
                            </Ellipse>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- Main content area: the workspace column is the flexible star; the
             book and assistant columns carry the persisted widths the
             draggable splitters write (T-038), and the assistant-side
             splitter track and its column collapse with the panel's
             visibility so a hidden panel never leaves a dead gutter. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{Binding Layout.AiSplitterColumnWidth}" />
                <ColumnDefinition Width="{Binding Layout.AiColumnWidth, Mode=TwoWay}"
                                  MinWidth="{Binding Layout.AiColumnMinWidth}" />
            </Grid.ColumnDefinitions>

            <!-- Book/assistant splitter: drags resize the persisted assistant
                 column (the star workspace absorbs the difference); hidden
                 with the panel so the collapsed geometry stays grab-free. -->
            <GridSplitter Grid.Column="1"
                          Focusable="True"
                          IsVisible="{Binding Chat.IsAiChatVisible}" />

            <!-- Left: Trading workspace (charts, order book, etc.) -->
            <Border Grid.Column="0" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="{Binding Layout.BookColumnWidth, Mode=TwoWay}"
                                          MinWidth="{x:Static app:UiSettingsKeys.MinBookPanelWidth}" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="{Binding Layout.TapeColumnWidth, Mode=TwoWay}"
                                          MinWidth="{x:Static app:UiSettingsKeys.MinTapePanelWidth}" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="{Binding Layout.WatchlistColumnWidth, Mode=TwoWay}"
                                          MinWidth="{x:Static app:UiSettingsKeys.MinWatchlistPanelWidth}" />
                    </Grid.ColumnDefinitions>

                    <!-- Chart/book splitter: drags resize the persisted book
                         column; the chart keeps its flexible star. -->
                    <GridSplitter Grid.Column="1" Focusable="True" />

                    <!-- Depth panel: a free-typed symbol (works offline like the
                         dialog), switched live streams of the parsed symbol.
                         One column hosts the ladder (top) and the cumulative
                         depth profile (bottom): both bind the same published
                         book, so the two always agree on the resolved depth. -->
                    <Border Grid.Column="2"
                            Margin="8,0,0,0"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                            BorderThickness="1,0,0,0"
                            DataContext="{Binding OrderBook}">
                        <Grid RowDefinitions="Auto,*,Auto,*">
                            <TextBlock Grid.Row="0"
                                       Text="{loc:Localized OrderBook.Title}"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Margin="8,0,0,4" />
                            <charting:OrderBookWidget x:Name="BookWidget" Grid.Row="1" Book="{Binding Book}" />
                            <!-- Depth chart: the cumulative shape of the same
                                 served snapshot the ladder binds (no new
                                 transport; the two panels resolve one depth). -->
                            <TextBlock Grid.Row="2"
                                       Text="{loc:Localized OrderBook.DepthTitle}"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Margin="8,0,0,4" />
                            <charting:DepthChartWidget x:Name="DepthWidget" Grid.Row="3" Book="{Binding Book}" />
                        </Grid>
                    </Border>

                    <!-- Book/tape splitter: drags resize the persisted tape
                         column; the book column keeps its persisted width. -->
                    <GridSplitter Grid.Column="3" Focusable="True" />

                    <!-- Trade tape panel: the newest trades on top (side
                         coloring on the aggressor), pauses on hover, clears
                         on the button; a switched symbol clears the old
                         symbol's rows in the widget. -->
                    <Border Grid.Column="4"
                            Margin="8,0,0,0"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                            BorderThickness="1,0,0,0"
                            DataContext="{Binding TradeTape}">
                        <Grid RowDefinitions="Auto,*">
                            <DockPanel Grid.Row="0" Margin="8,0,4,4">
                                <Button x:Name="TapeClearButton"
                                        DockPanel.Dock="Right"
                                        Content="{loc:Localized Tape.Clear}"
                                        Click="OnTapeClearClick"
                                        MinWidth="72" />
                                <TextBlock Text="{loc:Localized Tape.Title}"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <charting:TradeTapeWidget x:Name="TapeWidget" Grid.Row="1" Trades="{Binding Updates}" />
                        </Grid>
                    </Border>

                    <!-- Tape/watchlist splitter: drags resize the persisted
                         watchlist column; the tape column keeps its width. -->
                    <GridSplitter Grid.Column="5" Focusable="True" />

                    <!-- Right rail: the watchlist (T-120) and the market
                         heatmap (T-121) share the persisted column as tabs —
                         neighbors by composition; the strip's splitter
                         geometry above stays untouched. The heat tab's
                         metric switch appears only when ranked data exists
                         (nothing fabricated for a missing feed); the field
                         re-inks on every feed page, the tile presses route
                         into the workspace symbol. -->
                    <TabControl Grid.Column="6"
                                Margin="8,0,0,0">
                        <TabItem Header="{loc:Localized Watch.Title}"
                                 DataContext="{Binding Watchlist}">
                            <!-- Watchlist panel: the feed-paced majors rows plus the
                                 workspace selection's row; each row keeps a stable
                                 identity (only its fields churn per pulse), the
                                 sparkline rides the row's own price ring. -->
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                    BorderThickness="1,0,0,0">
                                <ListBox ItemsSource="{Binding Rows}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:WatchlistRowViewModel">
                                            <Grid ColumnDefinitions="*,Auto" Margin="8,3,4,3">
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SymbolText}"
                                                               FontWeight="Bold" />
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{Binding LastPriceText}" />
                                                        <TextBlock Text="{Binding Change24hText}" />
                                                        <TextBlock Text="{Binding Volume24hText}"
                                                                   Opacity="0.65" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <!-- The sparkline: the viewport's one
                                                     synthetic shape, the row's price
                                                     ring mapped onto the canvas (the
                                                     ring itself lives in the feed). -->
                                                <Polyline Grid.Column="1"
                                                          Width="96"
                                                          Height="28"
                                                          VerticalAlignment="Center"
                                                          Points="{Binding SparklinePoints}"
                                                          Stroke="{DynamicResource Highlight}"
                                                          StrokeThickness="1.5" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </TabItem>
                        <TabItem DataContext="{Binding Heatmap}"
                                 Header="{loc:Localized Heatmap.Title}">
                            <Grid RowDefinitions="Auto,*">
                                <!-- The metric switch: static localized items bound
                                     by index (the chart type selector's shim), and
                                     the whole row only exists when the feed carries
                                     ranked pairs — an empty venue owns no switch. -->
                                <StackPanel Grid.Row="0"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            Margin="8,4,0,4"
                                            IsVisible="{Binding HasData}">
                                    <TextBlock Text="{loc:Localized Heatmap.Metric}"
                                               VerticalAlignment="Center" />
                                    <ComboBox MinWidth="92"
                                              SelectedIndex="{Binding SelectedMetricIndex}">
                                        <TextBlock Text="{loc:Localized Heatmap.Metric.QuoteVolume}" />
                                        <TextBlock Text="{loc:Localized Heatmap.Metric.Change}" />
                                    </ComboBox>
                                </StackPanel>
                                <!-- The tile field: the feed's ranked page drawn as
                                      the squarified treemap, colored by the 24h
                                      change palette, pressed tiles routed through
                                      the window to the workspace symbol. -->
                                <charting:HeatmapWidget x:Name="HeatmapWidget"
                                                        Grid.Row="1"
                                                        Tiles="{Binding Tiles}" />
                            </Grid>
                        </TabItem>
                    </TabControl>

                    <!-- Chart workspace -->
                    <Border Grid.Column="0" DataContext="{Binding Chart}">
                        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                            <!-- Header: the symbol picker on the left (the star badge
                                 marks the favorites; both marks are managed in the
                                 settings window's pairs tab); the time frame picker
                                 rides the same load key, so a flip reloads the
                                 chart live; the overlay toggles (T-093) sit right
                                 next to it, the persisted choices mirroring their
                                 on/off state through the toggles' own class, and
                                 the candles export writes the loaded series to a
                                 user-chosen CSV file. -->
                            <Grid Grid.Row="0"
                                  ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                  Margin="0,0,0,8">
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding AvailableSymbols}"
                                          SelectedItem="{Binding SelectedSymbolRow}">
                                    <ComboBox.ItemTemplate>
                                        <!-- One row: the star badge on the favorites,
                                             the symbol name. The row record carries the
                                             mark (rebuilt on every change), so the
                                             template binds within its own data type. -->
                                        <DataTemplate x:DataType="vm:SymbolRow">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="★"
                                                           Foreground="{DynamicResource Highlight}"
                                                           FontSize="14"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding IsFavorite}" />
                                                <TextBlock Text="{Binding Symbol.Normalized}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Grid.Column="1"
                                           Text="{loc:Localized Chart.TimeFrame}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,6,0" />
                                <ComboBox Grid.Column="2"
                                          MinWidth="72"
                                          ItemsSource="{Binding TimeFrames}"
                                          SelectedItem="{Binding SelectedTimeFrame}" />
                                <!-- Chart type selector (T-089): five static localized
                                     items bound by index (the SelectedThemeIndex shim
                                     precedent) — the localized strings never touch the
                                     ViewModel, and the language switch re-inks them live. -->
                                <TextBlock Grid.Column="3"
                                           Text="{loc:Localized Chart.Type}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,6,0" />
                                <ComboBox Grid.Column="4"
                                          MinWidth="92"
                                          SelectedIndex="{Binding SelectedChartTypeIndex}"
                                          ToolTip.Tip="{loc:Localized Chart.Type.Tip}">
                                    <TextBlock Text="{loc:Localized Chart.Type.Candles}" />
                                    <TextBlock Text="{loc:Localized Chart.Type.Line}" />
                                    <TextBlock Text="{loc:Localized Chart.Type.Area}" />
                                    <TextBlock Text="{loc:Localized Chart.Type.Bars}" />
                                    <TextBlock Text="{loc:Localized Chart.Type.HeikinAshi}" />
                                </ComboBox>
                                <!-- Y-axis scale mode selector (T-090): three static
                                     localized items bound by index (the chart-type
                                     shim precedent) — the localized strings never
                                     touch the ViewModel, and the language switch
                                     re-inks them live. -->
                                <TextBlock Grid.Column="5"
                                           Text="{loc:Localized Chart.ScaleMode}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,6,0" />
                                <ComboBox Grid.Column="6"
                                          MinWidth="92"
                                          SelectedIndex="{Binding SelectedScaleModeIndex}"
                                          ToolTip.Tip="{loc:Localized Chart.ScaleMode.Tip}">
                                    <TextBlock Text="{loc:Localized Chart.ScaleMode.Linear}" />
                                    <TextBlock Text="{loc:Localized Chart.ScaleMode.Log}" />
                                    <TextBlock Text="{loc:Localized Chart.ScaleMode.Percent}" />
                                </ComboBox>
                                <Button Grid.Column="7"
                                        Content="{loc:Localized Chart.Vwap}"
                                        Command="{Binding ToggleVwapCommand}"
                                        ToolTip.Tip="{loc:Localized Chart.Vwap.Tip}"
                                        Classes.on="{Binding ShowVwap}"
                                        MinWidth="72"
                                        Margin="8,0,0,0"
                                        Opacity="0.65">
                                    <Button.Styles>
                                        <Style Selector="Button.on">
                                            <Setter Property="Opacity" Value="1" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Highlight}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Highlight}" />
                                        </Style>
                                    </Button.Styles>
                                </Button>
                                <Button Grid.Column="8"
                                        Content="{loc:Localized Chart.VolumeProfile}"
                                        Command="{Binding ToggleVolumeProfileCommand}"
                                        ToolTip.Tip="{loc:Localized Chart.VolumeProfile.Tip}"
                                        Classes.on="{Binding ShowVolumeProfile}"
                                        MinWidth="92"
                                        Margin="8,0,0,0"
                                        Opacity="0.65">
                                    <Button.Styles>
                                        <Style Selector="Button.on">
                                            <Setter Property="Opacity" Value="1" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Highlight}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Highlight}" />
                                        </Style>
                                    </Button.Styles>
                                </Button>
                                <Button Grid.Column="9"
                                        Content="{loc:Localized Chart.ExportCandlesCsv}"
                                        Command="{Binding ExportCandlesCommand}"
                                        MinWidth="110"
                                        Margin="8,0,0,0" />
                                <!-- The export pair (T-094): the PNG snapshot
                                     renders the current frame (same lens, same
                                     annotations) at a fixed scale with the
                                     symbol/timeframe watermark; the second CSV
                                     button exports exactly the visible range. -->
                                <Button Grid.Column="10"
                                        Content="{loc:Localized Chart.ExportPng}"
                                        Command="{Binding ExportPngCommand}"
                                        ToolTip.Tip="{loc:Localized Chart.ExportPng.Tip}"
                                        MinWidth="72"
                                        Margin="8,0,0,0" />
                                <Button Grid.Column="11"
                                        Content="{loc:Localized Chart.ExportVisibleCsv}"
                                        Command="{Binding ExportVisibleCandlesCommand}"
                                        ToolTip.Tip="{loc:Localized Chart.ExportVisibleCsv.Tip}"
                                        MinWidth="110"
                                        Margin="8,0,0,0" />
                                <!-- The compare action (T-124): a second series of
                                     the standing interval alongside the workspace
                                     one, each percent-rebased to its own zero. The
                                     pick rides the global palette's compare mode;
                                     the chart's legend chips carry their own detach
                                     press zones. -->
                                <Button Grid.Column="12"
                                        Content="{loc:Localized Chart.Compare}"
                                        Command="{Binding CompareCommand}"
                                        ToolTip.Tip="{loc:Localized Chart.Compare.Tip}"
                                        MinWidth="92"
                                        Margin="8,0,0,0" />
                                <!-- The drawing tools palette (T-091): each toggle
                                     arms its tool on the chart control (a same-tool
                                     press stands it down); the control's on-state
                                     rides the active class, and a placed drawing
                                     persists through the chart ViewModel. -->
                                <Button Grid.Column="13"
                                        Content="{loc:Localized Chart.Tool.TrendLine}"
                                        Command="{Binding ToolCommand}"
                                        CommandParameter="{x:Static tools:ChartDrawingTool.TrendLine}"
                                        ToolTip.Tip="{loc:Localized Chart.Tool.TrendLine.Tip}"
                                        Classes.on="{Binding IsTrendLineToolActive}"
                                        MinWidth="72"
                                        Margin="8,0,0,0"
                                        Opacity="0.65">
                                    <Button.Styles>
                                        <Style Selector="Button.on">
                                            <Setter Property="Opacity" Value="1" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Highlight}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Highlight}" />
                                        </Style>
                                    </Button.Styles>
                                </Button>
                                <Button Grid.Column="14"
                                        Content="{loc:Localized Chart.Tool.Level}"
                                        Command="{Binding ToolCommand}"
                                        CommandParameter="{x:Static tools:ChartDrawingTool.HorizontalLevel}"
                                        ToolTip.Tip="{loc:Localized Chart.Tool.Level.Tip}"
                                        Classes.on="{Binding IsLevelToolActive}"
                                        MinWidth="72"
                                        Margin="8,0,0,0"
                                        Opacity="0.65">
                                    <Button.Styles>
                                        <Style Selector="Button.on">
                                            <Setter Property="Opacity" Value="1" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Highlight}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Highlight}" />
                                        </Style>
                                    </Button.Styles>
                                </Button>
                                <Button Grid.Column="15"
                                        Content="{loc:Localized Chart.Tool.Fib}"
                                        Command="{Binding ToolCommand}"
                                        CommandParameter="{x:Static tools:ChartDrawingTool.FibRetracement}"
                                        ToolTip.Tip="{loc:Localized Chart.Tool.Fib.Tip}"
                                        Classes.on="{Binding IsFibToolActive}"
                                        MinWidth="72"
                                        Margin="8,0,0,0"
                                        Opacity="0.65">
                                    <Button.Styles>
                                        <Style Selector="Button.on">
                                            <Setter Property="Opacity" Value="1" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Highlight}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Highlight}" />
                                        </Style>
                                    </Button.Styles>
                                </Button>
                            </Grid>

                            <!-- Export failure -->
                            <TextBlock Grid.Row="1"
                                       Text="{Binding ErrorMessage}"
                                       Foreground="{DynamicResource Error}"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding HasErrorMessage}"
                                       Margin="0,0,0,8" />

                            <!-- Deep-history end note (T-086): where the feed's
                                 candle series ends — shown while the loaded
                                 history proved a limit. -->
                            <TextBlock Grid.Row="2"
                                       Text="{Binding HistoryLimitNote}"
                                       Foreground="{DynamicResource TextPrimary}"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding HasHistoryLimitNote}"
                                       Margin="0,0,0,8" />

                            <!-- Chart: the T-093 overlays ride the same
                                 publish path the indicator lines do (the
                                 VWAP computed against the loaded series;
                                 the toggled profile recomputes with the
                                 visible window on every pass). The T-089
                                 selector switches the renderer variant;
                                 the Heikin-Ashi series publishes smoothed
                                 HA bars aligned with the loaded series. -->
                            <charting:CandlestickChart x:Name="CandlesChart" Grid.Row="3"
                                                       Bars="{Binding Bars}"
                                                       Use12HourClock="{Binding Use12HourClock}"
                                                       VwapOverlay="{Binding VwapOverlay}"
                                                       VolumeProfileVisible="{Binding ShowVolumeProfile}"
                                                       IndicatorLines="{Binding IndicatorLines}"
                                                       SeriesType="{Binding ChartType}"
                                                       ScaleMode="{Binding ScaleMode}"
                                                       HeikinAshiBars="{Binding HeikinAshiBars}"
                                                       SignalMarkers="{Binding SignalMarkers}"
                                                       TradingPosition="{Binding TradingPosition}"
                                                       TradingOrders="{Binding TradingOrders}"
                                                       TradingFills="{Binding TradingFills}"
                                                       MainSeriesLabel="{Binding MainSeriesLabel}"
                                                       CompareLayers="{Binding CompareLayers}"
                                                       Drawings="{Binding Drawings}"
                                                       ActiveTool="{Binding ActiveDrawingTool}"
                                                       SelectedDrawingId="{Binding SelectedDrawingId}"
                                                       FrameTapEnabled="{Binding $parent[Window].((vm:MainViewModel)DataContext).Hud.IsVisible}" />
                                                        <!-- T-122: the trading footprint — my own position entry, working orders and fills, overlay-only (nothing routes back toward an order). -->
                                                        <!-- T-124: the compare overlays — the chip strip's main label follows the workspace symbol; the layers are transient chart-level state. -->
                                                        <!-- T-091: the drawings layer — the persisted annotation list, the palette's armed tool and the selection ride one-way in; the control's interaction events mirror out through the window's subscriptions below. -->

                            <!-- Signal rail (T-112): the latest strategy readings
                                 streaming under the chart — one coalesced rows
                                 replacement per window, a bounded newest-first
                                 ring (the coalescing lives in the rail's own
                                 VM). A row press rides this window's PREFILL
                                 route (the same transient dialog path the
                                 order book's level presses share); a signal
                                 never sends an order itself — the human
                                 decides on the ticket. -->
                            <Border Grid.Row="4"
                                    Margin="0,8,0,0"
                                    Padding="4,4,4,0"
                                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                    BorderThickness="0,1,0,0"
                                    DataContext="{Binding SignalRail}">
                                <Grid RowDefinitions="Auto,*" MaxHeight="172">
                                    <TextBlock Grid.Row="0"
                                               Text="{loc:Localized Signal.Rail.Title}"
                                               FontWeight="Bold"
                                               FontSize="14"
                                               Margin="4,2,0,6" />
                                    <Grid Grid.Row="1">
                                        <TextBlock Text="{loc:Localized Signal.Rail.Empty}"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0"
                                                   IsVisible="{Binding IsEmpty}" />
                                        <ItemsControl ItemsSource="{Binding Rows, Mode=OneWay}"
                                                      IsVisible="{Binding HasRows}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Vertical" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SignalRailRow">
                                                    <!-- One reading: the side accent dot
                                                         (the stance's direction read), the
                                                         composed facts, the time. The row is
                                                         a Button: the whole line is the
                                                         prefill affordance; the tooltip names
                                                         what a click does and does not do. -->
                                                    <Button Command="{Binding PrefillCommand}"
                                                            ToolTip.Tip="{Binding Tooltip}"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            Padding="8,1"
                                                            Background="Transparent"
                                                            BorderThickness="0">
                                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                                            <Ellipse Width="8"
                                                                     Height="8"
                                                                     VerticalAlignment="Center"
                                                                     Classes.long="{Binding IsEntryLong}"
                                                                     Classes.flat="{Binding IsEntryFlat}">
                                                                <Ellipse.Styles>
                                                                    <Style Selector="Ellipse.long">
                                                                        <Setter Property="Fill" Value="{DynamicResource CandleUp}" />
                                                                    </Style>
                                                                    <Style Selector="Ellipse.flat">
                                                                        <Setter Property="Fill" Value="{DynamicResource TextSecondary}" />
                                                                    </Style>
                                                                </Ellipse.Styles>
                                                            </Ellipse>
                                                            <TextBlock Text="{Binding CandleTime}"
                                                                       Foreground="{DynamicResource TextSecondary}"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding StrategyId}"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding StanceLabel}"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding SymbolText}"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding PriceText}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Right: AI Chat panel (the assistant column carries the
                 persisted width; one way visibility binding) -->
            <Border Grid.Column="2"
                    IsVisible="{Binding IsAiChatVisible}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    BorderThickness="1,0,0,0"
                    DataContext="{Binding Chat}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{loc:Localized AI.Assistant}"
                               FontWeight="Bold"
                               FontSize="14"
                               Margin="8" />

                    <!-- T-114: the market-context consent chip — the one
                         explicit toggle behind which every send carries the
                         token-bounded market snapshot (compacted fresh from
                         the workspace moment). Off until stored, so the
                         silent crowd keeps the exact pre-consent wording. -->
                    <ToggleButton DockPanel.Dock="Top"
                                  Margin="8,0,8,0"
                                  HorizontalContentAlignment="Left"
                                  Content="{loc:Localized AI.Chat.ContextToggle}"
                                  ToolTip.Tip="{loc:Localized AI.Chat.ContextToggle.Hint}"
                                  Command="{Binding ToggleContextCommand}"
                                  IsChecked="{Binding IsMarketContextEnabled, Mode=OneWay}" />

                    <!-- Chat input + send (named input: the menu/hotkey focus
                         request lands on it, so the assistant is one
                         keystroke away); the send button carries the
                         command, disabled while the input is empty or a
                         request is in flight -->
                    <Grid DockPanel.Dock="Bottom" Margin="8" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox x:Name="ChatInput"
                                 Grid.Column="0"
                                 AutomationProperties.Name="{loc:Localized AI.Chat.InputName}"
                                 Text="{Binding AiChatInput}"
                                 PlaceholderText="{loc:Localized AI.Chat.Placeholder}"
                                 AcceptsReturn="False">
                            <TextBox.KeyBindings>
                                <!-- Enter sends (the box refuses newlines, so the
                                     gesture is free); the command's own guard
                                     (empty input, request in flight) still vetoes -->
                                <KeyBinding Gesture="Enter" Command="{Binding SendTextCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Button Grid.Column="1"
                                Content="{loc:Localized AI.Chat.Send}"
                                Command="{Binding SendTextCommand}" />
                    </Grid>

                    <!-- Chat messages -->
                    <ListBox ItemsSource="{Binding ChatMessages}" Margin="8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding Role}" FontWeight="Bold" FontSize="12" />
                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
        </DockPanel>

        <!-- T-097: the notification toast stack, a sibling above the
             workspace (below the palette overlay). The center's display lane
             feeds the host's rows: newest on top, at most five visible,
             every row leaves on its own after its lifetime or on a click —
             a routed click opens its panel (the host poses the route, this
             window's code-behind owns the plumbing). The card rides the
             chrome canon (Surface fill + Border stroke); the badge carries a
             digest's count; a no-route row's click only dismisses it. -->
        <ItemsControl HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Margin="0,44,10,0"
                      IsVisible="{Binding ToastHost.HasToasts}"
                      ItemsSource="{Binding ToastHost.Toasts}"
                      MaxHeight="400">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NotificationRow">
                    <Button Margin="0,0,0,6"
                            Command="{Binding OpenCommand}"
                            ToolTip.Tip="{loc:Localized Notif.ToastHint}"
                            HorizontalContentAlignment="Stretch">
                        <Border Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource Border}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,6">
                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Moment}"
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontSize="11"
                                           VerticalAlignment="Center" />
                                <Border Grid.Column="1"
                                        CornerRadius="6"
                                        Background="{DynamicResource Highlight}"
                                        Padding="5,1"
                                        IsVisible="{Binding HasCountBadge}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Count}"
                                               FontSize="11"
                                               Foreground="{DynamicResource Background}" />
                                </Border>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Summary}"
                                           TextWrapping="Wrap"
                                           MaxWidth="360"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- T-095: the global symbol palette overlay, a sibling above the
             workspace. Keyboard-first: Ctrl+K toggles (the window binding
             above), the query box takes the focus (the interaction the
             ViewModel raises), Up/Down/PageUp/PageDown move the keyboard
             selection, Enter applies the highlighted pair, Esc closes — the
             code-behind route carries exactly those keys. The panel rides the
             chrome canon (Surface border + Border stroke on the theme); the
             backdrop veils the workspace with the theme's own Background at
             reduced opacity and a press on it closes the palette too. The
             rows list is pointer-only by design: the items never take focus,
             so a click keeps the query holding the keyboard and the route
             never races the list's own selection machinery. -->
        <Grid x:Name="PaletteOverlay"
              IsVisible="{Binding Palette.IsOpen}">
            <Border x:Name="PaletteScrim"
                    Background="{DynamicResource Background}"
                    Opacity="0.75"
                    PointerPressed="OnPaletteScrimPressed" />
            <Panel HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,72,0,0">
                <Border Width="640"
                        Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="1"
                        CornerRadius="10"
                        ClipToBounds="True">
                    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto"
                          RowSpacing="10"
                          Margin="14,12,14,10">
                        <TextBlock Grid.Row="0"
                                   Text="{loc:Localized Palette.Title}"
                                   FontWeight="Bold"
                                   FontSize="14" />
                        <TextBox x:Name="PaletteQuery"
                                 Grid.Row="1"
                                 AutomationProperties.Name="{loc:Localized Chart.A11ySymbolPicker}"
                                 Text="{Binding Palette.Query}"
                                 PlaceholderText="{loc:Localized Palette.Placeholder}" />
                        <!-- The compare-pick hint (T-124): while the palette
                             rides the chart's compare action, the rows rank
                             the current exchange only and Enter picks a
                             series instead of switching the workspace. -->
                        <TextBlock Grid.Row="2"
                                   Text="{loc:Localized Palette.CompareHint}"
                                   Foreground="{DynamicResource Highlight}"
                                   FontSize="11"
                                   IsVisible="{Binding Palette.IsPickingCompare}" />
                        <Grid Grid.Row="3">
                            <ListBox x:Name="PaletteRows"
                                     IsVisible="{Binding Palette.HasRows}"
                                     ItemsSource="{Binding Palette.Rows}"
                                     SelectedIndex="{Binding Palette.SelectedIndex, Mode=TwoWay}"
                                     Focusable="False"
                                     MaxHeight="420">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Focusable" Value="False" />
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SymbolPaletteRow">
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                                              ColumnSpacing="8"
                                              Margin="2">
                                            <!-- The star: the favorites read-only mirror
                                                 (the marks are made in the settings window's
                                                 pairs tab, the same source the chart picker
                                                 binds); the recent marker: the palette's own
                                                 in-memory session list. -->
                                            <TextBlock Grid.Column="0"
                                                       Text="★"
                                                       Foreground="{DynamicResource Highlight}"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding IsFavorite}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="↺"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding IsRecent}" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Symbol.Normalized}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding ExchangeName}"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <!-- The three honest states of a rowless page:
                                 loading (the first fetch never finished),
                                 empty (every adapter settled on nothing),
                                 no matches (the query found none). At most
                                 one is visible; the ListBox shows otherwise. -->
                            <TextBlock IsVisible="{Binding Palette.IsSourceWaiting}"
                                       Text="{loc:Localized Palette.Loading}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Margin="4,8" />
                            <TextBlock IsVisible="{Binding Palette.HasNoInstruments}"
                                       Text="{loc:Localized Palette.Empty}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Margin="4,8" />
                            <TextBlock IsVisible="{Binding Palette.HasNoMatches}"
                                       Text="{loc:Localized Palette.NoMatches}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Margin="4,8" />
                        </Grid>
                        <TextBlock Grid.Row="4"
                                   Text="{loc:Localized Palette.Hint}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="11" />
                    </Grid>
                </Border>
            </Panel>
        </Grid>

        <!-- The performance HUD (T-108): a dev-mode readout floating over
             the workspace's top-right corner, a sibling of the palette
             overlay so it rides on top of every panel too. Off by default
             (Diagnostics.HudEnabled); the Help menu's checkbox owns the
             flip, the sampler runs only while the overlay shows, and the
             off state leaves the frame pass its one property read — no
             subscriptions, no timers, nothing to see. The lines re-format
             at the sampler's own 1 Hz cadence; the readout digits ride a
             monospaced stack so the numbers hold their columns. -->
        <Panel x:Name="HudOverlay"
               IsVisible="{Binding Hud.IsVisible}"
               HorizontalAlignment="Right"
               VerticalAlignment="Top"
               Margin="0,52,12,0">
            <Border Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,9"
                    ClipToBounds="True"
                    BoxShadow="0 4 16 0 #40000000">
                <ItemsControl ItemsSource="{Binding Hud.Lines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       FontFamily="Consolas,Menlo,DejaVu Sans Mono,monospace"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextPrimary}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Panel>

        <!-- The hotkey cheat sheet (T-102): the live gesture map's "?"
             overlay, a palette sibling so it rides on top of every panel
             too. Opened from the Help menu's checkbox (or Esc'd shut), it
             is strictly read-only: the rows are the sheet VM's localized
             mirrors of the SAME map the window's key route matches, so
             the listed gestures and the routing truth can never drift.
             The backdrop veils the workspace like the palette's scrim
             and a press on it closes the sheet too. -->
        <Grid x:Name="HotkeysSheetOverlay"
              IsVisible="{Binding Hotkeys.IsSheetVisible}">
            <Border Background="{DynamicResource Background}"
                    Opacity="0.75"
                    PointerPressed="OnHotkeysSheetScrimPressed" />
            <Panel HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,72,0,0">
                <Border Width="520"
                        Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="1"
                        CornerRadius="10"
                        ClipToBounds="True"
                        Padding="16,12">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{loc:Localized Hotkeys.Sheet.Title}"
                                   FontWeight="Bold"
                                   FontSize="14" />
                        <ItemsControl ItemsSource="{Binding Hotkeys.Sheet}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HotkeySheetRow">
                                    <Grid ColumnDefinitions="*,Auto"
                                          Margin="0,2">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Gesture}"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   HorizontalAlignment="Right"
                                                   FontSize="12" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Panel>
        </Grid>
    </Grid>
</Window>
