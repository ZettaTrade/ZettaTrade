<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ZettaTrade.App.ViewModels"
        xmlns:loc="using:ZettaTrade.UI.Localization"
        xmlns:charting="using:ZettaTrade.UI.Charting"
        x:Class="ZettaTrade.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="ZettaTrade"
        Width="1400" Height="900"
        MinWidth="1024" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SystemControlPageBackgroundAltHighBrush}">

    <Window.KeyBindings>
        <!-- Gesture audit of the menu labels: all InputGesture strings here are
             backed or explained below.
             - Ctrl+OemComma -> OpenSettingsCommand: bound, real behavior.
             - Ctrl+N        -> NewOrderCommand: bound, real behavior (the T-008
                                order dialog replaced the placeholder).
             - Alt+F4        -> OS window-close gesture: works without a binding;
                                adding one would double-handle the close.
             - Ctrl+Shift+A (AI chat): gesture removed because the command is
               still a placeholder; the label returns with the feature. -->
        <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding Menu.OpenSettingsCommand}" />
        <KeyBinding Gesture="Ctrl+N" Command="{Binding Menu.NewOrderCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+A" Command="{Binding Menu.OpenAiChatCommand}" />
    </Window.KeyBindings>

    <DockPanel>
        <!-- Top menu bar -->
        <Menu DockPanel.Dock="Top" DataContext="{Binding Menu}">
            <MenuItem Header="{loc:Localized Menu.File}">
                <MenuItem Header="{loc:Localized Menu.File.Settings}" Command="{Binding OpenSettingsCommand}" InputGesture="Ctrl+," />
                <Separator />
                <MenuItem Header="{loc:Localized Menu.File.Exit}" Command="{Binding ExitCommand}" InputGesture="Alt+F4" />
            </MenuItem>
            <MenuItem Header="{loc:Localized Menu.Trading}">
                <MenuItem Header="{loc:Localized Menu.Trading.NewOrder}" Command="{Binding NewOrderCommand}" InputGesture="Ctrl+N" />
                <MenuItem Header="{loc:Localized Menu.Trading.Positions}" Command="{Binding ShowPositionsCommand}" />
                <MenuItem Header="{loc:Localized Menu.Trading.OrderHistory}" Command="{Binding ShowOrderHistoryCommand}" />
            </MenuItem>
            <MenuItem Header="{loc:Localized Menu.AI}">
                <MenuItem Header="{loc:Localized Menu.AI.Chat}" Command="{Binding OpenAiChatCommand}" InputGesture="Ctrl+Shift+A" />
                <MenuItem Header="{loc:Localized Menu.AI.Servers}" Command="{Binding ManageMcpServersCommand}" />
            </MenuItem>
        </Menu>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SystemAccentColorLight2}"
                Padding="8,4"
                DataContext="{Binding StatusBar}">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{loc:Localized Status.Ready}" VerticalAlignment="Center" />
                <!-- One concept, one control (T-016 anti-confusion rules): the
                     exchange picker renders only when two or more adapters are
                     registered; the trading mode never folds into the picker —
                     exchange and mode are two different decisions. -->
                <ComboBox Grid.Column="1"
                          IsVisible="{Binding HasExchangeChoice}"
                          ItemsSource="{Binding ExchangeNames}"
                          SelectedItem="{Binding SelectedExchangeName, Mode=TwoWay}"
                          MinWidth="96"
                          Margin="16,0"
                          VerticalAlignment="Center"
                          ToolTip.Tip="{loc:Localized Status.ExchangePicker}" />
                <TextBlock Grid.Column="2" Margin="16,0" VerticalAlignment="Center">
                    <Run Text="{Binding ActiveExchangeName}" />
                    <Run Text=" · " />
                    <Run Text="{loc:Localized Status.PaperMode}" />
                </TextBlock>
                <TextBlock Grid.Column="3" Text="{Binding ConnectionStatus}" Margin="16,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="{Binding CurrentThemeName}" Margin="16,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="{Binding CurrentLanguage}" Margin="16,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="6" Text="{Binding AppVersion}" Margin="16,0" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Main content area -->
        <Grid ColumnDefinitions="*,300">
            <!-- Left: Trading workspace (charts, order book, etc.) -->
            <Border Grid.Column="0" Padding="8">
                <Grid ColumnDefinitions="*,300">
                    <!-- Depth panel: a free-typed symbol (works offline like the
                         dialog), switched live streams of the parsed symbol. -->
                    <Border Grid.Column="1"
                            Margin="8,0,0,0"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                            BorderThickness="1,0,0,0"
                            DataContext="{Binding OrderBook}">
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock Grid.Row="0"
                                       Text="{loc:Localized OrderBook.Title}"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Margin="0,0,0,4" />
                            <charting:OrderBookWidget x:Name="BookWidget" Grid.Row="1" Book="{Binding Book}" />
                        </Grid>
                    </Border>

                    <!-- Chart workspace -->
                    <Border Grid.Column="0" DataContext="{Binding Chart}">
                        <Grid RowDefinitions="Auto,*">
                            <!-- Symbol selector -->
                            <ComboBox Grid.Row="0"
                                      ItemsSource="{Binding AvailableSymbols}"
                                      SelectedItem="{Binding SelectedSymbol}"
                                      Margin="0,0,0,8">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Normalized}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            
                            <!-- Chart -->
                            <charting:CandlestickChart Grid.Row="1"
                                                       Bars="{Binding Bars}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Right: AI Chat panel -->
            <Border Grid.Column="1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    BorderThickness="1,0,0,0"
                    DataContext="{Binding Chat}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{loc:Localized AI.Assistant}"
                               FontWeight="Bold"
                               FontSize="14"
                               Margin="8" />

                    <!-- Chat input (named: the menu/hotkey focus request
                         lands on it, so the assistant is one keystroke away) -->
                    <TextBox x:Name="ChatInput"
                             DockPanel.Dock="Bottom"
                             Text="{Binding AiChatInput}"
                             Margin="8"
                             AcceptsReturn="False" />

                    <!-- Chat messages -->
                    <ListBox ItemsSource="{Binding ChatMessages}" Margin="8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding Role}" FontWeight="Bold" FontSize="12" />
                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" FontSize="10" Foreground="Gray" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
