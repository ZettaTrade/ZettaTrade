<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="using:Livery.Themes"
        xmlns:media="using:Avalonia.Media"
        xmlns:interfaces="using:ZettaTrade.Core.Interfaces"
        xmlns:vm="using:ZettaTrade.App.ViewModels"
        xmlns:loc="using:Livery.Localization"
        x:Class="ZettaTrade.App.Views.FirstRunWizardWindow"
        Classes="chrome-compact"
        Icon="/Assets/ZettaTrade.ico"
        x:DataType="vm:FirstRunWizardViewModel"
        Title="{loc:Localized Wizard.Title}"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource Background}">

    <!-- The three steps share one body area; the visible step swaps and the
         nav row always stays in place (the wizard never moves its controls —
         a step is a panel flip, not a window shuffle). Every step's pick is
         a draft: nothing applies before the finish button's task lands. -->
    <StackPanel Margin="{StaticResource InsetL}" Spacing="{StaticResource SpaceM}">

        <!-- The step counter (T-161): the walk's position reads without the
             captions — "Step 2 of 3" above every step body, the drafts and
             the nav row untouched. -->
        <TextBlock Text="{Binding StepCounter}"
                   HorizontalAlignment="Right"
                   Foreground="{DynamicResource TextSecondary}"
                   FontSize="{StaticResource CaptionFontSize}" />

        <!-- Step one: the theme pick. -->
        <StackPanel IsVisible="{Binding IsThemeStepVisible}" Spacing="{StaticResource SpaceM}">
            <TextBlock Text="{loc:Localized Wizard.Theme.Header}"
                       FontWeight="Bold"
                       FontSize="{StaticResource TitleFontSize}" />
            <TextBlock Text="{loc:Localized Wizard.Theme.Caption}"
                       TextWrapping="Wrap" />
            <ComboBox ItemsSource="{Binding ThemeOptions}"
                      SelectedItem="{Binding SelectedTheme}"
                      MinWidth="240"
                      HorizontalAlignment="Left">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="themes:ThemeInfo">
                        <!-- The settings picker's own swatch shape (T-161):
                             the name and the theme file's preview strip,
                             honestly the same pick the settings window
                             offers — the two pickers cannot disagree. The
                             converter drops unparseable entries (the
                             settings picker's own test lane). -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding DisplayName}"
                                       VerticalAlignment="Center" />
                            <ItemsControl Grid.Column="1"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding PreviewColors, Converter={x:Static themes:PreviewColorsToBrushesConverter.Instance}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="media:ISolidColorBrush">
                                        <Border Width="10"
                                                Height="10"
                                                CornerRadius="2"
                                                Background="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <!-- Step two: the adapter pick. Demo stays the default lane; the
             keys note is text only — the wizard never collects secrets. -->
        <StackPanel IsVisible="{Binding IsAdapterStepVisible}" Spacing="{StaticResource SpaceM}">
            <TextBlock Text="{loc:Localized Wizard.Adapter.Header}"
                       FontWeight="Bold"
                       FontSize="{StaticResource TitleFontSize}" />
            <TextBlock Text="{loc:Localized Wizard.Adapter.Caption}"
                       TextWrapping="Wrap" />
            <ComboBox ItemsSource="{Binding AdapterOptions}"
                      SelectedItem="{Binding SelectedAdapter}"
                      MinWidth="240"
                      HorizontalAlignment="Left">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="interfaces:IMarketDataAdapter">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Id}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{loc:Localized Wizard.Adapter.Secrets}"
                       TextWrapping="Wrap"
                       />
        </StackPanel>

        <!-- Step three: the first symbol pick, refilled on every draft-adapter
             selection; the list scrolls inside its own viewport. -->
        <StackPanel IsVisible="{Binding IsSymbolStepVisible}" Spacing="{StaticResource SpaceM}">
            <TextBlock Text="{loc:Localized Wizard.Symbol.Header}"
                       FontWeight="Bold"
                       FontSize="{StaticResource TitleFontSize}" />
            <TextBlock Text="{loc:Localized Wizard.Symbol.Caption}"
                       TextWrapping="Wrap" />
            <!-- The symbol rows clear the list's own overlay bar (T-170):
                 the padding is the list's internal gutter. -->
            <ListBox ItemsSource="{Binding SymbolNames}"
                     SelectedItem="{Binding SelectedSymbolName}"
                     Height="180"
                     Padding="0,0,16,0" />
        </StackPanel>

        <!-- The nav row: back walks the drafts, next advances, finish is the
             last step's confirm, skip leaves without applying anything (a
             plain close — the same path the system close takes). -->
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{StaticResource SpaceS}">
            <Button Grid.Column="0"
                    IsVisible="{Binding IsBackVisible}"
                    Content="{loc:Localized Wizard.Back}"
                    Command="{Binding BackCommand}"
                    MinWidth="90" />
            <Button Grid.Column="2"
                    IsVisible="{Binding IsNextVisible}"
                    Content="{loc:Localized Wizard.Next}"
                    Command="{Binding NextCommand}"
                    MinWidth="90" />
            <Button Grid.Column="3"
                    IsVisible="{Binding IsFinishVisible}"
                    Content="{loc:Localized Wizard.Finish}"
                    Command="{Binding FinishCommand}"
                    MinWidth="90" />
        </Grid>
        <Button Click="OnSkipClick"
               Content="{loc:Localized Wizard.Skip}"
               HorizontalAlignment="Right"
               MinWidth="90" />
    </StackPanel>
</Window>
