<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ZettaTrade.App.ViewModels"
        xmlns:loc="using:Livery.Localization"
        x:Class="ZettaTrade.App.Views.NewOrderDialogWindow"
        Classes="chrome-compact"
        AutomationProperties.AutomationId="NewOrderDialogWindow"
        Icon="/Assets/ZettaTrade.ico"
        x:DataType="vm:NewOrderDialogViewModel"
        Title="{loc:Localized NewOrder.Title}"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource Background}">

    <Window.Styles>
        <!-- T-156: the ticket's own vocabulary — the segmented side pair,
             the primary CTA, the chip-shaped sizer presets and the inline
             field error. The state fills ride the palette keys the T-152
             contrast publisher scores (CandleUp, Error), the captions read
             through the derived readable foreground; the un-picked side
             stays quiet chrome. -->
        <Style Selector="Button.side">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="FontSize" Value="{StaticResource SubtitleStrongFontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.side.buy.selected">
            <Setter Property="Background" Value="{DynamicResource CandleUp}" />
            <Setter Property="Foreground" Value="{DynamicResource ChipForeground}" />
        </Style>
        <Style Selector="Button.side.sell.selected">
            <Setter Property="Background" Value="{DynamicResource Error}" />
            <Setter Property="Foreground" Value="{DynamicResource ChipForeground}" />
        </Style>
        <!-- T-181: the interaction variants ship explicitly (the kit's
             strip-icon discipline) — the window-scoped class styles apply
             after the app styles, so Livery's generic hover/pressed fills
             never reach a classed button. The state fills never leave (a
             trading segment keeps its side under the pointer): the hover
             rides the kit's emphasis ring (the row grammar's own hover
             border), the press the strip's dim step. -->
        <Style Selector="Button.side:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource Highlight}" />
        </Style>
        <Style Selector="Button.side:pressed">
            <Setter Property="Opacity" Value="0.8" />
        </Style>

        <!-- The primary CTA: the visually dominant action, filled with the
             picked side's state color (the caption tint follows it). -->
        <Style Selector="Button.cta">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.cta.buy">
            <Setter Property="Background" Value="{DynamicResource CandleUp}" />
            <Setter Property="Foreground" Value="{DynamicResource ChipForeground}" />
        </Style>
        <Style Selector="Button.cta.sell">
            <Setter Property="Background" Value="{DynamicResource Error}" />
            <Setter Property="Foreground" Value="{DynamicResource ChipForeground}" />
        </Style>
        <!-- T-181: the CTA's own variants — the same explicit-sibling
             discipline: the state fill holds under the pointer, the
             emphasis ring answers the hover, the press dims (never
             recolors — the side must stay readable through the click). -->
        <Style Selector="Button.cta:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource Highlight}" />
        </Style>
        <Style Selector="Button.cta:pressed">
            <Setter Property="Opacity" Value="0.8" />
        </Style>

        <!-- The sizer presets as chips: the pill shape, the compact
             padding; a proposal stays quiet chrome, never a state color. -->
        <Style Selector="Button.chip-action">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="{StaticResource InsetS}" />
            <Setter Property="MinHeight" Value="28" />
        </Style>

        <!-- The inline field error (T-156): the parse refusal next to its
             field, the caption size, the error tint. -->
        <Style Selector="TextBlock.field-error">
            <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource Error}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Styles>

    <StackPanel Margin="{StaticResource InsetL}" Spacing="{StaticResource SpaceM}">
        <!-- Header: the localized title plus the live active-exchange name —
             the dialog's price/context source; mirrors the status-bar chip
             and follows toolbar switches while the dialog is open. The
             TESTNET badge (T-127) appears beside it only while the traded
             surface rides the testnet lane (the same lane stream the
             status-bar chip resolves). -->
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
            <TextBlock VerticalAlignment="Center">
                <Run Text="{loc:Localized NewOrder.Title}" />
                <Run Text=" — " />
                <Run Text="{Binding ActiveExchangeName}" />
            </TextBlock>
            <Border Classes="chip"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsTestnetLane}"
                    ToolTip.Tip="{loc:Localized Exchange.TestnetBadge.Tooltip}"
                    Classes.testnet="{Binding IsTestnetLane}">
                <TextBlock Text="{loc:Localized Exchange.TestnetBadge}" />
            </Border>
        </StackPanel>

        <!-- Symbol: free-form normalized BASE/QUOTE text with adapter-driven
             suggestions; symbol-list failure simply leaves the field without
             completions (the designed empty state). Its parse refusal
             renders inline (T-156). -->
        <TextBlock Text="{loc:Localized NewOrder.Symbol}" />
        <AutoCompleteBox Text="{Binding SymbolInput, Mode=TwoWay}"
                         ItemsSource="{Binding SymbolSuggestions}"
                         FilterMode="None"
                         IsDropDownOpen="{Binding IsSymbolSuggestionsOpen, Mode=TwoWay}"
                         PlaceholderText="BTC/USDT" />
        <TextBlock Classes="field-error"
                   Text="{Binding SymbolError}"
                   IsVisible="{Binding HasSymbolError}" />

        <!-- The side (T-156): two large segmented buttons in the state
             colors — the picked side reads at a glance (fill + the derived
             readable caption). The VM's SelectedSideIndex stays the single
             source of the picked side: the prefill and the pipeline keep
             writing the index, the segments follow it. -->
        <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpaceS}">
            <Button Grid.Column="0"
                    Classes="side buy"
                    Classes.selected="{Binding IsBuySide}"
                    Content="{loc:Localized Order.Buy}"
                    Command="{Binding SelectBuySideCommand}" />
            <Button Grid.Column="1"
                    Classes="side sell"
                    Classes.selected="{Binding IsSellSide}"
                    Content="{loc:Localized Order.Sell}"
                    Command="{Binding SelectSellSideCommand}" />
        </Grid>

        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="{StaticResource SpaceM}" RowSpacing="{StaticResource SpaceXs}">
            <TextBlock Grid.Row="0" Grid.Column="0">
                <Run Text="{loc:Localized NewOrder.Quantity}" />
                <Run Text="{Binding QuantityUnitHint, Mode=OneWay}" />
            </TextBlock>
            <TextBox Grid.Row="1" Grid.Column="0"
                     AutomationProperties.AutomationId="QuantityInput"
                     FontFamily="{StaticResource NumericFont}"
                     Text="{Binding QuantityInput}"
                     PlaceholderText="0.01" />
            <TextBlock Grid.Row="2" Grid.Column="0"
                       Classes="field-error"
                       Text="{Binding QuantityError}"
                       IsVisible="{Binding HasQuantityError}" />

            <TextBlock Grid.Row="0" Grid.Column="1" Text="{loc:Localized NewOrder.OrderType}" />
            <ComboBox Grid.Row="1" Grid.Column="1"
                      AutomationProperties.AutomationId="OrderTypeComboBox"
                      SelectedIndex="{Binding SelectedTypeIndex}">
                <ComboBoxItem AutomationProperties.AutomationId="OrderTypeMarketItem">
                    <TextBlock Text="{loc:Localized Order.Market}" />
                </ComboBoxItem>
                <ComboBoxItem AutomationProperties.AutomationId="OrderTypeLimitItem">
                    <TextBlock Text="{loc:Localized Order.Limit}" />
                </ComboBoxItem>
                <ComboBoxItem AutomationProperties.AutomationId="OrderTypeStopLimitItem">
                    <TextBlock Text="{loc:Localized Order.StopLimit}" />
                </ComboBoxItem>
                <ComboBoxItem AutomationProperties.AutomationId="OrderTypeTrailingStopItem">
                    <TextBlock Text="{loc:Localized Order.TrailingStop}" />
                </ComboBoxItem>
                <ComboBoxItem AutomationProperties.AutomationId="OrderTypeOcoItem">
                    <TextBlock Text="{loc:Localized Order.Oco}" />
                </ComboBoxItem>
                <ComboBoxItem AutomationProperties.AutomationId="OrderTypeBracketItem">
                    <TextBlock Text="{loc:Localized Order.Bracket}" />
                </ComboBoxItem>
            </ComboBox>
        </Grid>

        <!-- Bracket entry kind (T-186): market places the entry at the
             market, limit prices it — the kind decides the entry price row
             below and the fee-estimate entry line. -->
        <TextBlock Text="{loc:Localized NewOrder.BracketEntryKind}"
                   IsVisible="{Binding IsBracketMode}" />
        <ComboBox AutomationProperties.AutomationId="BracketEntryKindComboBox"
                  SelectedIndex="{Binding BracketEntryKindIndex}"
                  IsVisible="{Binding IsBracketMode}">
            <ComboBoxItem AutomationProperties.AutomationId="BracketEntryMarketItem">
                <TextBlock Text="{loc:Localized Order.Market}" />
            </ComboBoxItem>
            <ComboBoxItem AutomationProperties.AutomationId="BracketEntryLimitItem">
                <TextBlock Text="{loc:Localized Order.Limit}" />
            </ComboBoxItem>
        </ComboBox>

        <!-- Limit price: limit and stop-limit orders; in the OCO mode the
             SAME field prices the take-profit leg, in the bracket mode the
             entry itself (a limit entry only), so its caption follows the
             mode. Both captions are static localized strings — the
             caption FOLLOWS via visibility, never a view model property;
             the unit hint (T-156) rides the parsed symbol's quote asset.
             The parse refusal renders inline (T-156) and hides with the
             row itself. -->
        <TextBlock IsVisible="{Binding IsPlainPriceCaption}">
            <Run Text="{loc:Localized NewOrder.Price}" />
            <Run Text="{Binding PriceUnitHint, Mode=OneWay}" />
        </TextBlock>
        <TextBlock IsVisible="{Binding IsOcoMode}">
            <Run Text="{loc:Localized NewOrder.OcoLimitPrice}" />
            <Run Text="{Binding PriceUnitHint, Mode=OneWay}" />
        </TextBlock>
        <TextBlock IsVisible="{Binding IsBracketMode}">
            <Run Text="{loc:Localized NewOrder.BracketEntryPrice}" />
            <Run Text="{Binding PriceUnitHint, Mode=OneWay}" />
        </TextBlock>
        <TextBox Text="{Binding PriceInput}"
                 AutomationProperties.AutomationId="PriceInput"
                 FontFamily="{StaticResource NumericFont}"
                 PlaceholderText="50000"
                 IsVisible="{Binding IsPriceRequired}" />
        <TextBlock Classes="field-error"
                   Text="{Binding PriceError}"
                   IsVisible="{Binding IsPriceErrorVisible}" />

        <!-- The bracket's take-profit leg (T-186): its own limit price —
             the OCO pair's take-profit caption names the same shape. -->
        <TextBlock Text="{loc:Localized NewOrder.OcoLimitPrice}"
                   IsVisible="{Binding IsBracketTakeProfitVisible}" />
        <TextBox Text="{Binding BracketTakeProfitInput}"
                 AutomationProperties.AutomationId="BracketTakeProfitInput"
                 FontFamily="{StaticResource NumericFont}"
                 PlaceholderText="52000"
                 IsVisible="{Binding IsBracketTakeProfitVisible}" />
        <TextBlock Classes="field-error"
                   Text="{Binding BracketTakeProfitError}"
                   IsVisible="{Binding IsBracketTakeProfitErrorVisible}" />

        <!-- Stop trigger: the stop-limit's own trigger, the OCO pair's
             stop-loss leg's trigger, or the bracket's stop-loss leg's
             trigger — the caption follows (the stop-loss label for the
             leg modes). -->
        <TextBlock Text="{loc:Localized NewOrder.TriggerPrice}"
                   IsVisible="{Binding !IsOcoStopTriggerCaption}" />
        <TextBlock Text="{loc:Localized NewOrder.OcoStopTrigger}"
                   IsVisible="{Binding IsOcoStopTriggerCaption}" />
        <TextBox Text="{Binding StopTriggerInput}"
                 FontFamily="{StaticResource NumericFont}"
                 PlaceholderText="49000"
                 IsVisible="{Binding IsTriggerVisible}" />
        <TextBlock Classes="field-error"
                   Text="{Binding TriggerError}"
                   IsVisible="{Binding IsTriggerErrorVisible}" />

        <!-- Trailing distance: the trailing-stop's drags-along distance only. -->
        <TextBlock Text="{loc:Localized NewOrder.TrailDistance}"
                   IsVisible="{Binding IsTrailVisible}" />
        <TextBox Text="{Binding TrailDistanceInput}"
                 FontFamily="{StaticResource NumericFont}"
                 PlaceholderText="500"
                 IsVisible="{Binding IsTrailVisible}" />
        <TextBlock Classes="field-error"
                   Text="{Binding TrailError}"
                   IsVisible="{Binding IsTrailErrorVisible}" />

        <!-- OCO stop-loss leg's own limit price (its protective cap at
             trigger time) — the OCO mode and the bracket mode (the same
             stop-limit shape). -->
        <TextBlock Text="{loc:Localized NewOrder.OcoStopLimitPrice}"
                   IsVisible="{Binding IsOcoStopLimitVisible}" />
        <TextBox Text="{Binding OcoStopLimitInput}"
                 FontFamily="{StaticResource NumericFont}"
                 PlaceholderText="48000"
                 IsVisible="{Binding IsOcoStopLimitVisible}" />
        <TextBlock Classes="field-error"
                   Text="{Binding OcoStopLimitError}"
                   IsVisible="{Binding IsOcoStopLimitErrorVisible}" />

        <!-- The bracket's arm-on-fill note (T-186): the exits are not
             working orders yet — they arm when the entry fills, so a
             resting entry keeps the pair parked until then. -->
        <TextBlock Text="{loc:Localized NewOrder.BracketArmsOnFill}"
                   IsVisible="{Binding IsBracketMode}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondary}" />

        <!-- Fee estimate (T-080): one line per leg the ticket would place,
             each naming the maker/taker role and the schedule-priced
             commission — a missing schedule or incomplete inputs render the
             localized dash, never a fabricated zero. -->
        <ItemsControl ItemsSource="{Binding FeeEstimates}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Quick-size row (T-079): balance-share presets and the
             risk-percent proposal. The row only PROPOSES — every proposal
             lands in the quantity field above and rides the ticket's own
             parse → risk → confirmation path at submit. Proposals ride
             captured snapshots and the ticket's own inputs: zero network
             calls at sizing time, and the plain capture line says when
             the reference was taken. The presets restyle as chips (T-156). -->
        <StackPanel IsVisible="{Binding Sizer.IsRowVisible}" Spacing="{StaticResource SpaceXs}">
            <TextBlock Text="{loc:Localized NewOrder.SizerBalanceCaption}" />
            <UniformGrid Columns="3">
                <Button Classes="chip-action"
                        Command="{Binding Sizer.ApplyQuarterCommand}"
                        Content="{loc:Localized NewOrder.SizerQuarter}"
                        MinWidth="52" Margin="0,0,8,0" />
                <Button Classes="chip-action"
                        Command="{Binding Sizer.ApplyHalfCommand}"
                        Content="{loc:Localized NewOrder.SizerHalf}"
                        MinWidth="52" Margin="0,0,8,0" />
                <Button Classes="chip-action"
                        Command="{Binding Sizer.ApplyWholeCommand}"
                        Content="{loc:Localized NewOrder.SizerWhole}"
                        MinWidth="62" />
            </UniformGrid>

            <Button Command="{Binding Sizer.RefreshSnapshotCommand}"
                    Content="{loc:Localized NewOrder.SizerSnapshotRefresh}"
                    HorizontalAlignment="Left"
                    MinWidth="110" />

            <!-- Risk percent: only while the order type anchors a stop
                 (a stop-limit's trigger distance, a trailing stop's trail);
                 a market or plain-limit order has no stop context, and the
                 OCO pair has none it could anchor one distance on — the
                 row hides the mode for exactly those. -->
            <StackPanel IsVisible="{Binding Sizer.IsRiskModeAvailable}" Spacing="{StaticResource SpaceXs}">
                <TextBlock Text="{loc:Localized NewOrder.SizerRiskCaption}" />
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                    <TextBox Text="{Binding Sizer.RiskPercentText}"
                             FontFamily="{StaticResource NumericFont}"
                             PlaceholderText="1"
                             MinWidth="80" />
                    <Button Command="{Binding Sizer.ApplyRiskCommand}"
                            Content="{loc:Localized NewOrder.SizerRiskApply}"
                            MinWidth="110" />
                </StackPanel>
                <TextBlock Text="{loc:Localized NewOrder.SizerRiskHint}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondary}" />
            </StackPanel>

            <TextBlock Text="{loc:Localized NewOrder.SizerSnapshotAbsent}"
                       IsVisible="{Binding Sizer.IsSnapshotMissing}"
                       Foreground="{DynamicResource TextSecondary}" />
            <TextBlock Text="{Binding Sizer.SnapshotDetail}"
                       IsVisible="{Binding Sizer.IsSnapshotAvailable}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}" />
            <TextBlock Text="{Binding Sizer.ProposalState}"
                       IsVisible="{Binding Sizer.HasProposalState}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- The daily loss governor's banner (T-189): the honest blocked
             state with its reset beside it. A display fact only — the
             submit pipeline re-checks the gate at every placement. -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceS}"
              IsVisible="{Binding IsDailyLossBlocked}">
            <TextBlock Grid.Column="0"
                       Text="{Binding DailyLossBanner}"
                       Foreground="{DynamicResource Error}"
                       TextWrapping="Wrap" />
            <Button Grid.Column="1"
                    Content="{loc:Localized Trading.DailyLossReset}"
                    AutomationProperties.AutomationId="DailyLossResetButton"
                    Command="{Binding ResetDailyLossCommand}"
                    VerticalAlignment="Top" />
        </Grid>

        <!-- Flow failures (risk rejection, market-relative sanity, adapter
             failure, OCO abort) — T-156 demoted the summary to the flow
             lane: a field's parse refusal renders next to its field. -->
        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource Error}"
                   TextWrapping="Wrap"
                   IsVisible="{Binding HasSummaryError}" />

        <UniformGrid Columns="2" HorizontalAlignment="Right" Margin="0,8,0,0">
            <!-- The primary CTA (T-156): the visually dominant action,
                 filled with the picked side's state color. -->
            <Button Classes="cta"
                    Classes.buy="{Binding IsBuySide}"
                    Classes.sell="{Binding IsSellSide}"
                    Command="{Binding PlaceOrderCommand}"
                    Content="{loc:Localized NewOrder.Place}"
                    MinWidth="120" Margin="0,0,8,0" />
            <Button Content="{loc:Localized Trading.Cancel}"
                    AutomationProperties.AutomationId="CancelButton"
                    Click="OnCancelClick"
                    MinWidth="90" />
        </UniformGrid>
    </StackPanel>
</Window>
