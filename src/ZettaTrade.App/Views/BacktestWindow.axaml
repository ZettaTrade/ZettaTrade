<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ZettaTrade.App.ViewModels"
        xmlns:loc="using:Livery.Localization"
        xmlns:charting="using:ZettaTrade.UI.Charting"
        x:Class="ZettaTrade.App.Views.BacktestWindow"
        Classes="chrome"
        Icon="/Assets/ZettaTrade.ico"
        x:DataType="vm:BacktestRunViewModel"
        Title="{loc:Localized Backtest.Title}"
        Width="1000" Height="720"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False"
        Background="{DynamicResource Background}">

    <Grid Margin="{StaticResource InsetL}" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" RowSpacing="{StaticResource SpaceM}">

        <!-- The run form: strategy over the T-111 seam, the active venue's
             cached series identity, the seed and the execution policy. Every
             field parses explicitly at start (an unparsable spelling is a
             refused start with its own line, never a substituted default). -->
        <WrapPanel Grid.Row="0">
            <StackPanel Margin="0,0,16,8">
                <TextBlock Text="{loc:Localized Backtest.Strategy}" Margin="0,0,0,4" />
                <ComboBox Width="190"
                          ItemsSource="{Binding StrategyIds}"
                          SelectedItem="{Binding StrategyId}" />
            </StackPanel>
            <StackPanel Margin="0,0,16,8">
                <TextBlock Text="{loc:Localized Backtest.Symbol}" Margin="0,0,0,4" />
                <TextBox Width="120" Text="{Binding SymbolText}" />
            </StackPanel>
            <StackPanel Margin="0,0,16,8">
                <TextBlock Text="{loc:Localized Backtest.Interval}" Margin="0,0,0,4" />
                <ComboBox Width="100"
                          ItemsSource="{Binding TimeFrames}"
                          SelectedItem="{Binding SelectedTimeFrame}" />
            </StackPanel>
            <StackPanel Margin="0,0,16,8">
                <TextBlock Text="{loc:Localized Backtest.Bars}" Margin="0,0,0,4" />
                <TextBox Width="110" Text="{Binding BarsText}" />
            </StackPanel>
            <StackPanel Margin="0,0,16,8">
                <TextBlock Text="{loc:Localized Backtest.Seed}" Margin="0,0,0,4" />
                <TextBox Width="110" Text="{Binding SeedText}" />
            </StackPanel>
            <StackPanel Margin="0,0,16,8">
                <TextBlock Text="{loc:Localized Backtest.Slippage}" Margin="0,0,0,4" />
                <TextBox Width="110" Text="{Binding SlippageText}" />
            </StackPanel>
            <StackPanel Margin="0,0,16,8">
                <TextBlock Text="{loc:Localized Backtest.LongFraction}" Margin="0,0,0,4" />
                <TextBox Width="110" Text="{Binding LongFractionText}" />
            </StackPanel>
        </WrapPanel>

        <!-- The sweep form (T-212): two grid axes over the request's own
             outcome-shaping knobs — the picker names the knob, the text
             carries the comma-separated values in declaration order. The
             grid composes and range-checks at start: an unparsable list, a
             too-long axis, a duplicate-knob grid or an out-of-range value
             is a refused start, never a corrected input. -->
        <StackPanel Grid.Row="1" Spacing="{StaticResource SpaceS}">
            <TextBlock Text="{loc:Localized Backtest.Sweep.Title}" FontWeight="SemiBold" />
            <WrapPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="{loc:Localized Backtest.Sweep.Parameter}" Margin="0,0,0,4" />
                    <ComboBox Width="190"
                              ItemsSource="{Binding SweepParameters}"
                              SelectedIndex="{Binding SweepFirstIndex}" />
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="{loc:Localized Backtest.Sweep.Values}" Margin="0,0,0,4" />
                    <TextBox Width="220" Text="{Binding SweepFirstValuesText}" />
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="{loc:Localized Backtest.Sweep.Parameter}" Margin="0,0,0,4" />
                    <ComboBox Width="190"
                              ItemsSource="{Binding SweepParameters}"
                              SelectedIndex="{Binding SweepSecondIndex}" />
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="{loc:Localized Backtest.Sweep.Values}" Margin="0,0,0,4" />
                    <TextBox Width="220" Text="{Binding SweepSecondValuesText}" />
                </StackPanel>
            </WrapPanel>
        </StackPanel>

        <!-- The run surface: the phase line, the progress bar and the
             refusal/failure line. During a sweep the progress line wraps
             the per-row bar line into the global counter ("Row k of n");
             the cancelled run surfaces no report. -->
        <StackPanel Grid.Row="2" Spacing="{StaticResource SpaceXs}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource SpaceM}">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontWeight="SemiBold" />
                <ProgressBar Grid.Column="1"
                             Minimum="0" Maximum="1"
                             Value="{Binding ProgressFraction, Mode=OneWay}"
                             Height="10"
                             VerticalAlignment="Center"
                             IsIndeterminate="False" />
                <TextBlock Grid.Column="2" Text="{Binding ProgressText}"
                           Foreground="{DynamicResource TextSecondary}" />
            </Grid>
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource Error}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasErrorMessage}" />
        </StackPanel>

        <!-- The sweep's ranked result table (T-212): the parameterizations
             ranked by net, the honest absence while nothing replayed. The
             click-through opens the selected row's own complete report on
             the report surface below. -->
        <StackPanel Grid.Row="3"
                    Spacing="{StaticResource SpaceXs}"
                    IsVisible="{Binding HasSweepRows}">
            <Grid ColumnDefinitions="50,240,110,110,90,100" ColumnSpacing="{StaticResource SpaceS}">
                <TextBlock Grid.Column="0"
                           Text="{loc:Localized Backtest.Sweep.Column.Rank}"
                           FontSize="{StaticResource CaptionFontSize}"
                           Foreground="{DynamicResource TextSecondary}" />
                <TextBlock Grid.Column="1"
                           Text="{loc:Localized Backtest.Sweep.Column.Parameter}"
                           FontSize="{StaticResource CaptionFontSize}"
                           Foreground="{DynamicResource TextSecondary}" />
                <TextBlock Grid.Column="2"
                           Text="{loc:Localized Backtest.Sweep.Column.Net}"
                           TextAlignment="Right"
                           FontSize="{StaticResource CaptionFontSize}"
                           Foreground="{DynamicResource TextSecondary}" />
                <TextBlock Grid.Column="3"
                           Text="{loc:Localized Backtest.Sweep.Column.Drawdown}"
                           TextAlignment="Right"
                           FontSize="{StaticResource CaptionFontSize}"
                           Foreground="{DynamicResource TextSecondary}" />
                <TextBlock Grid.Column="4"
                           Text="{loc:Localized Backtest.Sweep.Column.WinRate}"
                           TextAlignment="Right"
                           FontSize="{StaticResource CaptionFontSize}"
                           Foreground="{DynamicResource TextSecondary}" />
                <TextBlock Grid.Column="5"
                           Text="{loc:Localized Backtest.Sweep.Column.ProfitFactor}"
                           TextAlignment="Right"
                           FontSize="{StaticResource CaptionFontSize}"
                           Foreground="{DynamicResource TextSecondary}" />
            </Grid>
            <ListBox ItemsSource="{Binding SweepRows}"
                     SelectedItem="{Binding SelectedSweepRow, Mode=TwoWay}"
                     AutomationProperties.Name="{loc:Localized Backtest.Sweep.A11yRows}"
                     Background="Transparent"
                     MaxHeight="150"
                     Margin="0,0,16,0">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:BacktestSweepRowViewModel">
                        <Grid ColumnDefinitions="50,240,110,110,90,100" ColumnSpacing="{StaticResource SpaceS}">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Rank}"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ParameterText}" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding NetText}"
                                       TextAlignment="Right"
                                       FontFamily="{StaticResource NumericFont}" />
                            <TextBlock Grid.Column="3"
                                       Text="{Binding DrawdownText}"
                                       TextAlignment="Right"
                                       FontFamily="{StaticResource NumericFont}" />
                            <TextBlock Grid.Column="4"
                                       Text="{Binding WinRateText}"
                                       TextAlignment="Right"
                                       FontFamily="{StaticResource NumericFont}" />
                            <TextBlock Grid.Column="5"
                                       Text="{Binding ProfitFactorText}"
                                       TextAlignment="Right"
                                       FontFamily="{StaticResource NumericFont}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <!-- The report surface: the equity curve over the mark-to-cloud path
             and the localized headline line; the honest empty state while
             nothing replayed yet. The sweep's click-through swaps the
             selected row's own report in here. -->
        <Grid Grid.Row="4" RowDefinitions="Auto,Auto,*" RowSpacing="{StaticResource SpaceS}">
            <Button Grid.Row="0"
                    Content="{loc:Localized Backtest.Report.SummaryTitle}"
                    IsVisible="{Binding HasReport}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    FontWeight="Bold"
                    HorizontalAlignment="Left" />
            <TextBlock Grid.Row="1"
                       Text="{Binding SummaryText}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasReport}" />
            <charting:EquityCurveChart Grid.Row="2"
                                       AutomationProperties.Name="{loc:Localized Backtest.A11yEquity}"
                                       Points="{Binding EquityPoints}"
                                       IsVisible="{Binding HasEquity}" />
        </Grid>

        <!-- The canonical report text: the byte-stable serialization the
             determinism acceptance pins — a replay diff is exactly this
             text against the previous one. -->
        <TextBox Grid.Row="5"
                 Text="{Binding ReportText}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 Height="150"
                 FontFamily="{StaticResource NumericFont}"
                 IsVisible="{Binding HasReport}" />

        <Grid Grid.Row="6" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="{StaticResource SpaceM}">
            <Button Grid.Column="1"
                    Classes="primary"
                    Content="{loc:Localized Backtest.Start}"
                    Command="{Binding StartCommand}"
                    MinWidth="110" />
            <Button Grid.Column="2"
                    Content="{loc:Localized Backtest.Sweep.Start}"
                    Command="{Binding StartSweepCommand}"
                    MinWidth="110" />
            <Button Grid.Column="3"
                    Content="{loc:Localized Backtest.Cancel}"
                    Command="{Binding CancelCommand}"
                    MinWidth="110"
                    IsVisible="{Binding IsRunning}" />
            <Button Grid.Column="4"
                    Content="{loc:Localized Backtest.Close}"
                    Click="OnCloseClick"
                    MinWidth="90" />
        </Grid>

    </Grid>
</Window>
