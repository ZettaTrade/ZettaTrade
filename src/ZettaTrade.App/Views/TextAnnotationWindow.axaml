<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Livery.Localization"
        x:Class="ZettaTrade.App.Views.TextAnnotationWindow"
        Classes="chrome-compact"
        Icon="/Assets/ZettaTrade.ico"
        Title="{loc:Localized Chart.Text.PromptTitle}"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False"
        AutomationProperties.AutomationId="TextAnnotationWindow"
        Background="{DynamicResource Background}">
    <!-- The text annotation's prompt (T-200): the chart ViewModel raises
         the request through the interaction; the answer (the string, or
         null on cancel/empty) becomes the annotation's text. A plain
         single-line entry: the annotation renders one line over the
         chart. -->
    <StackPanel Margin="{StaticResource InsetL}" Spacing="{StaticResource SpaceM}">
        <!-- The caption carries x:Name (T-202): the template prompts
             pass their own caption at open time (the annotation keeps
             the localized default). -->
        <TextBlock x:Name="PromptCaption"
                   Text="{loc:Localized Chart.Text.PromptLabel}"
                   Foreground="{DynamicResource TextPrimary}"
                   TextWrapping="Wrap" />
        <TextBox x:Name="AnnotationInput"
                 MaxLength="120"
                 AutomationProperties.AutomationId="TextAnnotationInput" />
        <!-- The confirm strip (T-231): the settings footer's shape — the
             quiet cancel first, the ONE primary place last, both riding
             the 90 strip. -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="{StaticResource SpaceM}">
            <Button x:Name="CancelButton"
                    Content="{loc:Localized Chart.Text.Cancel}"
                    AutomationProperties.AutomationId="TextAnnotationCancel"
                    MinWidth="90"
                    Click="OnCancel" />
            <Button x:Name="PlaceButton"
                    Content="{loc:Localized Chart.Text.Place}"
                    AutomationProperties.AutomationId="TextAnnotationPlace"
                    Classes="primary"
                    MinWidth="90"
                    Click="OnPlace" />
        </StackPanel>
    </StackPanel>
</Window>
