<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ZettaTrade.App.ViewModels"
        xmlns:loc="using:Livery.Localization"
        x:Class="ZettaTrade.App.Views.DisclaimerDialogWindow"
        Classes="chrome-compact"
        Icon="/Assets/ZettaTrade.ico"
        x:DataType="vm:DisclaimerDialogViewModel"
        Title="{loc:Localized Trading.Disclaimer.Title}"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False"
        Background="{DynamicResource Background}">

    <!-- The whole body is static localized text ({loc:Localized}, no
         ViewModel state): the educational/not-investment-advice statement
         mirrors the README Disclaimer, the rest mirrors its alpha posture
         (alpha wording, paper-first, testnet-first, key hygiene). -->
    <StackPanel Margin="{StaticResource InsetL}" Spacing="{StaticResource SpaceM}">
        <TextBlock Text="{loc:Localized Trading.Disclaimer.NotAdvice}"
                   FontWeight="Bold"
                   TextWrapping="Wrap" />
        <TextBlock Text="{loc:Localized Trading.Disclaimer.AlphaStatus}"
                   TextWrapping="Wrap" />
        <TextBlock Text="{loc:Localized Trading.Disclaimer.PaperFirst}"
                   TextWrapping="Wrap" />
        <TextBlock Text="{loc:Localized Trading.Disclaimer.RealFunds}"
                   TextWrapping="Wrap" />
        <TextBlock Text="{loc:Localized Trading.Disclaimer.KeyHygiene}"
                   TextWrapping="Wrap" />
        <TextBlock Text="{loc:Localized Trading.Disclaimer.WhereToRead}"
                   TextWrapping="Wrap"
                   />
        <!-- The version line (T-153): the version left the status strip —
             the About dialog (this one) is its one-action home. The caption
             is static localized text, the value rides the view model. -->
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
            <TextBlock Text="{loc:Localized Trading.Disclaimer.Version}" />
            <TextBlock Text="{Binding VersionText}" />
        </StackPanel>
        <!-- The confirm strip (T-234): the settings footer's shape — the
             ONE primary acknowledge rides the 90 strip at the right edge,
             the row's own spacing clears the gap. -->
        <Button Content="{loc:Localized Trading.Disclaimer.Acknowledge}"
                Classes="primary"
                Command="{Binding AcknowledgeCommand}"
                MinWidth="90"
                HorizontalAlignment="Right" />
    </StackPanel>
</Window>
