<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ZettaTrade.App.ViewModels"
        xmlns:loc="using:Livery.Localization"
        x:Class="ZettaTrade.App.Views.ScreenerWindow"
        Classes="chrome"
        Icon="/Assets/ZettaTrade.ico"
        x:DataType="vm:ScreenerViewModel"
        Title="{loc:Localized Screener.Title}"
        Width="1120" Height="560"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False"
        Background="{DynamicResource Background}">

    <Window.Styles>
        <!-- T-195: the screener table rides the shared RowGrammar dictionary
             (the emphasized header row, the hairline rows) — the same
             scaffold the history window speaks; the window carries no table
             style copy. -->
        <StyleInclude Source="avares://ZettaTrade.App/Themes/RowGrammar.axaml" />

        <!-- The column-sort headers: the quiet caption buttons over the
             header row's hairline. No Background rest — the generic kit's
             hover and focus stay alive; the press rides the strip's dim
             step (the T-181 kit language). T-235: the stretch is explicit —
             the Avalonia 12 fluent theme defaults every button to Left, so
             the sort caption only rides its column's right edge (the data
             columns' alignment) when the button fills the column. The
             review round (T-235): the kit's rest hairline boxed every
             caption and the right-aligned text sat flush against its
             border — the captions read as captions over the row hairline
             instead (the Funding caption's own look), the transparent rest
             border keeps the T-110 focus ring reachable through the re-arm
             below, and the alignment never trades for an inset. -->
        <Style Selector="Button.column-sort">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.column-sort:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource Highlight}" />
        </Style>
        <Style Selector="Button.column-sort:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Button.column-sort:pressed">
            <Setter Property="Opacity" Value="0.8" />
        </Style>

        <!-- The row press target: the whole row is one button (a click
             routes the symbol into the workspace). T-235's headless probe
             named the missing stretch: Avalonia 12's fluent ControlTheme
             carries HorizontalAlignment=Left on every button, so the T-195
             content-alignment setter stretched only the row's CONTENT —
             the button itself sat at its content width, every row at its
             own width under the shared header plan. The row style owns
             the stretch explicitly and trades the fluent chrome (the 1px
             rounded border, the pressed scale squish) for the row
             grammar's own look: the bottom hairline separator, square
             corners, the opacity-dim press. The hover affordance reads
             Surface over the window background — the watchlist rows'
             hover language. -->
        <Style Selector="Button.screener-row">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.screener-row:pointerover">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
        </Style>
        <Style Selector="Button.screener-row:pressed">
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="RenderTransform" Value="none" />
        </Style>

        <!-- T-159: the change text tints by the 24h sign (the candle state
             colors); a flat change keeps the plain ink. -->
        <Style Selector="TextBlock.screener-change.up">
            <Setter Property="Foreground" Value="{DynamicResource CandleUp}" />
        </Style>
        <Style Selector="TextBlock.screener-change.down">
            <Setter Property="Foreground" Value="{DynamicResource CandleDown}" />
        </Style>

        <!-- The trend-state cells (T-239): quiet click targets inside the
             row press target (the AssistantPanelView's nested-button
             precedent) — each routes the row's symbol into the workspace
             at the cell's own timeframe. The chrome trades for the row
             grammar's look exactly like the row itself: transparent rest,
             square corners, the Surface hover wash; a bull or bear verdict
             tints the word by the candle state colors, warming and range
             keep the plain secondary ink (the honest state, never dressed
             up as a verdict). -->
        <Style Selector="Button.trend-cell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="MinHeight" Value="18" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
        <Style Selector="Button.trend-cell:pointerover">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Button.trend-cell:pressed">
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style Selector="Button.trend-cell.bull">
            <Setter Property="Foreground" Value="{DynamicResource CandleUp}" />
        </Style>
        <Style Selector="Button.trend-cell.bear">
            <Setter Property="Foreground" Value="{DynamicResource CandleDown}" />
        </Style>
    </Window.Styles>

    <Grid Margin="{StaticResource InsetL}" RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource SpaceM}">

        <!-- The preset picker: the static localized items bind by index (the
             chart type selector's precedent); the picker shows only over
             live data — a switch with nothing to screen is fabricated
             chrome over a missing feed. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="{StaticResource SpaceS}" IsVisible="{Binding IsLive}">
            <TextBlock Text="{loc:Localized Screener.Preset}" VerticalAlignment="Center" />
            <ComboBox MinWidth="150" SelectedIndex="{Binding SelectedPresetIndex}">
                <ComboBoxItem Content="{loc:Localized Screener.Preset.All}" />
                <ComboBoxItem Content="{loc:Localized Screener.Preset.Gainers}" />
                <ComboBoxItem Content="{loc:Localized Screener.Preset.Losers}" />
                <ComboBoxItem Content="{loc:Localized Screener.Preset.Volume}" />
            </ComboBox>
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <!-- The table ends a strip short of the overlay bar's right
                 edge (T-170). -->
            <StackPanel Spacing="{StaticResource SpaceS}" Margin="0,0,16,0">

                <!-- The honest states: the reason line replaces a broken
                     table, the waiting line replaces an unpriced one. -->
                <TextBlock Text="{loc:Localized Screener.NoCatalog}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding IsCatalogUnavailable}" />
                <TextBlock Text="{loc:Localized Screener.WaitingTicks}"
                           IsVisible="{Binding IsWaitingTicks}" />

                <!-- Column headers: the emphasized header row over the
                     grammar's hairline; the numeric columns are the sort
                     buttons and right-align to match their data cells. The
                     funding caption is display-only (T-197): the rate rides
                     the ticker's honest null and owns no sort shim yet. The
                     trend captions (T-239) are display-only the same way:
                     the states ride the trend computer, never a sort plan. -->
                <Border Classes="table-header-row" IsVisible="{Binding HasRows}">
                    <Grid ColumnDefinitions="140,*,110,110,110,64,64,64,64">
                        <TextBlock Grid.Column="0" Text="{loc:Localized Screener.ColSymbol}" />
                        <Button Grid.Column="1" Classes="column-sort" HorizontalContentAlignment="Right"
                                Content="{loc:Localized Screener.ColPrice}" Command="{Binding SortByPriceCommand}" />
                        <Button Grid.Column="2" Classes="column-sort" HorizontalContentAlignment="Right"
                                Content="{loc:Localized Screener.ColChange}" Command="{Binding SortByChangeCommand}" />
                        <Button Grid.Column="3" Classes="column-sort" HorizontalContentAlignment="Right"
                                Content="{loc:Localized Screener.ColVolume}" Command="{Binding SortByVolumeCommand}" />
                        <TextBlock Grid.Column="4" Text="{loc:Localized Screener.ColFunding}"
                                   HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="5" Text="{loc:Localized Screener.ColTrendM15}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="6" Text="{loc:Localized Screener.ColTrendH1}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="7" Text="{loc:Localized Screener.ColTrendH4}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="8" Text="{loc:Localized Screener.ColTrendD1}"
                                   HorizontalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- The live rows, in the standing sort; the whole row is
                     the press target (the route command rides the window's
                     DataContext). The trend cells (T-239) are the nested
                     quiet buttons: each routes the row's symbol into the
                     workspace at its own timeframe. -->
                <ItemsControl ItemsSource="{Binding Rows}"
                              IsVisible="{Binding HasRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ScreenerRowViewModel">
                            <Button Classes="screener-row"
                                    Command="{Binding $parent[Window].((vm:ScreenerViewModel)DataContext).RouteRowCommand}"
                                    CommandParameter="{Binding}">
                                <Grid ColumnDefinitions="140,*,110,110,110,64,64,64,64">
                                    <TextBlock Grid.Column="0" Text="{Binding Symbol}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Price}" FontFamily="{StaticResource NumericFont}" TextAlignment="Right" />
                                    <TextBlock Grid.Column="2" Text="{Binding Change}" FontFamily="{StaticResource NumericFont}" TextAlignment="Right"
                                               Classes="screener-change"
                                               Classes.up="{Binding IsChangeUp}"
                                               Classes.down="{Binding IsChangeDown}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Volume}" FontFamily="{StaticResource NumericFont}" TextAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="{Binding Funding}" FontFamily="{StaticResource NumericFont}" TextAlignment="Right" />
                                    <Button Grid.Column="5" Classes="trend-cell"
                                            Classes.bull="{Binding TrendM15.IsBull}"
                                            Classes.bear="{Binding TrendM15.IsBear}"
                                            Content="{Binding TrendM15.Text}"
                                            Command="{Binding $parent[Window].((vm:ScreenerViewModel)DataContext).RouteTrendM15Command}"
                                            CommandParameter="{Binding}" />
                                    <Button Grid.Column="6" Classes="trend-cell"
                                            Classes.bull="{Binding TrendH1.IsBull}"
                                            Classes.bear="{Binding TrendH1.IsBear}"
                                            Content="{Binding TrendH1.Text}"
                                            Command="{Binding $parent[Window].((vm:ScreenerViewModel)DataContext).RouteTrendH1Command}"
                                            CommandParameter="{Binding}" />
                                    <Button Grid.Column="7" Classes="trend-cell"
                                            Classes.bull="{Binding TrendH4.IsBull}"
                                            Classes.bear="{Binding TrendH4.IsBear}"
                                            Content="{Binding TrendH4.Text}"
                                            Command="{Binding $parent[Window].((vm:ScreenerViewModel)DataContext).RouteTrendH4Command}"
                                            CommandParameter="{Binding}" />
                                    <Button Grid.Column="8" Classes="trend-cell"
                                            Classes.bull="{Binding TrendD1.IsBull}"
                                            Classes.bear="{Binding TrendD1.IsBear}"
                                            Content="{Binding TrendD1.Text}"
                                            Command="{Binding $parent[Window].((vm:ScreenerViewModel)DataContext).RouteTrendD1Command}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
            <Button Grid.Column="1"
                    Content="{loc:Localized Screener.Close}"
                    Click="OnCloseClick"
                    MinWidth="90"
                    HorizontalAlignment="Right" />
        </Grid>

    </Grid>
</Window>
