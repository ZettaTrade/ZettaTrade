<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:log="using:ZettaTrade.App.Services"
        xmlns:loc="using:Livery.Localization"
        x:Class="ZettaTrade.App.Views.CrashDialogWindow"
        Classes="chrome-compact"
        Icon="/Assets/ZettaTrade.ico"
        x:DataType="log:CrashReport"
        Title="{loc:Localized Log.Crash.Title}"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        CanResize="True"
        ShowInTaskbar="False"
        Background="{DynamicResource Background}">

    <StackPanel Margin="{StaticResource InsetL}" Spacing="{StaticResource SpaceL}">

        <TextBlock Text="{loc:Localized Log.Crash.Title}"
                   FontWeight="Bold"
                   FontSize="{StaticResource TitleFontSize}" />

        <!-- The composed summary: the exception type + its message (the
             crash guard composes it during the teardown; nothing updates
             here — the dialog is read-only, the process exits after it). -->
        <TextBlock Text="{Binding Summary}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextPrimary}" />

        <!-- The point of the dialog: where the log lives. The path is
             selectable text — a user can copy it before the process exits
             and read the file after the app is gone. -->
        <SelectableTextBlock Text="{Binding LogPathLine}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondary}" />

        <!-- The confirm strip (T-231): the ONE primary dismiss rides the
             90 strip at the right edge. -->
        <Button Content="{loc:Localized Log.Crash.Dismiss}"
                Classes="primary"
                HorizontalAlignment="Right"
                MinWidth="90"
                Click="OnDismissClick" />
    </StackPanel>
</Window>
