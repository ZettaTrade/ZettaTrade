<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ZettaTrade.App.ViewModels"
        xmlns:loc="using:Livery.Localization"
        x:Class="ZettaTrade.App.Views.PaperResetDialogWindow"
        Classes="chrome-compact"
        Icon="/Assets/ZettaTrade.ico"
        x:DataType="vm:PaperResetDialogViewModel"
        AutomationProperties.AutomationId="PaperResetDialogWindow"
        Title="{loc:Localized Trading.PaperResetTitle}"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False"
        Background="{DynamicResource Background}">

    <StackPanel Margin="{StaticResource InsetL}" Spacing="{StaticResource SpaceM}">
        <!-- What the reset does: the scope named once, precomputed by the
             view model at initialize time -->
        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />

        <TextBlock Text="{loc:Localized Trading.PaperResetBalanceLabel}" />
        <TextBox Text="{Binding BalanceInput, Mode=TwoWay}"
                 AutomationProperties.AutomationId="PaperResetBalanceInput"
                 FontFamily="{StaticResource NumericFont}"
                 PlaceholderText="100000" />

        <!-- The scope spelled out once (the quiet hint ink): live and
             testnet venues stay untouched -->
        <TextBlock Text="{loc:Localized Trading.PaperResetHint}"
                   Foreground="{DynamicResource TextSecondary}"
                   TextWrapping="Wrap" />

        <!-- Parse errors, never a defaulted field -->
        <TextBlock Text="{Binding ErrorMessage}"
                   AutomationProperties.AutomationId="PaperResetErrorLine"
                   Foreground="{DynamicResource Error}"
                   TextWrapping="Wrap"
                   IsVisible="{Binding HasErrorMessage}" />

        <!-- The confirm strip (T-231): the settings footer's shape — the
             quiet cancel first, the ONE primary apply last, both riding
             the 90 strip and the row's own spacing. -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{StaticResource SpaceM}">
            <Button Content="{loc:Localized Trading.Cancel}"
                    AutomationProperties.AutomationId="PaperResetCancelButton"
                    Click="OnCancelClick"
                    MinWidth="90" />
            <Button Click="OnApplyClick"
                    AutomationProperties.AutomationId="PaperResetApplyButton"
                    Classes="primary"
                    Content="{loc:Localized Trading.PaperResetApply}"
                    MinWidth="90" />
        </StackPanel>
    </StackPanel>
</Window>
