<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ZettaTrade.App.ViewModels"
        xmlns:loc="using:Livery.Localization"
        x:Class="ZettaTrade.App.Views.OrderHistoryWindow"
        Classes="chrome"
        x:DataType="vm:OrderHistoryViewModel"
        Title="{loc:Localized History.Title}"
        Width="1000" Height="520"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False"
        Background="{DynamicResource Background}">

    <Window.Styles>
        <!-- T-157: the history table rides the shared RowGrammar dictionary
             (the emphasized header row, the hairline rows, the side chips'
             state fills) — the same scaffold the positions panel's three
             sections speak; the window carries no table style copy. -->
        <StyleInclude Source="avares://ZettaTrade.App/Themes/RowGrammar.axaml" />
    </Window.Styles>

    <Grid Margin="{StaticResource InsetL}" RowDefinitions="*,Auto,Auto" RowSpacing="10">

        <ScrollViewer Grid.Row="0">
            <StackPanel Spacing="{StaticResource SpaceS}">

                <!-- Testnet lane badge (T-127): top-right, mirrors the
                     status-bar chip; visible only while the traded surface
                     rides the testnet lane. The badge is the Livery chip
                     class (T-154): the shape, the testnet fill and the
                     readable caption treatment live there. -->
                <Border Classes="chip"
                        HorizontalAlignment="Right"
                        IsVisible="{Binding IsTestnetLane}"
                        ToolTip.Tip="{loc:Localized Exchange.TestnetBadge.Tooltip}"
                        Classes.testnet="{Binding IsTestnetLane}">
                    <TextBlock Text="{loc:Localized Exchange.TestnetBadge}" />
                </Border>

                <!-- Column headers: the emphasized header row over the
                     grammar's hairline; the numeric columns right-align to
                     match their data cells (T-157). -->
                <Border Classes="table-header-row"
                        IsVisible="{Binding HasRows}">
                    <Grid ColumnDefinitions="130,90,*,80,100,90,110,120,90">
                        <TextBlock Grid.Column="0" TextAlignment="Right" Text="{loc:Localized History.ColOpened}" />
                        <TextBlock Grid.Column="1" Text="{loc:Localized History.ColExchange}" />
                        <TextBlock Grid.Column="2" Text="{loc:Localized History.ColSymbol}" />
                        <TextBlock Grid.Column="3" Text="{loc:Localized History.ColSide}" />
                        <TextBlock Grid.Column="4" Text="{loc:Localized History.ColType}" />
                        <TextBlock Grid.Column="5" TextAlignment="Right" Text="{loc:Localized History.ColQuantity}" />
                        <TextBlock Grid.Column="6" TextAlignment="Right" Text="{loc:Localized History.ColPrice}" />
                        <TextBlock Grid.Column="7" Text="{loc:Localized History.ColStatus}" />
                        <TextBlock Grid.Column="8" TextAlignment="Right" Text="{loc:Localized Fees.ColumnTitle}" />
                    </Grid>
                </Border>

                <!-- Empty state -->
                <TextBlock Text="{loc:Localized History.Empty}"
                           IsVisible="{Binding !HasRows}" />

                <!-- Persisted journal rows, newest first -->
                <ItemsControl ItemsSource="{Binding Rows}"
                              IsVisible="{Binding HasRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:OrderHistoryRowViewModel">
                            <Border Classes="table-row">
                                <Grid ColumnDefinitions="130,90,*,80,100,90,110,120,90">
                                    <TextBlock Grid.Column="0" Text="{Binding Opened}" FontFamily="{StaticResource NumericFont}" TextAlignment="Right" />
                                    <TextBlock Grid.Column="1" Text="{Binding Exchange}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Symbol}" />
                                    <Border Grid.Column="3"
                                            Classes="chip"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Classes.buy="{Binding IsBuySide}"
                                            Classes.sell="{Binding IsSellSide}">
                                        <TextBlock Text="{Binding Side}" />
                                    </Border>
                                    <TextBlock Grid.Column="4" Text="{Binding Type}" />
                                    <TextBlock Grid.Column="5" Text="{Binding Quantity}" FontFamily="{StaticResource NumericFont}" TextAlignment="Right" />
                                    <TextBlock Grid.Column="6" Text="{Binding Price}" FontFamily="{StaticResource NumericFont}" TextAlignment="Right" />
                                    <TextBlock Grid.Column="7" Text="{Binding Status}" />
                                    <TextBlock Grid.Column="8" Text="{Binding Fee}" FontFamily="{StaticResource NumericFont}" TextAlignment="Right" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- Load failure -->
        <TextBlock Grid.Row="1"
                   Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource Error}"
                   TextWrapping="Wrap"
                   IsVisible="{Binding HasErrorMessage}" />

        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto">
            <Button Grid.Column="0"
                    Content="{loc:Localized History.ExportOrdersCsv}"
                    Command="{Binding ExportOrdersCommand}"
                    MinWidth="110" />
            <Button Grid.Column="1"
                    Margin="8,0,0,0"
                    Content="{loc:Localized History.ExportFillsCsv}"
                    Command="{Binding ExportFillsCommand}"
                    MinWidth="110" />
            <Button Grid.Column="3"
                    Content="{loc:Localized History.Close}"
                    Click="OnCloseClick"
                    MinWidth="90"
                    HorizontalAlignment="Right" />
        </Grid>

    </Grid>
</Window>
