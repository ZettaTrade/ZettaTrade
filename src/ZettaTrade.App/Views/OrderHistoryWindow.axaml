<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ZettaTrade.App.ViewModels"
        xmlns:loc="using:Livery.Localization"
        x:Class="ZettaTrade.App.Views.OrderHistoryWindow"
        Classes="chrome"
        x:DataType="vm:OrderHistoryViewModel"
        Title="{loc:Localized History.Title}"
        Width="1000" Height="520"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False"
        Background="{DynamicResource Background}">

    <Grid Margin="16" RowDefinitions="*,Auto,Auto" RowSpacing="10">

        <ScrollViewer Grid.Row="0">
            <StackPanel Spacing="6">

                <!-- Testnet lane badge (T-127): top-right, mirrors the
                     status-bar chip; visible only while the traded surface
                     rides the testnet lane. The badge is the Livery chip
                     class (T-154): the shape, the testnet fill and the
                     readable caption treatment live there. -->
                <Border Classes="chip"
                        HorizontalAlignment="Right"
                        IsVisible="{Binding IsTestnetLane}"
                        ToolTip.Tip="{loc:Localized Exchange.TestnetBadge.Tooltip}"
                        Classes.testnet="{Binding IsTestnetLane}">
                    <TextBlock Text="{loc:Localized Exchange.TestnetBadge}" />
                </Border>

                <!-- Column headers -->
                <Grid ColumnDefinitions="150,90,125,55,75,75,150,125,110"
                      IsVisible="{Binding HasRows}">
                    <TextBlock Grid.Column="0" Text="{loc:Localized History.ColOpened}" />
                    <TextBlock Grid.Column="1" Text="{loc:Localized History.ColExchange}" />
                    <TextBlock Grid.Column="2" Text="{loc:Localized History.ColSymbol}" />
                    <TextBlock Grid.Column="3" Text="{loc:Localized History.ColSide}" />
                    <TextBlock Grid.Column="4" Text="{loc:Localized History.ColType}" />
                    <TextBlock Grid.Column="5" Text="{loc:Localized History.ColQuantity}" />
                    <TextBlock Grid.Column="6" Text="{loc:Localized History.ColPrice}" />
                    <TextBlock Grid.Column="7" Text="{loc:Localized History.ColStatus}" />
                    <TextBlock Grid.Column="8" Text="{loc:Localized Fees.ColumnTitle}" />
                </Grid>

                <!-- Empty state -->
                <TextBlock Text="{loc:Localized History.Empty}"
                           IsVisible="{Binding !HasRows}" />

                <!-- Persisted journal rows, newest first -->
                <ItemsControl ItemsSource="{Binding Rows}"
                              IsVisible="{Binding HasRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:OrderHistoryRowViewModel">
                            <Grid ColumnDefinitions="150,90,125,55,75,75,150,125,110">
                                <TextBlock Grid.Column="0" Text="{Binding Opened}" />
                                <TextBlock Grid.Column="1" Text="{Binding Exchange}" />
                                <TextBlock Grid.Column="2" Text="{Binding Symbol}" />
                                <TextBlock Grid.Column="3" Text="{Binding Side}" />
                                <TextBlock Grid.Column="4" Text="{Binding Type}" />
                                <TextBlock Grid.Column="5" Text="{Binding Quantity}" />
                                <TextBlock Grid.Column="6" Text="{Binding Price}" />
                                <TextBlock Grid.Column="7" Text="{Binding Status}" />
                                <TextBlock Grid.Column="8" Text="{Binding Fee}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- Load failure -->
        <TextBlock Grid.Row="1"
                   Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource Error}"
                   TextWrapping="Wrap"
                   IsVisible="{Binding HasErrorMessage}" />

        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto">
            <Button Grid.Column="0"
                    Content="{loc:Localized History.ExportOrdersCsv}"
                    Command="{Binding ExportOrdersCommand}"
                    MinWidth="110" />
            <Button Grid.Column="1"
                    Margin="8,0,0,0"
                    Content="{loc:Localized History.ExportFillsCsv}"
                    Command="{Binding ExportFillsCommand}"
                    MinWidth="110" />
            <Button Grid.Column="3"
                    Content="{loc:Localized History.Close}"
                    Click="OnCloseClick"
                    MinWidth="90"
                    HorizontalAlignment="Right" />
        </Grid>

    </Grid>
</Window>
