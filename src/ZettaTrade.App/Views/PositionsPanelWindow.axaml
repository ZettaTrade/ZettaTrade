<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ZettaTrade.App.ViewModels"
        xmlns:loc="using:Livery.Localization"
        x:Class="ZettaTrade.App.Views.PositionsPanelWindow"
        Classes="chrome"
        x:DataType="vm:PositionsPanelViewModel"
        Title="{loc:Localized Positions.Title}"
        Width="1000" Height="560"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False"
        Background="{DynamicResource Background}">

    <Grid Margin="16" RowDefinitions="*,Auto,Auto" RowSpacing="10">

        <ScrollViewer Grid.Row="0">
            <StackPanel Spacing="14">

                <!-- Testnet lane badge (T-127): top-right, mirrors the
                     status-bar chip; visible only while the traded surface
                     rides the testnet lane. -->
                <Border CornerRadius="9"
                        Padding="8,2"
                        HorizontalAlignment="Right"
                        IsVisible="{Binding IsTestnetLane}"
                        ToolTip.Tip="{loc:Localized Exchange.TestnetBadge.Tooltip}"
                        Classes.testnet="{Binding IsTestnetLane}">
                    <Border.Styles>
                        <Style Selector="Border.testnet">
                            <Setter Property="Background" Value="{DynamicResource Highlight}" />
                        </Style>
                    </Border.Styles>
                    <TextBlock Text="{loc:Localized Exchange.TestnetBadge}"
                               FontSize="11"
                               FontWeight="SemiBold" />
                </Border>

                <!-- Open positions -->
                <StackPanel Spacing="6">
                    <TextBlock Text="{loc:Localized Positions.PositionsHeader}" FontWeight="Bold" />
                    <Grid ColumnDefinitions="125,50,75,150,150,320"
                          IsVisible="{Binding HasPositions}">
                        <TextBlock Grid.Column="0" Text="{loc:Localized Positions.Symbol}" />
                        <TextBlock Grid.Column="1" Text="{loc:Localized Positions.Side}" />
                        <TextBlock Grid.Column="2" Text="{loc:Localized Positions.ColQuantity}" />
                        <TextBlock Grid.Column="3" Text="{loc:Localized Positions.ColPrice}" />
                        <TextBlock Grid.Column="4" Text="{loc:Localized Positions.ColOpened}" />
                        <TextBlock Grid.Column="5" Text="{loc:Localized Positions.ActionsHeader}" />
                    </Grid>
                    <TextBlock Text="{loc:Localized Positions.NoPositions}"
                               IsVisible="{Binding !HasPositions}" />
                    <ItemsControl ItemsSource="{Binding Positions}"
                                  IsVisible="{Binding HasPositions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PositionRowViewModel">
                                <Grid ColumnDefinitions="125,50,75,150,150,320">
                                    <TextBlock Grid.Column="0" Text="{Binding Symbol}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Side}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Quantity}" />
                                    <TextBlock Grid.Column="3" Text="{Binding EntryPrice}" />
                                    <TextBlock Grid.Column="4" Text="{Binding Opened}" />
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4">
                                        <TextBox Width="76"
                                                 Text="{Binding ReduceQuantityInput}"
                                                 PlaceholderText="{loc:Localized Positions.ReduceWatermark}" />
                                        <Button Content="{loc:Localized Positions.ActionReduce}"
                                                Command="{Binding ReduceCommand}"
                                                MinWidth="64" HorizontalAlignment="Left" />
                                        <Button Content="{loc:Localized Positions.ActionClose}"
                                                Command="{Binding CloseCommand}"
                                                MinWidth="64" HorizontalAlignment="Left" />
                                        <Button Content="{loc:Localized Positions.ActionReverse}"
                                                Command="{Binding ReverseCommand}"
                                                MinWidth="64" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Open orders -->
                <StackPanel Spacing="6">
                    <TextBlock Text="{loc:Localized Positions.OpenOrdersHeader}" FontWeight="Bold" />
                    <!-- Bulk action (T-076): cancel every working order on the
                         workspace's active symbol; the panel gates it by the
                         idle state and the non-empty section. -->
                    <Button Content="{loc:Localized Positions.ActionBulkCancel}"
                            Command="{Binding CancelAllCommand}"
                            MinWidth="90" HorizontalAlignment="Left" />
                    <Grid ColumnDefinitions="125,50,75,150,125,150,180"
                          IsVisible="{Binding HasOpenOrders}">
                        <TextBlock Grid.Column="0" Text="{loc:Localized Positions.Symbol}" />
                        <TextBlock Grid.Column="1" Text="{loc:Localized Positions.Side}" />
                        <TextBlock Grid.Column="2" Text="{loc:Localized Positions.ColQuantity}" />
                        <TextBlock Grid.Column="3" Text="{loc:Localized Positions.ColPrice}" />
                        <TextBlock Grid.Column="4" Text="{loc:Localized Positions.ColStatus}" />
                        <TextBlock Grid.Column="5" Text="{loc:Localized Positions.ColOpened}" />
                    </Grid>
                    <TextBlock Text="{loc:Localized Positions.NoOpenOrders}"
                               IsVisible="{Binding !HasOpenOrders}" />
                    <ItemsControl ItemsSource="{Binding OpenOrders}"
                                  IsVisible="{Binding HasOpenOrders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:OrderRowViewModel">
                                <Grid ColumnDefinitions="125,50,75,150,125,150,180">
                                    <TextBlock Grid.Column="0" Text="{Binding Symbol}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Side}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Quantity}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Price}" />
                                    <!-- Status: the plain status, or the amending
                                         marker while this row's amend is in flight -->
                                    <Grid Grid.Column="4">
                                        <TextBlock Text="{Binding Status}" IsVisible="{Binding !IsAmending}" />
                                        <TextBlock Text="{loc:Localized Positions.AmendRowStatus}"
                                                   IsVisible="{Binding IsAmending}" />
                                    </Grid>
                                    <TextBlock Grid.Column="5" Text="{Binding Opened}" />
                                    <StackPanel Grid.Column="6" Orientation="Horizontal">
                                        <Button Content="{loc:Localized Positions.Amend}"
                                                Command="{Binding AmendCommand}"
                                                IsVisible="{Binding IsAmendable}"
                                                MinWidth="64" HorizontalAlignment="Left" />
                                        <Button Content="{loc:Localized Positions.CancelCurrentPosition}"
                                                Command="{Binding CancelCommand}"
                                                MinWidth="64" HorizontalAlignment="Left"
                                                Margin="6,0,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Orders placed this session (from the session order journal) -->
                <StackPanel Spacing="6">
                    <TextBlock Text="{loc:Localized Positions.RecentHeader}" FontWeight="Bold" />
                    <Grid ColumnDefinitions="125,50,75,150,125,150,110,180"
                          IsVisible="{Binding HasRecentOrders}">
                        <TextBlock Grid.Column="0" Text="{loc:Localized Positions.Symbol}" />
                        <TextBlock Grid.Column="1" Text="{loc:Localized Positions.Side}" />
                        <TextBlock Grid.Column="2" Text="{loc:Localized Positions.ColQuantity}" />
                        <TextBlock Grid.Column="3" Text="{loc:Localized Positions.ColPrice}" />
                        <TextBlock Grid.Column="4" Text="{loc:Localized Positions.ColStatus}" />
                        <TextBlock Grid.Column="5" Text="{loc:Localized Positions.ColOpened}" />
                        <TextBlock Grid.Column="6" Text="{loc:Localized Fees.ColumnTitle}" />
                    </Grid>
                    <TextBlock Text="{loc:Localized Positions.NoRecent}"
                               IsVisible="{Binding !HasRecentOrders}" />
                    <ItemsControl ItemsSource="{Binding RecentOrders}"
                                  IsVisible="{Binding HasRecentOrders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:OrderRowViewModel">
                                <Grid ColumnDefinitions="125,50,75,150,125,150,110,180">
                                    <TextBlock Grid.Column="0" Text="{Binding Symbol}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Side}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Quantity}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Price}" />
                                    <!-- Status: the plain status, or the amending
                                         marker while this row's amend is in flight -->
                                    <Grid Grid.Column="4">
                                        <TextBlock Text="{Binding Status}" IsVisible="{Binding !IsAmending}" />
                                        <TextBlock Text="{loc:Localized Positions.AmendRowStatus}"
                                                   IsVisible="{Binding IsAmending}" />
                                    </Grid>
                                    <TextBlock Grid.Column="5" Text="{Binding Opened}" />
                                    <TextBlock Grid.Column="6" Text="{Binding Fee}" />
                                    <StackPanel Grid.Column="7" Orientation="Horizontal">
                                        <Button Content="{loc:Localized Positions.Amend}"
                                                Command="{Binding AmendCommand}"
                                                IsVisible="{Binding IsAmendable}"
                                                MinWidth="64" HorizontalAlignment="Left" />
                                        <Button Content="{loc:Localized Positions.CancelCurrentPosition}"
                                                Command="{Binding CancelCommand}"
                                                MinWidth="64" HorizontalAlignment="Left"
                                                Margin="6,0,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Spacing="6">
            <!-- Flow errors (load failure, cancel/amend failure) -->
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource Error}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasErrorMessage}" />
            <!-- Last successful cancellation or amend outcome -->
            <TextBlock Text="{Binding ResultMessage}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasResultMessage}" />
        </StackPanel>

        <Button Grid.Row="2"
                Content="{loc:Localized Positions.Close}"
                Click="OnCloseClick"
                MinWidth="90"
                HorizontalAlignment="Right" />

    </Grid>
</Window>
