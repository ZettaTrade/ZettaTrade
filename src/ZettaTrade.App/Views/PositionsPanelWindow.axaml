<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ZettaTrade.App.ViewModels"
        xmlns:loc="using:Livery.Localization"
        x:Class="ZettaTrade.App.Views.PositionsPanelWindow"
        Classes="chrome"
        Icon="/Assets/ZettaTrade.ico"
        x:DataType="vm:PositionsPanelViewModel"
        Title="{loc:Localized Positions.Title}"
        Width="1000" Height="560"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False"
        Background="{DynamicResource Background}">

    <Window.Styles>
        <!-- T-157: the table grammar rides the shared RowGrammar dictionary
             (the emphasized header row, the hairline rows, the side chips'
             state fills and the row-action hierarchy) — the windows carry
             no table style copies of their own. -->
        <StyleInclude Source="avares://ZettaTrade.App/Themes/RowGrammar.axaml" />
    </Window.Styles>

    <Grid Margin="{StaticResource InsetL}" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="{StaticResource SpaceM}">

        <!-- Testnet lane badge (T-127): top-right, mirrors the
             status-bar chip; visible only while the traded surface
             rides the testnet lane. The badge is the Livery chip
             class (T-154): the shape, the testnet fill and the
             readable caption treatment live there. -->
        <Border Classes="chip"
                Grid.Row="0"
                HorizontalAlignment="Right"
                IsVisible="{Binding IsTestnetLane}"
                ToolTip.Tip="{loc:Localized Exchange.TestnetBadge.Tooltip}"
                Classes.testnet="{Binding IsTestnetLane}">
            <TextBlock Text="{loc:Localized Exchange.TestnetBadge}" />
        </Border>

        <!-- The three sections (T-157) split by tabs: the stacked
             one-scroll scaffold never settled the muscle memory — each
             section now owns a tab, the shared RowGrammar carries the
             header rows, the hairline rows, the side chips and the action
             hierarchy, and the command wiring is untouched. The numeric
             columns right-align on the shared NumericFont stack (T-155)
             so the digits hold their place across rows and languages. -->
        <TabControl Grid.Row="1">

            <!-- Open positions -->
            <TabItem Header="{loc:Localized Positions.TabPositions}">
                <ScrollViewer>
                    <!-- The table stack ends a strip short of the overlay
                         bar's right edge (T-170): the row actions must not
                         sit under it. -->
                    <StackPanel Spacing="{StaticResource SpaceS}" Margin="0,0,16,0">
                        <Border Classes="table-header-row"
                                IsVisible="{Binding HasPositions}">
                            <Grid ColumnDefinitions="*,80,90,110,140,320">
                                <TextBlock Grid.Column="0" Text="{loc:Localized Positions.Symbol}" />
                                <TextBlock Grid.Column="1" Text="{loc:Localized Positions.Side}" />
                                <TextBlock Grid.Column="2" TextAlignment="Right" Text="{loc:Localized Positions.ColQuantity}" />
                                <TextBlock Grid.Column="3" TextAlignment="Right" Text="{loc:Localized Positions.ColPrice}" />
                                <TextBlock Grid.Column="4" TextAlignment="Right" Text="{loc:Localized Positions.ColOpened}" />
                                <TextBlock Grid.Column="5" Text="{loc:Localized Positions.ActionsHeader}" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{loc:Localized Positions.NoPositions}"
                                   IsVisible="{Binding !HasPositions}" />
                        <ItemsControl ItemsSource="{Binding Positions}"
                                      IsVisible="{Binding HasPositions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PositionRowViewModel">
                                    <Border Classes="table-row">
                                        <Grid ColumnDefinitions="*,80,90,110,140,320">
                                            <TextBlock Grid.Column="0" Text="{Binding Symbol}" />
                                            <Border Grid.Column="1"
                                                    Classes="chip"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Classes.buy="{Binding IsBuySide}"
                                                    Classes.sell="{Binding IsSellSide}">
                                                <TextBlock Text="{Binding Side}" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Quantity}" FontFamily="{StaticResource NumericFont}" TextAlignment="Right" />
                                            <TextBlock Grid.Column="3" Text="{Binding EntryPrice}" FontFamily="{StaticResource NumericFont}" TextAlignment="Right" />
                                            <TextBlock Grid.Column="4" Text="{Binding Opened}" FontFamily="{StaticResource NumericFont}" TextAlignment="Right" />
                                            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                                                <TextBox Width="76"
                                                         FontFamily="{StaticResource NumericFont}"
                                                         Text="{Binding ReduceQuantityInput}"
                                                         PlaceholderText="{loc:Localized Positions.ReduceWatermark}" />
                                                <Button Classes="row-action secondary"
                                                        Content="{loc:Localized Positions.ActionReduce}"
                                                        Command="{Binding ReduceCommand}" />
                                                <Button Classes="row-action"
                                                        Content="{loc:Localized Positions.ActionClose}"
                                                        Command="{Binding CloseCommand}" />
                                                <Button Classes="row-action destructive"
                                                        Content="{loc:Localized Positions.ActionReverse}"
                                                        Command="{Binding ReverseCommand}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Open orders -->
            <TabItem Header="{loc:Localized Positions.TabOpenOrders}">
                <ScrollViewer>
                    <!-- The table stack ends a strip short of the overlay
                         bar's right edge (T-170): the row actions must not
                         sit under it. -->
                    <StackPanel Spacing="{StaticResource SpaceS}" Margin="0,0,16,0">
                        <!-- Bulk action (T-076): cancel every working order on the
                             workspace's active symbol; the panel gates it by the
                             idle state and the non-empty section. -->
                        <Button Classes="row-action"
                                Content="{loc:Localized Positions.ActionBulkCancel}"
                                Command="{Binding CancelAllCommand}"
                                MinWidth="90" HorizontalAlignment="Left" />
                        <Border Classes="table-header-row"
                                IsVisible="{Binding HasOpenOrders}">
                            <Grid ColumnDefinitions="*,80,90,110,120,140,150">
                                <TextBlock Grid.Column="0" Text="{loc:Localized Positions.Symbol}" />
                                <TextBlock Grid.Column="1" Text="{loc:Localized Positions.Side}" />
                                <TextBlock Grid.Column="2" TextAlignment="Right" Text="{loc:Localized Positions.ColQuantity}" />
                                <TextBlock Grid.Column="3" TextAlignment="Right" Text="{loc:Localized Positions.ColPrice}" />
                                <TextBlock Grid.Column="4" Text="{loc:Localized Positions.ColStatus}" />
                                <TextBlock Grid.Column="5" TextAlignment="Right" Text="{loc:Localized Positions.ColOpened}" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{loc:Localized Positions.NoOpenOrders}"
                                   IsVisible="{Binding !HasOpenOrders}" />
                        <ItemsControl ItemsSource="{Binding OpenOrders}"
                                      IsVisible="{Binding HasOpenOrders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:OrderRowViewModel">
                                    <Border Classes="table-row">
                                        <Grid ColumnDefinitions="*,80,90,110,120,140,150">
                                            <TextBlock Grid.Column="0" Text="{Binding Symbol}" />
                                            <Border Grid.Column="1"
                                                    Classes="chip"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Classes.buy="{Binding IsBuySide}"
                                                    Classes.sell="{Binding IsSellSide}">
                                                <TextBlock Text="{Binding Side}" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Quantity}" FontFamily="{StaticResource NumericFont}" TextAlignment="Right" />
                                            <TextBlock Grid.Column="3" Text="{Binding Price}" FontFamily="{StaticResource NumericFont}" TextAlignment="Right" />
                                            <!-- Status: the plain status, or the amending
                                                 marker while this row's amend is in flight -->
                                            <Grid Grid.Column="4">
                                                <TextBlock Text="{Binding Status}" IsVisible="{Binding !IsAmending}" />
                                                <TextBlock Text="{loc:Localized Positions.AmendRowStatus}"
                                                           IsVisible="{Binding IsAmending}" />
                                            </Grid>
                                            <TextBlock Grid.Column="5" Text="{Binding Opened}" FontFamily="{StaticResource NumericFont}" TextAlignment="Right" />
                                            <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                                                <Button Classes="row-action secondary"
                                                        Content="{loc:Localized Positions.Amend}"
                                                        Command="{Binding AmendCommand}"
                                                        IsVisible="{Binding IsAmendable}" />
                                                <Button Classes="row-action"
                                                        Content="{loc:Localized Positions.CancelCurrentPosition}"
                                                        Command="{Binding CancelCommand}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Orders placed this session (from the session order journal) -->
            <TabItem Header="{loc:Localized Positions.TabRecent}">
                <ScrollViewer>
                    <!-- The table stack ends a strip short of the overlay
                         bar's right edge (T-170): the row actions must not
                         sit under it. -->
                    <StackPanel Spacing="{StaticResource SpaceS}" Margin="0,0,16,0">
                        <Border Classes="table-header-row"
                                IsVisible="{Binding HasRecentOrders}">
                            <Grid ColumnDefinitions="*,80,90,110,120,140,90,150">
                                <TextBlock Grid.Column="0" Text="{loc:Localized Positions.Symbol}" />
                                <TextBlock Grid.Column="1" Text="{loc:Localized Positions.Side}" />
                                <TextBlock Grid.Column="2" TextAlignment="Right" Text="{loc:Localized Positions.ColQuantity}" />
                                <TextBlock Grid.Column="3" TextAlignment="Right" Text="{loc:Localized Positions.ColPrice}" />
                                <TextBlock Grid.Column="4" Text="{loc:Localized Positions.ColStatus}" />
                                <TextBlock Grid.Column="5" TextAlignment="Right" Text="{loc:Localized Positions.ColOpened}" />
                                <TextBlock Grid.Column="6" TextAlignment="Right" Text="{loc:Localized Fees.ColumnTitle}" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{loc:Localized Positions.NoRecent}"
                                   IsVisible="{Binding !HasRecentOrders}" />
                        <ItemsControl ItemsSource="{Binding RecentOrders}"
                                      IsVisible="{Binding HasRecentOrders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:OrderRowViewModel">
                                    <Border Classes="table-row">
                                        <Grid ColumnDefinitions="*,80,90,110,120,140,90,150">
                                            <TextBlock Grid.Column="0" Text="{Binding Symbol}" />
                                            <Border Grid.Column="1"
                                                    Classes="chip"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Classes.buy="{Binding IsBuySide}"
                                                    Classes.sell="{Binding IsSellSide}">
                                                <TextBlock Text="{Binding Side}" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Quantity}" FontFamily="{StaticResource NumericFont}" TextAlignment="Right" />
                                            <TextBlock Grid.Column="3" Text="{Binding Price}" FontFamily="{StaticResource NumericFont}" TextAlignment="Right" />
                                            <!-- Status: the plain status, or the amending
                                                 marker while this row's amend is in flight -->
                                            <Grid Grid.Column="4">
                                                <TextBlock Text="{Binding Status}" IsVisible="{Binding !IsAmending}" />
                                                <TextBlock Text="{loc:Localized Positions.AmendRowStatus}"
                                                           IsVisible="{Binding IsAmending}" />
                                            </Grid>
                                            <TextBlock Grid.Column="5" Text="{Binding Opened}" FontFamily="{StaticResource NumericFont}" TextAlignment="Right" />
                                            <TextBlock Grid.Column="6" Text="{Binding Fee}" FontFamily="{StaticResource NumericFont}" TextAlignment="Right" />
                                            <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                                                <Button Classes="row-action secondary"
                                                        Content="{loc:Localized Positions.Amend}"
                                                        Command="{Binding AmendCommand}"
                                                        IsVisible="{Binding IsAmendable}" />
                                                <Button Classes="row-action"
                                                        Content="{loc:Localized Positions.CancelCurrentPosition}"
                                                        Command="{Binding CancelCommand}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <StackPanel Grid.Row="2" Spacing="{StaticResource SpaceXs}">
            <!-- Flow errors (load failure, cancel/amend failure) -->
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource Error}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasErrorMessage}" />
            <!-- Last successful cancellation or amend outcome -->
            <TextBlock Text="{Binding ResultMessage}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasResultMessage}" />
        </StackPanel>

        <Button Grid.Row="3"
                Content="{loc:Localized Positions.Close}"
                Click="OnCloseClick"
                MinWidth="90"
                HorizontalAlignment="Right" />

    </Grid>
</Window>
