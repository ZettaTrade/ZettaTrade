<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ZettaTrade.App.ViewModels"
        xmlns:loc="using:Livery.Localization"
        xmlns:charting="using:ZettaTrade.UI.Charting"
        x:Class="ZettaTrade.App.Views.TradeStatsWindow"
        Classes="chrome"
        Icon="/Assets/ZettaTrade.ico"
        x:DataType="vm:TradeStatsViewModel"
        Title="{loc:Localized Stats.Title}"
        Width="1000" Height="640"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False"
        Background="{DynamicResource Background}">

    <Window.Styles>
        <!-- T-211: the realized-trades table rides the shared RowGrammar
             dictionary (the emphasized header row, the hairline rows, the
             side chips' state fills, the row-action buttons) - the same
             scaffold the history window speaks. -->
        <StyleInclude Source="avares://ZettaTrade.App/Themes/RowGrammar.axaml" />

        <!-- The PnL cell tints by the realized sign (the candle state
             colors, the screener-change pattern); a flat close keeps the
             plain ink. -->
        <Style Selector="TextBlock.pnl-cell.win">
            <Setter Property="Foreground" Value="{DynamicResource CandleUp}" />
        </Style>
        <Style Selector="TextBlock.pnl-cell.loss">
            <Setter Property="Foreground" Value="{DynamicResource CandleDown}" />
        </Style>
    </Window.Styles>

    <Grid Margin="{StaticResource InsetL}" RowDefinitions="Auto,*,Auto,Auto,Auto" RowSpacing="{StaticResource SpaceM}">

        <!-- Filters: text fields, the paper-live tag, the date range and the tag lane -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" >
            <WrapPanel Grid.Column="1">
                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="{loc:Localized Stats.FilterSymbol}" Margin="0,0,0,4" />
                    <TextBox Width="120" Text="{Binding SymbolFilterText}"
                             PlaceholderText="{loc:Localized Stats.FilterSymbolHint}" />
                </StackPanel>
                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="{loc:Localized Stats.FilterExchange}" Margin="0,0,0,4" />
                    <TextBox Width="130" Text="{Binding ExchangeFilterText}"
                             PlaceholderText="{loc:Localized Stats.FilterExchangeAny}" />
                </StackPanel>
                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="{loc:Localized Stats.FilterVenue}" Margin="0,0,0,4" />
                    <ComboBox Width="150" SelectedIndex="{Binding VenueIndex}">
                        <ComboBoxItem Content="{loc:Localized Stats.VenueAll}" />
                        <ComboBoxItem Content="{loc:Localized Stats.VenuePaper}" />
                        <ComboBoxItem Content="{loc:Localized Stats.VenueLive}" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="{loc:Localized Stats.FilterFrom}" Margin="0,0,0,4" />
                    <DatePicker Width="165" SelectedDate="{Binding FromDate}" />
                </StackPanel>
                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="{loc:Localized Stats.FilterTo}" Margin="0,0,0,4" />
                    <DatePicker Width="165" SelectedDate="{Binding ToDate}" />
                </StackPanel>
                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="{loc:Localized Stats.FilterTag}" Margin="0,0,0,4" />
                    <TextBox Width="120" Text="{Binding TagLaneFilterText}"
                             AutomationProperties.AutomationId="StatsTagLaneInput"
                             PlaceholderText="{loc:Localized Stats.FilterTagHint}" />
                </StackPanel>
                <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                    <Button Content="{loc:Localized Stats.ExportPositions}"
                            Command="{Binding ExportPositionsCommand}"
                            MinWidth="90" />
                    <Button Content="{loc:Localized Stats.ExportStatement}"
                            Command="{Binding ExportStatementCommand}"
                            MinWidth="90" />
                    <Button Content="{loc:Localized Stats.Apply}"
                            Classes="primary"
                            Command="{Binding ApplyCommand}"
                            MinWidth="90" />
                </StackPanel>
            </WrapPanel>

        </Grid>

        <!-- Stats + equity area: the tiles stand over the chart; both honest
             zero/dash baselines while nothing is scanned yet. -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource SpaceS}">
            <UniformGrid Grid.Row="0" Columns="5" Rows="2" Margin="0,4,0,0">
                <StackPanel Spacing="{StaticResource SpaceXs}" Margin="0,0,8,4">
                    <TextBlock Text="{loc:Localized Stats.Trades}" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Text="{Binding TradesText}" FontFamily="{StaticResource NumericFont}" FontSize="{StaticResource TitleFontSize}" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Spacing="{StaticResource SpaceXs}" Margin="0,0,8,4">
                    <TextBlock Text="{loc:Localized Stats.Wins}" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Text="{Binding WinsText}" FontFamily="{StaticResource NumericFont}" FontSize="{StaticResource TitleFontSize}" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Spacing="{StaticResource SpaceXs}" Margin="0,0,8,4">
                    <TextBlock Text="{loc:Localized Stats.Losses}" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Text="{Binding LossesText}" FontFamily="{StaticResource NumericFont}" FontSize="{StaticResource TitleFontSize}" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Spacing="{StaticResource SpaceXs}" Margin="0,0,8,4">
                    <TextBlock Text="{loc:Localized Stats.WinRate}" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Text="{Binding WinRateText}" FontFamily="{StaticResource NumericFont}" FontSize="{StaticResource TitleFontSize}" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Spacing="{StaticResource SpaceXs}" Margin="0,0,8,4">
                    <TextBlock Text="{loc:Localized Stats.ProfitFactor}" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Text="{Binding ProfitFactorText}" FontFamily="{StaticResource NumericFont}" FontSize="{StaticResource TitleFontSize}" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Spacing="{StaticResource SpaceXs}" Margin="0,0,8,4">
                    <TextBlock Text="{loc:Localized Stats.AverageWinner}" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Text="{Binding AverageWinnerText}" FontFamily="{StaticResource NumericFont}" FontSize="{StaticResource TitleFontSize}" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Spacing="{StaticResource SpaceXs}" Margin="0,0,8,4">
                    <TextBlock Text="{loc:Localized Stats.AverageLoser}" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Text="{Binding AverageLoserText}" FontFamily="{StaticResource NumericFont}" FontSize="{StaticResource TitleFontSize}" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Spacing="{StaticResource SpaceXs}" Margin="0,0,8,4">
                    <TextBlock Text="{loc:Localized Stats.MaxDrawdown}" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Text="{Binding MaxDrawdownText}" FontFamily="{StaticResource NumericFont}" FontSize="{StaticResource TitleFontSize}" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Spacing="{StaticResource SpaceXs}" Margin="0,0,8,4">
                    <TextBlock Text="{loc:Localized Stats.Realized}" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Text="{Binding RealizedText}" FontFamily="{StaticResource NumericFont}" FontSize="{StaticResource TitleFontSize}" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Spacing="{StaticResource SpaceXs}" Margin="0,0,8,4">
                    <TextBlock Text="{loc:Localized Stats.Volume}" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Text="{Binding VolumeText}" FontFamily="{StaticResource NumericFont}" FontSize="{StaticResource TitleFontSize}" FontWeight="SemiBold" />
                </StackPanel>
            </UniformGrid>

            <!-- The equity curve: the Skia area over the cumulative realized PnL -->
            <charting:EquityCurveChart Grid.Row="1"
                                       AutomationProperties.Name="{loc:Localized Stats.A11yEquity}"
                                       Points="{Binding EquityPoints}"
                                       IsVisible="{Binding HasTrades}" />

            <!-- The honest empty state: no fabricated success numbers -->
            <TextBlock Grid.Row="1"
                       Text="{loc:Localized Stats.Empty}"
                       IsVisible="{Binding !HasTrades}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
        </Grid>

        <!-- The realized trades (T-211): every booked close with its journal
             annotations, a per-row edit affordance over the shared dialog.
             Bounded height: the table scrolls, the tiles and the curve keep
             the window's primary space. -->
        <StackPanel Grid.Row="2" Spacing="{StaticResource SpaceXs}">
            <TextBlock Text="{loc:Localized Stats.RealizedTitle}"
                       Foreground="{DynamicResource TextSecondary}" />
            <Border Classes="table-header-row" IsVisible="{Binding HasRealizedRows}">
                <Grid ColumnDefinitions="130,80,90,60,80,80,80,90,*,*,70">
                    <TextBlock Grid.Column="0" TextAlignment="Right" Text="{loc:Localized Stats.ColClosed}" />
                    <TextBlock Grid.Column="1" Text="{loc:Localized Stats.ColExchange}" />
                    <TextBlock Grid.Column="2" Text="{loc:Localized Stats.ColSymbol}" />
                    <TextBlock Grid.Column="3" Text="{loc:Localized Stats.ColSide}" />
                    <TextBlock Grid.Column="4" TextAlignment="Right" Text="{loc:Localized Stats.ColQuantity}" />
                    <TextBlock Grid.Column="5" TextAlignment="Right" Text="{loc:Localized Stats.ColEntry}" />
                    <TextBlock Grid.Column="6" TextAlignment="Right" Text="{loc:Localized Stats.ColExit}" />
                    <TextBlock Grid.Column="7" TextAlignment="Right" Text="{loc:Localized Stats.ColPnl}" />
                    <TextBlock Grid.Column="8" Text="{loc:Localized Stats.ColNote}" />
                    <TextBlock Grid.Column="9" Text="{loc:Localized Stats.ColTags}" />
                    <TextBlock Grid.Column="10" />
                </Grid>
            </Border>
            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding RealizedRows}"
                                  IsVisible="{Binding HasRealizedRows}"
                                  AutomationProperties.Name="{loc:Localized Stats.A11yRealized}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TradeRealizedRowViewModel">
                                <Border Classes="table-row">
                                    <Grid ColumnDefinitions="130,80,90,60,80,80,80,90,*,*,70">
                                        <TextBlock Grid.Column="0" Text="{Binding ClosedAt}" FontFamily="{StaticResource NumericFont}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="1" Text="{Binding Exchange}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Symbol}" />
                                        <Border Grid.Column="3"
                                                Classes="chip"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Classes.buy="{Binding IsBuySide}"
                                                Classes.sell="{Binding IsSellSide}">
                                            <TextBlock Text="{Binding Side}" />
                                        </Border>
                                        <TextBlock Grid.Column="4" Text="{Binding Quantity}" FontFamily="{StaticResource NumericFont}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="5" Text="{Binding EntryPrice}" FontFamily="{StaticResource NumericFont}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="6" Text="{Binding ExitPrice}" FontFamily="{StaticResource NumericFont}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="7" Text="{Binding Pnl}" FontFamily="{StaticResource NumericFont}" TextAlignment="Right"
                                                   Classes="pnl-cell"
                                                   Classes.win="{Binding IsWinning}"
                                                   Classes.loss="{Binding IsLosing}" />
                                        <TextBlock Grid.Column="8" Text="{Binding Note}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="9" Text="{Binding Tags}" TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="10"
                                                Classes="row-action secondary"
                                                Content="{loc:Localized Stats.EditTrade}"
                                                AutomationProperties.AutomationId="StatsEditTradeButton"
                                                Command="{Binding $parent[Window].((vm:TradeStatsViewModel)DataContext).EditRealizedRowCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- The honest empty state: no trades booked under the scope yet -->
                    <TextBlock Text="{loc:Localized Stats.Empty}"
                               IsVisible="{Binding !HasRealizedRows}" />
                </StackPanel>
            </ScrollViewer>
        </StackPanel>

        <!-- Progress / failure -->
        <StackPanel Grid.Row="3" Spacing="{StaticResource SpaceXs}">
            <TextBlock Text="{Binding ScanStateText}"
                       IsVisible="{Binding ScanStateText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource Error}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasErrorMessage}" />
        </StackPanel>

        <Button Grid.Row="4"
                Content="{loc:Localized Stats.Close}"
                Click="OnCloseClick"
                MinWidth="90"
                HorizontalAlignment="Right" />

    </Grid>
</Window>
