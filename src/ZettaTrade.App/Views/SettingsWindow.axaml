<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:ZettaTrade.Core.Interfaces"
        xmlns:media="using:Avalonia.Media"
        xmlns:themes="using:ZettaTrade.UI.Themes"
        xmlns:vm="using:ZettaTrade.App.ViewModels"
        xmlns:loc="using:ZettaTrade.UI.Localization"
        x:Class="ZettaTrade.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{loc:Localized Settings.Title}"
        Width="560" Height="640"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource SystemControlPageBackgroundAltHighBrush}">

    <!-- A fixed window: switching tabs must never resize the dialog, and
         Save/Close must never travel out of sight — the buttons ride a
         pinned bottom row while the tab area owns the rest. Nothing scrolls
         the dialog itself: each long list scrolls inside its own viewport
         (the theme-error list and both pairs lists carry their own
         scrollbars). -->
    <Window.Styles>
        <!-- The row star: dim while the pair is unmarked, gold once the
             star pins the pair to the list head (a plain Button has no
             checked state of its own, so the state rides a class). -->
        <Style Selector="Button.pair-star">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
        </Style>
        <Style Selector="Button.pair-star.on">
            <Setter Property="Foreground" Value="{DynamicResource Highlight}"/>
        </Style>
    </Window.Styles>

    <Grid Margin="20" RowDefinitions="*,Auto" RowSpacing="16">
        <!-- The settings sections live on tabs (MCP, notifications grow into
             further items, and one flat list would not scale). Each tab's
             content root carries a top margin - the breathing room between
             the tab strip and the section (the theme default hugs the strip,
             and TabControl.Padding does not reach the content). -->
        <TabControl Grid.Row="0">
            <TabItem Header="{loc:Localized Settings.Tab.Appearance}">
                <StackPanel Spacing="16" Margin="0,12,0,0">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="{loc:Localized Settings.Theme}"
                                   VerticalAlignment="Center" />
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{Binding AvailableThemes}"
                                  SelectedIndex="{Binding SelectedThemeIndex}"
                                  MinWidth="220"
                                  HorizontalAlignment="Left">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="core:ThemeInfo">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding DisplayName}"
                                                   VerticalAlignment="Center" />
                                        <!-- Preview motif from the theme file's previewColors;
                                             skipped hex values and an empty list render no
                                             strip (converter drops unparseable entries). -->
                                        <ItemsControl Grid.Column="1"
                                                      VerticalAlignment="Center"
                                                      ItemsSource="{Binding PreviewColors, Converter={x:Static themes:PreviewColorsToBrushesConverter.Instance}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="3" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="media:ISolidColorBrush">
                                                    <Border Width="10"
                                                            Height="10"
                                                            CornerRadius="2"
                                                            Background="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="{loc:Localized Settings.Language}"
                                   VerticalAlignment="Center" />
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  ItemsSource="{Binding AvailableLanguages}"
                                  SelectedIndex="{Binding SelectedLanguageIndex}"
                                  MinWidth="220"
                                  HorizontalAlignment="Left">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="core:LanguageInfo">
                                    <TextBlock Text="{Binding NativeName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- The chart clock format: the option rows print the localized
                             labels directly (static strings stay out of the ViewModel);
                             the index is the only state crossing the binding. -->
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="{loc:Localized Chart.TimeFormat}"
                                   VerticalAlignment="Center" />
                        <ComboBox Grid.Row="2" Grid.Column="1"
                                  SelectedIndex="{Binding SelectedTimeFormatIndex}"
                                  MinWidth="220"
                                  HorizontalAlignment="Left">
                            <ComboBoxItem Content="{loc:Localized Chart.TimeFormat.Hours24}" />
                            <ComboBoxItem Content="{loc:Localized Chart.TimeFormat.Hours12}" />
                        </ComboBox>
                    </Grid>

                    <!-- Theme folder and schema hint: customization is file-based, so the
                         button hands the folder over to the OS file manager. -->
                    <StackPanel Spacing="10">
                        <Button Content="{loc:Localized Settings.ThemesFolder.Open}"
                                Command="{Binding OpenThemesFolderCommand}"
                                MinWidth="160"
                                HorizontalAlignment="Left" />
                        <TextBlock Text="{loc:Localized Settings.ThemeErrors.Hint}"
                                   TextWrapping="Wrap"
                                   FontSize="12" />
                    </StackPanel>

                    <!-- Broken theme files (theme files that failed to parse): hidden
                         while every file loads. The list can grow with the broken
                         files' count — it scrolls its own viewport, the bottom row
                         stays pinned. -->
                    <StackPanel IsVisible="{Binding HasThemeFileErrors}" Spacing="6">
                        <TextBlock Text="{loc:Localized Settings.ThemeErrors.Header}"
                                   FontWeight="Bold" />
                        <ScrollViewer MaxHeight="160">
                            <ItemsControl ItemsSource="{Binding ThemeFileErrors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="themes:ThemeFileLoadError">
                                        <TextBlock Text="{Binding FileName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding FilePath}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="{loc:Localized Settings.Tab.Indicators}">
                <!-- The indicator overlay rows: the SMA row today, future rows
                     land here one grid row each. -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" RowDefinitions="Auto" RowSpacing="10" Margin="0,12,0,0">
                    <!-- "SMA" is the plugin's canonical name - a product name, not a
                         localized string; the row label and the period caption are. -->
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="{loc:Localized Chart.Indicators}"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                        <CheckBox Content="SMA"
                                  IsChecked="{Binding IsSmaEnabled}"
                                  VerticalAlignment="Center" />
                        <!-- The info affordance: the tooltip lives HERE, not on the
                             checkbox, so the icon itself signals that an explanation
                             is available. The text wraps so a long translation stays
                             readable. -->
                        <Border Width="16" Height="16"
                                CornerRadius="8"
                                Background="Transparent"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                VerticalAlignment="Center">
                            <ToolTip.Tip>
                                <TextBlock MaxWidth="260"
                                           Text="{loc:Localized Chart.Indicators.SmaTip}"
                                           TextWrapping="Wrap" />
                            </ToolTip.Tip>
                            <TextBlock Text="i"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{loc:Localized Chart.Indicators.Period}"
                                   VerticalAlignment="Center" />
                        <TextBox Text="{Binding SmaPeriodText}"
                                 MinWidth="64"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="{loc:Localized Settings.Tab.Pairs}">
                <!-- Both workspace marks live here: the classic two-list
                     dialog shape — the left list holds the workspace
                     exchange's all pairs with a star button on every row
                     (a starred pair pins to the list head and never hides
                     until unstarred), the right one the hidden names, and
                     the move buttons sit in the center column: '>' hides
                     the picked (unstarred) pair, '<' brings it back. Each
                     list fills the tab's height and scrolls its own rows
                     (one scrollbar per list). Everything lands in the
                     draft; Save applies and persists it. The modal window
                     cannot race an exchange switch, so the lists are
                     rebuilt per open for the exchange behind the
                     workspace. -->
                <Grid RowDefinitions="*,Auto" RowSpacing="10" Margin="0,12,0,0">
                    <Grid Grid.Row="0"
                          ColumnDefinitions="*,Auto,*"
                          ColumnSpacing="12"
                          RowDefinitions="Auto,*"
                          RowSpacing="10">
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="{loc:Localized Settings.Pairs.All}" />
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="{loc:Localized Settings.Pairs.Hidden}" />
                        <ListBox Grid.Row="1" Grid.Column="0"
                                 ItemsSource="{Binding AllPairs}"
                                 SelectedItem="{Binding SelectedAllPair}">
                            <ListBox.ItemTemplate>
                                <!-- One row: the pair name with the star button
                                     on the right. The row record carries the
                                     star state (rebuilt on every draft move),
                                     so the template binds within its own data
                                     type; the window's DataContext supplies the
                                     toggle command. -->
                                <DataTemplate x:DataType="vm:PairRow">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="1"
                                                Content="★"
                                                FontSize="14"
                                                Padding="6,2"
                                                MinWidth="28"
                                                VerticalAlignment="Center"
                                                Margin="0,-2,0,-2"
                                                Classes="pair-star"
                                                Classes.on="{Binding IsFavorite}"
                                                ToolTip.Tip="{loc:Localized Settings.Pairs.Star}"
                                                AutomationProperties.Name="{loc:Localized Settings.Pairs.Star}"
                                                CommandParameter="{Binding}"
                                                Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).TogglePairFavoriteCommand}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <ListBox Grid.Row="1" Grid.Column="2"
                                 ItemsSource="{Binding HiddenPairs}"
                                 SelectedItem="{Binding SelectedHiddenPair}" />
                        <StackPanel Grid.Row="1" Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                            <!-- The caption glyphs carry the flow direction; the
                                 readable captions ride the automation name and
                                 the tooltip (assistive tech and hover alike). -->
                            <Button Width="34" Padding="0"
                                    Content=">"
                                    ToolTip.Tip="{loc:Localized Settings.Pairs.Hide}"
                                    AutomationProperties.Name="{loc:Localized Settings.Pairs.Hide}"
                                    Command="{Binding HidePairCommand}" />
                            <Button Width="34" Padding="0"
                                    Content="&lt;"
                                    ToolTip.Tip="{loc:Localized Settings.Pairs.Reveal}"
                                    AutomationProperties.Name="{loc:Localized Settings.Pairs.Reveal}"
                                    Command="{Binding RevealPairCommand}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="1"
                               Text="{loc:Localized Settings.Pairs.Hint}"
                               TextWrapping="Wrap"
                               FontSize="12" />
                </Grid>
            </TabItem>
        </TabControl>

        <!-- The dialog's bottom row: pinned outside the tab area, never
             scrolled away. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button x:Name="SaveButton"
                    Content="{loc:Localized Settings.Save}"
                    MinWidth="90"
                    Click="OnSaveClick" />
            <Button x:Name="CloseButton"
                    Content="{loc:Localized Settings.Close}"
                    MinWidth="90"
                    Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
