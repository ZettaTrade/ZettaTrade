<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:media="using:Avalonia.Media"
        xmlns:services="using:ZettaTrade.App.Services"
        xmlns:themes="using:Livery.Themes"
        xmlns:views="using:ZettaTrade.App.Views"
        xmlns:vm="using:ZettaTrade.App.ViewModels"
        xmlns:loc="using:Livery.Localization"
        xmlns:livery="using:Livery.Controls"
        x:Class="ZettaTrade.App.Views.SettingsWindow"
        Classes="chrome-compact"
        AutomationProperties.AutomationId="SettingsWindow"
        Icon="/Assets/ZettaTrade.ico"
        x:DataType="vm:SettingsViewModel"
        Title="{loc:Localized Settings.Title}"
        Width="880" Height="640"
        MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False"
        Background="{DynamicResource Background}">

    <!-- A bigger, resizable window (T-145; the category rail T-184): the
         approved variant A shape — the four categories ride a left rail and
         the sections read as cards, so the window grows wider (the rail
         consumes 190 px on the left) while every page still fits without
         the whole-body scroll (the long lists keep their own scrollports).
         Save/Close must never travel out of sight — the buttons ride a
         pinned bottom row while the tab area owns the rest. Nothing scrolls
         the dialog itself: each long list scrolls inside its own viewport
         (the theme-error list, the MCP client cards and the two pairs lists
         carry their own scrollbars); the merged tabs keep a body scroll
         only as the small machines' safety net — at the shipped default
         size every page fits (the headless bounds pin). -->
    <Window.Styles>
        <!-- The category rail (T-184): the retired top tab strip re-lays on
             the left, the four TabItems become the rail items. The rest is
             transparent over the window ground, the pointer answers with
             the kit's soft tint (the T-183 vocabulary — never a solid flash),
             the selected item holds the tint and carries the 3 px Accent
             tick (the theme's own left-pipe part, re-shaped), and the
             keyboard focus rides the Highlight ring. The arrow keys walk
             the rail and the selection follows the directional focus (the
             TabItem/TabControl focus-selection contract), so the rail is
             reachable and operable without a mouse. -->
        <Style Selector="TabControl.rail">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="TabItem.rail-item">
            <Setter Property="Width" Value="174" />
            <Setter Property="Margin" Value="8,12,8,0" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerM}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <!-- The caption's type (T-223): the Fluent template's own tab
                 header size would win otherwise (the header compositions set
                 no FontSize) — the mockup's rail type is the BodyFontSize
                 step, and the header's TextBlock inherits it. -->
            <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        </Style>
        <Style Selector="TabItem.rail-item /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TabItem.rail-item:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource ButtonHoverTint}" />
        </Style>
        <Style Selector="TabItem.rail-item:pressed /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource ButtonPressedTint}" />
        </Style>
        <Style Selector="TabItem.rail-item:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="TabItem.rail-item:selected">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="TabItem.rail-item:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource ButtonHoverTint}" />
        </Style>
        <Style Selector="TabItem.rail-item:focus /template/ Border#PART_LayoutRoot">
            <Setter Property="BorderBrush" Value="{DynamicResource Highlight}" />
        </Style>
        <!-- The selected item's tick: the theme's own left pipe re-shaped —
             3 px wide, the Accent fill, the rounded ends. The negative left
             margin cancels the item's own border (1 px) plus padding
             (12 px), so the mark opens the item box at its left edge (the
             mockup's ::before mark), not inside the padding inset the
             template's content panel carries (the T-222 probe measured the
             15 px offset the old margin left behind). -->
        <Style Selector="TabItem.rail-item[TabStripPlacement=Left] /template/ Border#PART_SelectedPipe">
            <Setter Property="Width" Value="3" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="-13,0,0,0" />
            <Setter Property="CornerRadius" Value="1.5" />
            <Setter Property="Background" Value="{DynamicResource Accent}" />
        </Style>

        <!-- The section cards (T-184): the shared panel shape the pages'
             sections consume — ship once in the App themes, every window
             that grows section panels rides the same dictionary. -->
        <StyleInclude Source="avares://ZettaTrade.App/Themes/SectionCards.axaml" />

        <!-- The row star: dim while the pair is unmarked, gold once the
             star pins the pair to the list head (a plain Button has no
             checked state of its own, so the state rides a class). -->
        <Style Selector="Button.pair-star">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>
        <!-- T-181: the explicit interaction siblings (the window-scoped
             Transparent background defeats the generic hover/pressed, so
             the quiet star answers the pointer itself): the glyph
             brightens to the primary text ink on hover and holds it
             through the press (the copy-pin's quiet-control language);
             the armed state stays gold — its block rides after, so the
             pinned star never greys under the pointer. -->
        <Style Selector="Button.pair-star:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="Button.pair-star:pressed">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="Button.pair-star.on">
            <Setter Property="Foreground" Value="{DynamicResource Highlight}"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto">
        <!-- The settings live on the left category rail (T-184): the four
             retired tab captions are the rail items (title case, the tab
             keys unchanged), the rail's width and the selected item's tint
             and tick ride the window styles. Each page lays its sections
             out as cards (the SectionCards dictionary), the content root
             carries the page inset — the breathing room beside the rail.
             The window's own frame stays flush: the rail strip touches the
             left edge and the footer strip touches the bottom edge (the
             approved variant A frame, T-222). -->
        <Panel Grid.Row="0">
            <!-- The rail strip's approved chrome (T-222): the 190 px backing
                 rides the title-bar fill with its right hairline, and the
                 note speaks the categories' shape at its bottom. The strip's
                 own template root measured transparent (the T-222 probe),
                 so this backing shows through it; the note is hit-invisible
                 — the rail's clicks belong to the items. -->
            <Border x:Name="RailBacking"
                    Width="190"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource TitleBar}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="0,0,1,0">
                <TextBlock Text="{loc:Localized Settings.Rail.Note}"
                           VerticalAlignment="Bottom"
                           Margin="12,0,12,12"
                           FontSize="{StaticResource CaptionFontSize}"
                           Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"
                           IsHitTestVisible="False" />
            </Border>
            <TabControl Classes="rail" TabStripPlacement="Left" SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Classes="rail-item">
                <TabItem.Header>
                    <!-- The rail item: the 16 px stroke mark beside the caption
                         (the approved variant A icons, T-222). The icon strokes
                         ride the item's own foreground, so the selection's
                         re-ink reaches them; the appearance mark's paint stroke
                         keeps the Accent detail. The caption TextBlock keeps
                         the tab key — the localization facts and the tab
                         helpers read it. -->
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}" VerticalAlignment="Center">
                        <Grid Width="16" Height="16">
                            <Path Stroke="{Binding $parent[TabItem].Foreground}"
                                  StrokeThickness="1.5"
                                  Data="M 8 2 A 6 6 0 1 0 8 14 A 6 6 0 1 0 8 2" />
                            <Path Stroke="{DynamicResource Accent}"
                                  StrokeThickness="3"
                                  StrokeLineCap="Round"
                                  Data="M 8 2 L 8 8" />
                        </Grid>
                        <TextBlock Text="{loc:Localized Settings.Tab.Appearance}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <!-- The appearance page rides the body scroll only as the
                     small machines' safety net — at the default size the
                     three compact cards fit (the T-222 bounds pin). The
                     scroll content carries the page inset (the T-169 gutter
                     included on every side). -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="{StaticResource SpaceL}" Margin="{StaticResource InsetL}">

                        <!-- The appearance card: the theme pick (with the
                             preview swatches), the language and the chart
                             clock format — the approved appearance section. -->
                        <Border Classes="section-card">
                            <StackPanel Spacing="{StaticResource SpaceM}">
                                <!-- The section toggle (T-223): the header folds
                                     the card's body; the binding is one-way and
                                     the IsChecked explicit, so no null state
                                     exists. -->
                                <ToggleButton x:Name="AppearanceSectionToggle"
                                              Classes="section-toggle"
                                              IsChecked="True"
                                              AutomationProperties.AutomationId="AppearanceSectionToggle">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                                            <Border Classes="section-tick" />
                                            <TextBlock Classes="section-header"
                                                       Text="{loc:Localized Settings.Section.Appearance}" />
                                        </StackPanel>
                                        <Path Classes="section-chevron" Grid.Column="1" />
                                    </Grid>
                                </ToggleButton>
                                <StackPanel x:Name="AppearanceSectionBody"
                                            Spacing="{StaticResource SpaceM}"
                                            IsVisible="{Binding #AppearanceSectionToggle.IsChecked}">

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceL}" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="{StaticResource SpaceM}">
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="{loc:Localized Settings.Theme}"
                                   VerticalAlignment="Center" />
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{Binding AvailableThemes}"
                                  SelectedIndex="{Binding SelectedThemeIndex}"
                                  MinWidth="220"
                                  HorizontalAlignment="Left">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="themes:ThemeInfo">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding DisplayName}"
                                                   VerticalAlignment="Center" />
                                        <!-- Preview motif from the theme file's previewColors;
                                             skipped hex values and an empty list render no
                                             strip (converter drops unparseable entries). -->
                                        <ItemsControl Grid.Column="1"
                                                      VerticalAlignment="Center"
                                                      ItemsSource="{Binding PreviewColors, Converter={x:Static themes:PreviewColorsToBrushesConverter.Instance}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="media:ISolidColorBrush">
                                                    <Border Width="10"
                                                            Height="10"
                                                            CornerRadius="2"
                                                            Background="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="{loc:Localized Settings.Language}"
                                   VerticalAlignment="Center" />
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  ItemsSource="{Binding AvailableLanguages}"
                                  SelectedIndex="{Binding SelectedLanguageIndex}"
                                  MinWidth="220"
                                  HorizontalAlignment="Left">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="loc:LanguageInfo">
                                    <TextBlock Text="{Binding NativeName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- The chart clock format: the option rows print the localized
                             labels directly (static strings stay out of the ViewModel);
                             the index is the only state crossing the binding. -->
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="{loc:Localized Chart.TimeFormat}"
                                   VerticalAlignment="Center" />
                        <ComboBox Grid.Row="2" Grid.Column="1"
                                  AutomationProperties.AutomationId="TimeFormatComboBox"
                                  SelectedIndex="{Binding SelectedTimeFormatIndex}"
                                  MinWidth="220"
                                  HorizontalAlignment="Left">
                            <ComboBoxItem Content="{loc:Localized Chart.TimeFormat.Hours24}"
                                          AutomationProperties.AutomationId="TimeFormatHours24Item" />
                            <ComboBoxItem Content="{loc:Localized Chart.TimeFormat.Hours12}"
                                          AutomationProperties.AutomationId="TimeFormatHours12Item" />
                        </ComboBox>

                        <!-- The update check (T-213): the app-level awareness
                             toggle rides the daily-use facts' card — the
                             T-184 no-scroll pin bounds this page (63 px of
                             slack at the default size), so a standalone
                             Application card would not fit. The hint rides
                             the checkbox's tooltip: the compact home's
                             price. The draft/save contract is the same as
                             every other selection here (only Save applies;
                             the checker's own change stream picks the flip
                             live). -->
                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Text="{loc:Localized Settings.UpdateCheck.Enable}"
                                   VerticalAlignment="Center" />
                        <CheckBox Grid.Row="3" Grid.Column="1"
                                  AutomationProperties.AutomationId="UpdateCheckEnabledCheckBox"
                                  IsChecked="{Binding IsUpdateCheckEnabled}"
                                  ToolTip.Tip="{loc:Localized Settings.UpdateCheck.Hint}"
                                  HorizontalAlignment="Left" />
                    </Grid>
                            </StackPanel>
                        </StackPanel>
                        </Border>

                        <!-- The theme folder card: customization is file-based, so
                             the button hands the folder over to the OS file
                             manager; broken theme files list right here (the
                             approved theme-folder section). -->
                        <Border Classes="section-card">
                            <StackPanel Spacing="{StaticResource SpaceM}">
                                <ToggleButton x:Name="ThemesFolderSectionToggle"
                                              Classes="section-toggle"
                                              IsChecked="False"
                                              AutomationProperties.AutomationId="ThemesFolderSectionToggle">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                                            <Border Classes="section-tick" />
                                            <TextBlock Classes="section-header"
                                                       Text="{loc:Localized Settings.Section.ThemesFolder}" />
                                        </StackPanel>
                                        <Path Classes="section-chevron" Grid.Column="1" />
                                    </Grid>
                                </ToggleButton>
                                <StackPanel x:Name="ThemesFolderSectionBody"
                                            Spacing="{StaticResource SpaceM}"
                                            IsVisible="{Binding #ThemesFolderSectionToggle.IsChecked}">

                                <Button Content="{loc:Localized Settings.ThemesFolder.Open}"
                                        Command="{Binding OpenThemesFolderCommand}"
                                        MinWidth="160"
                                        HorizontalAlignment="Left" />
                                <TextBlock Text="{loc:Localized Settings.ThemeErrors.Hint}"
                                           TextWrapping="Wrap"
                                           />

                                <!-- Broken theme files (theme files that failed to
                                     parse): hidden while every file loads. The list
                                     can grow with the broken files' count — it
                                     scrolls its own viewport, the bottom row stays
                                     pinned. -->
                                <StackPanel IsVisible="{Binding HasThemeFileErrors}" Spacing="{StaticResource SpaceXs}">
                                    <TextBlock Text="{loc:Localized Settings.ThemeErrors.Header}"
                                               FontWeight="Bold" />
                                    <ScrollViewer MaxHeight="160">
                                        <!-- The gutter rides the list too (T-169). -->
                                        <ItemsControl ItemsSource="{Binding ThemeFileErrors}"
                                                      Margin="0,0,16,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="themes:ThemeFileLoadError">
                                                    <TextBlock Text="{Binding FileName}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip.Tip="{Binding FilePath}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        </Border>

                        <!-- The first-run wizard card (T-099): the board names the
                             settings window as the only way back into the wizard.
                             Closing this window first and modally opening the
                             wizard over the owner keeps one modal at a time; the
                             entries are View behavior (window lifecycle), no
                             ViewModel state involved. -->
                        <Border Classes="section-card">
                            <StackPanel Spacing="{StaticResource SpaceM}">
                                <ToggleButton x:Name="WizardSectionToggle"
                                              Classes="section-toggle"
                                              IsChecked="False"
                                              AutomationProperties.AutomationId="WizardSectionToggle">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                                            <Border Classes="section-tick" />
                                            <TextBlock Classes="section-header"
                                                       Text="{loc:Localized Settings.Section.Wizard}" />
                                        </StackPanel>
                                        <Path Classes="section-chevron" Grid.Column="1" />
                                    </Grid>
                                </ToggleButton>
                                <StackPanel x:Name="WizardSectionBody"
                                            Spacing="{StaticResource SpaceM}"
                                            IsVisible="{Binding #WizardSectionToggle.IsChecked}">

                                <TextBlock Text="{loc:Localized Settings.FirstRunWizard.Hint}"
                                           TextWrapping="Wrap"
                                           />
                                <Button x:Name="FirstRunWizardButton"
                                        Content="{loc:Localized Settings.FirstRunWizard.RunAgain}"
                                        HorizontalAlignment="Left"
                                        MinWidth="160"
                                        Click="OnFirstRunWizardClick" />
                            </StackPanel>
                        </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Classes="rail-item">
                <TabItem.Header>
                    <!-- The rail item's mark: the stroke chart line beside the
                         caption; the caption keeps the tab key. -->
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}" VerticalAlignment="Center">
                        <Grid Width="16" Height="16">
                            <Path Stroke="{Binding $parent[TabItem].Foreground}"
                                  StrokeThickness="1.5"
                                  Data="M 1 12 L 5 7 L 8 10 L 12 4 L 15 8" />
                        </Grid>
                        <TextBlock Text="{loc:Localized Settings.Tab.Indicators}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <!-- The indicator page: one section card — the compact header
                     replaces the T-169 bare caption — and the body scroll rides
                     only as the small machines' safety net (the T-184 pin). -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="{StaticResource SpaceL}" Margin="{StaticResource InsetL}">
                        <Border Classes="section-card">
                            <StackPanel Spacing="{StaticResource SpaceM}">
                                <ToggleButton x:Name="IndicatorsSectionToggle"
                                              Classes="section-toggle"
                                              IsChecked="True"
                                              AutomationProperties.AutomationId="IndicatorsSectionToggle">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                                            <Border Classes="section-tick" />
                                            <TextBlock Classes="section-header"
                                                       Text="{loc:Localized Settings.Section.Indicators}" />
                                        </StackPanel>
                                        <Path Classes="section-chevron" Grid.Column="1" />
                                    </Grid>
                                </ToggleButton>
                                <StackPanel x:Name="IndicatorsSectionBody"
                                            Spacing="{StaticResource SpaceM}"
                                            IsVisible="{Binding #IndicatorsSectionToggle.IsChecked}">
                <!-- The indicator overlay rows: a row renders only for a plugin
                     the scanned catalog actually loaded (the surface reflects
                     the real catalog, it never assumes a shipped assembly);
                     with a whole empty catalog the honest empty state shows
                     instead. -->
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="{StaticResource SpaceM}">
                                    <!-- The card header speaks for the section (the T-169
                                         caption's line rides the compact header now); the rows keep
                                         the re-lay: a row renders only for a plugin the scanned
                                         catalog actually loaded (the surface reflects the real
                                         catalog, it never assumes a shipped assembly); with a whole
                                         empty catalog the honest empty state speaks for the zero. -->
                                    <!-- Every row is the SAME grid (T-169): a name column wide
                                         enough for the widest canonical name (MACD/BOLL), the
                                         info cue, one aligned Period caption column and one
                                         box width. The fixed columns hold the captions and
                                         the boxes on the same x per row - the ragged name
                                         widths no longer walk the controls. -->
                                                                    <Grid Grid.Row="0" IsVisible="{Binding IsSmaPluginLoaded}"
                                          ColumnDefinitions="80,Auto,64,64" ColumnSpacing="{StaticResource SpaceM}">
                                        <!-- "SMA" is the plugin's canonical name - a product name, not a
                                             localized string; the period caption is. -->
                                        <CheckBox Grid.Column="0"
                                                  Content="SMA"
                                                  IsChecked="{Binding IsSmaEnabled}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center" />
                                        <!-- The info affordance: the tooltip lives HERE, not on the
                                             checkbox, so the icon itself signals that an explanation
                                             is available. The text wraps so a long translation stays
                                             readable. -->
                                        <livery:InfoIcon Grid.Column="1"
                                                         VerticalAlignment="Center"
                                                         AutomationProperties.Name="{loc:Localized Chart.Indicators.A11ySmaInfo}">
                                            <ToolTip.Tip>
                                                <TextBlock MaxWidth="260"
                                                           Text="{loc:Localized Chart.Indicators.SmaTip}"
                                                           TextWrapping="Wrap" />
                                            </ToolTip.Tip>
                                        </livery:InfoIcon>
                                        <TextBlock Grid.Column="2"
                                                   Text="{loc:Localized Chart.Indicators.Period}"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Column="3"
                                                 Text="{Binding SmaPeriodText}"
                                                 VerticalAlignment="Center" />
                                    </Grid>
                                    <!-- The standard pack's rows (T-092): every one the exact
                                         contract the SMA row carries - a row renders only for
                                         a plugin the scanned catalog actually loaded, the
                                         checkbox is the enable draft, the period box is the
                                         plugin's single parameter knob, and the checkbox
                                         labels are the plugins' canonical names - product
                                         names, not localized strings. -->
                                                                    <Grid Grid.Row="1" IsVisible="{Binding IsEmaPluginLoaded}"
                                          ColumnDefinitions="80,Auto,64,64" ColumnSpacing="{StaticResource SpaceM}">
                                        <CheckBox Grid.Column="0"
                                                  Content="EMA"
                                                  IsChecked="{Binding IsEmaEnabled}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center" />
                                        <livery:InfoIcon Grid.Column="1"
                                                         VerticalAlignment="Center"
                                                         AutomationProperties.Name="{loc:Localized Chart.Indicators.A11yEmaInfo}">
                                            <ToolTip.Tip>
                                                <TextBlock MaxWidth="260"
                                                           Text="{loc:Localized Chart.Indicators.EmaTip}"
                                                           TextWrapping="Wrap" />
                                            </ToolTip.Tip>
                                        </livery:InfoIcon>
                                        <TextBlock Grid.Column="2"
                                                   Text="{loc:Localized Chart.Indicators.Period}"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Column="3"
                                                 Text="{Binding EmaPeriodText}"
                                                 VerticalAlignment="Center" />
                                    </Grid>
                                                                    <Grid Grid.Row="2" IsVisible="{Binding IsWmaPluginLoaded}"
                                          ColumnDefinitions="80,Auto,64,64" ColumnSpacing="{StaticResource SpaceM}">
                                        <CheckBox Grid.Column="0"
                                                  Content="WMA"
                                                  IsChecked="{Binding IsWmaEnabled}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center" />
                                        <livery:InfoIcon Grid.Column="1"
                                                         VerticalAlignment="Center"
                                                         AutomationProperties.Name="{loc:Localized Chart.Indicators.A11yWmaInfo}">
                                            <ToolTip.Tip>
                                                <TextBlock MaxWidth="260"
                                                           Text="{loc:Localized Chart.Indicators.WmaTip}"
                                                           TextWrapping="Wrap" />
                                            </ToolTip.Tip>
                                        </livery:InfoIcon>
                                        <TextBlock Grid.Column="2"
                                                   Text="{loc:Localized Chart.Indicators.Period}"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Column="3"
                                                 Text="{Binding WmaPeriodText}"
                                                 VerticalAlignment="Center" />
                                    </Grid>
                                                                    <Grid Grid.Row="3" IsVisible="{Binding IsRsiPluginLoaded}"
                                          ColumnDefinitions="80,Auto,64,64" ColumnSpacing="{StaticResource SpaceM}">
                                        <CheckBox Grid.Column="0"
                                                  Content="RSI"
                                                  IsChecked="{Binding IsRsiEnabled}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center" />
                                        <livery:InfoIcon Grid.Column="1"
                                                         VerticalAlignment="Center"
                                                         AutomationProperties.Name="{loc:Localized Chart.Indicators.A11yRsiInfo}">
                                            <ToolTip.Tip>
                                                <TextBlock MaxWidth="260"
                                                           Text="{loc:Localized Chart.Indicators.RsiTip}"
                                                           TextWrapping="Wrap" />
                                            </ToolTip.Tip>
                                        </livery:InfoIcon>
                                        <TextBlock Grid.Column="2"
                                                   Text="{loc:Localized Chart.Indicators.Period}"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Column="3"
                                                 Text="{Binding RsiPeriodText}"
                                                 VerticalAlignment="Center" />
                                    </Grid>
                                                                    <Grid Grid.Row="4" IsVisible="{Binding IsMacdPluginLoaded}"
                                          ColumnDefinitions="80,Auto,64,64" ColumnSpacing="{StaticResource SpaceM}">
                                        <CheckBox Grid.Column="0"
                                                  Content="MACD"
                                                  IsChecked="{Binding IsMacdEnabled}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center" />
                                        <livery:InfoIcon Grid.Column="1"
                                                         VerticalAlignment="Center"
                                                         AutomationProperties.Name="{loc:Localized Chart.Indicators.A11yMacdInfo}">
                                            <ToolTip.Tip>
                                                <TextBlock MaxWidth="260"
                                                           Text="{loc:Localized Chart.Indicators.MacdTip}"
                                                           TextWrapping="Wrap" />
                                            </ToolTip.Tip>
                                        </livery:InfoIcon>
                                        <TextBlock Grid.Column="2"
                                                   Text="{loc:Localized Chart.Indicators.Period}"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Column="3"
                                                 Text="{Binding MacdPeriodText}"
                                                 VerticalAlignment="Center" />
                                    </Grid>
                                                                    <Grid Grid.Row="5" IsVisible="{Binding IsAtrPluginLoaded}"
                                          ColumnDefinitions="80,Auto,64,64" ColumnSpacing="{StaticResource SpaceM}">
                                        <CheckBox Grid.Column="0"
                                                  Content="ATR"
                                                  IsChecked="{Binding IsAtrEnabled}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center" />
                                        <livery:InfoIcon Grid.Column="1"
                                                         VerticalAlignment="Center"
                                                         AutomationProperties.Name="{loc:Localized Chart.Indicators.A11yAtrInfo}">
                                            <ToolTip.Tip>
                                                <TextBlock MaxWidth="260"
                                                           Text="{loc:Localized Chart.Indicators.AtrTip}"
                                                           TextWrapping="Wrap" />
                                            </ToolTip.Tip>
                                        </livery:InfoIcon>
                                        <TextBlock Grid.Column="2"
                                                   Text="{loc:Localized Chart.Indicators.Period}"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Column="3"
                                                 Text="{Binding AtrPeriodText}"
                                                 VerticalAlignment="Center" />
                                    </Grid>
                                                                    <Grid Grid.Row="6" IsVisible="{Binding IsBollPluginLoaded}"
                                          ColumnDefinitions="80,Auto,64,64" ColumnSpacing="{StaticResource SpaceM}">
                                        <CheckBox Grid.Column="0"
                                                  Content="BOLL"
                                                  IsChecked="{Binding IsBollEnabled}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center" />
                                        <livery:InfoIcon Grid.Column="1"
                                                         VerticalAlignment="Center"
                                                         AutomationProperties.Name="{loc:Localized Chart.Indicators.A11yBollInfo}">
                                            <ToolTip.Tip>
                                                <TextBlock MaxWidth="260"
                                                           Text="{loc:Localized Chart.Indicators.BollTip}"
                                                           TextWrapping="Wrap" />
                                            </ToolTip.Tip>
                                        </livery:InfoIcon>
                                        <TextBlock Grid.Column="2"
                                                   Text="{loc:Localized Chart.Indicators.Period}"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Column="3"
                                                 Text="{Binding BollPeriodText}"
                                                 VerticalAlignment="Center" />
                                    </Grid>
                                    <!-- The honest empty state: zero indicators registered by the
                                         scan (missing or skipped plugin assemblies). -->
                                                                    <TextBlock Grid.Row="7"
                                IsVisible="{Binding IsIndicatorCatalogEmpty}"
                                               Text="{loc:Localized Settings.Indicators.Empty}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== Integrations (T-145) ====================
                 The MCP home shares the tab with the settings port (T-100).
                 The enable checkbox drafts exactly like every other
                 selection here: only Save applies — it persists the choice
                 and hands the flip to the host runner, which starts/stops
                 the server live (a start the stdio transport refuses
                 surfaces as the failed row and stays saved for the next
                 launch). The retired tab headers survive as the sections'
                 captions; the port section keeps its own availability flag
                 — merged tabs must never let one section hide the other.
                 Each long list still scrolls its own viewport; the merged
                 tab's body scrolls as one for small machines. -->
            <TabItem Classes="rail-item">
                <TabItem.Header>
                    <!-- The rail item's mark: the stroke plug beside the
                         caption; the caption keeps the tab key. -->
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}" VerticalAlignment="Center">
                        <Grid Width="16" Height="16">
                            <Path Stroke="{Binding $parent[TabItem].Foreground}"
                                  StrokeThickness="1.5"
                                  Data="M 5 1 L 5 4 M 11 1 L 11 4 M 4.5 4 L 11.5 4 A 1.5 1.5 0 0 1 13 5.5 L 13 8.5 A 1.5 1.5 0 0 1 11.5 10 L 4.5 10 A 1.5 1.5 0 0 1 3 8.5 L 3 5.5 A 1.5 1.5 0 0 1 4.5 4 Z M 8 10 L 8 13 M 6 15 L 10 15" />
                        </Grid>
                        <TextBlock Text="{loc:Localized Settings.Tab.Integrations}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <!-- The scroll content's right gutter (T-169): the Fluent
                     ScrollViewer's content presenter spans the scrollbar's
                     strip when the overlay bar appears, so the content ends
                     a ScrollBarSize (16 px, the bar's own strip width) short
                     of the viewport's right edge — the verdict messages and
                     the hint texts never sit under the bar. Every scroll
                     content in the window carries the same shape. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="{StaticResource SpaceL}" Margin="{StaticResource InsetL}">
                        <Border Classes="section-card">
                            <StackPanel Spacing="{StaticResource SpaceM}">
                                <ToggleButton x:Name="McpSectionToggle"
                                              Classes="section-toggle"
                                              IsChecked="True"
                                              AutomationProperties.AutomationId="McpSectionToggle">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                                            <Border Classes="section-tick" />
                                            <TextBlock Classes="section-header"
                                                       Text="{loc:Localized Settings.Section.Mcp}" />
                                        </StackPanel>
                                        <Path Classes="section-chevron" Grid.Column="1" />
                                    </Grid>
                                </ToggleButton>
                                <StackPanel x:Name="McpSectionBody"
                                            Spacing="{StaticResource SpaceM}"
                                            IsVisible="{Binding #McpSectionToggle.IsChecked}">
                            <StackPanel Spacing="{StaticResource SpaceL}">
                                <CheckBox Content="{loc:Localized Settings.Mcp.Enable}"
                                          IsChecked="{Binding IsMcpServerEnabled}" />

                                <!-- The honest state rows: exactly one shows (the bools
                                     derive from one state value, so they are mutually
                                     exclusive by construction). -->
                                <TextBlock IsVisible="{Binding IsMcpRunning}"
                                           Text="{loc:Localized Settings.Mcp.Running}"
                                           />
                                <TextBlock IsVisible="{Binding IsMcpStopped}"
                                           Text="{loc:Localized Settings.Mcp.Stopped}"
                                           />
                                <TextBlock IsVisible="{Binding IsMcpFailed}"
                                           Text="{loc:Localized Settings.Mcp.StartFailed}"
                                           TextWrapping="Wrap"
                                           />

                                <TextBlock Text="{loc:Localized Settings.Mcp.Hint}"
                                           TextWrapping="Wrap"
                                           />

                                <!-- ==================== External MCP client servers (T-068) ====================
                                     The editor drafts live in the rows (only Save applies —
                                     it persists the list and replays the manager's apply);
                                     the per-row honest state blocks repaint from the
                                     manager's snapshots (the name is the key both sides
                                     share). A disabled entry saves but never dials; every
                                     unusable field combination rides the entry verbatim
                                     and the transport boundary fails it loudly — the row's
                                     failed state shows the transport's own reason. -->
                                <TextBlock Text="{loc:Localized Settings.McpClients.Caption}"
                                           FontWeight="SemiBold" />

                                <ScrollViewer MaxHeight="220"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <!-- The inner viewport carries the same gutter (T-169). -->
                                    <ItemsControl ItemsSource="{Binding McpServers}"
                                                  Margin="0,0,16,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="{StaticResource SpaceM}" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:McpServerRow">
                                                <Border BorderThickness="1"
                                                        BorderBrush="{DynamicResource Border}"
                                                        CornerRadius="4"
                                                        Padding="{StaticResource InsetM}"
                                                        Margin="0,0,4,0">
                                                    <StackPanel Spacing="{StaticResource SpaceS}">
                                                        <!-- The header: the entry's name (the key the connections and the states key
                                                             by) with the enabled flag and the local-until-save remove button. -->
                                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource SpaceS}">
                                                            <TextBox Grid.Column="0"
                                                                     Text="{Binding Name}"
                                                                     PlaceholderText="{loc:Localized Settings.McpClients.Name}"
                                                                     ToolTip.Tip="{loc:Localized Settings.McpClients.Name}" />
                                                            <CheckBox Grid.Column="1"
                                                                      Content="{loc:Localized Settings.McpClients.Enabled}"
                                                                      IsChecked="{Binding IsEnabled}"
                                                                      VerticalAlignment="Center" />
                                                            <Button Grid.Column="2"
                                                                    Content="{loc:Localized Settings.McpClients.Remove}"
                                                                    CommandParameter="{Binding}"
                                                                    Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).RemoveMcpServerCommand}" />
                                                        </Grid>

                                                        <!-- The transport pick: stdio entries edit command + args, HTTP entries
                                                             the address/port (plus the optional seconds timeout). The names on
                                                             the combo are the protocol's own proper names, not localized. -->
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceS}">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{loc:Localized Settings.McpClients.Transport}"
                                                                       VerticalAlignment="Center" />
                                                            <ComboBox Grid.Column="1"
                                                                      SelectedIndex="{Binding TransportIndex}"
                                                                      MinWidth="170"
                                                                      HorizontalAlignment="Left">
                                                                <ComboBoxItem Content="Stdio" />
                                                                <ComboBoxItem Content="Streamable HTTP" />
                                                            </ComboBox>
                                                        </Grid>

                                                        <!-- The stdio fields: the command line pieces (the OS process API resolves
                                                             the command over the PATH; the arguments ride space-separated —
                                                             an argument containing spaces does not fit the text shape, the
                                                             hint documents it). -->
                                                        <StackPanel IsVisible="{Binding IsStdio}" Spacing="{StaticResource SpaceS}">
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceS}">
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{loc:Localized Settings.McpClients.Command}"
                                                                           VerticalAlignment="Center" />
                                                                <TextBox Grid.Column="1"
                                                                         Text="{Binding Command}"
                                                                         PlaceholderText="command"
                                                                         ToolTip.Tip="{loc:Localized Settings.McpClients.Command}" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceS}">
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{loc:Localized Settings.McpClients.Args}"
                                                                           VerticalAlignment="Center" />
                                                                <TextBox Grid.Column="1"
                                                                         Text="{Binding ArgsText}"
                                                                         PlaceholderText="arg1 arg2"
                                                                         ToolTip.Tip="{loc:Localized Settings.McpClients.Args}" />
                                                            </Grid>
                                                        </StackPanel>

                                                        <!-- The HTTP fields: address + port (empty port = the scheme's default,
                                                             URL semantics, nothing substituted) and the optional connect
                                                             timeout seconds (empty = the transport's shipped default). -->
                                                        <StackPanel IsVisible="{Binding IsHttp}" Spacing="{StaticResource SpaceS}">
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceS}">
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{loc:Localized Settings.McpClients.Address}"
                                                                           VerticalAlignment="Center" />
                                                                <TextBox Grid.Column="1"
                                                                         Text="{Binding Address}"
                                                                         ToolTip.Tip="{loc:Localized Settings.McpClients.Address}" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceS}">
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{loc:Localized Settings.McpClients.Port}"
                                                                           VerticalAlignment="Center" />
                                                                <TextBox Grid.Column="1"
                                                                         Text="{Binding PortText}"
                                                                         PlaceholderText="{loc:Localized Settings.McpClients.Port.Empty}"
                                                                         ToolTip.Tip="{loc:Localized Settings.McpClients.Port}" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceS}">
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{loc:Localized Settings.McpClients.Timeout}"
                                                                           VerticalAlignment="Center" />
                                                                <TextBox Grid.Column="1"
                                                                         Text="{Binding TimeoutText}"
                                                                         ToolTip.Tip="{loc:Localized Settings.McpClients.Timeout}" />
                                                            </Grid>
                                                        </StackPanel>

                                                        <!-- The auth secret reference key ONLY: the store resolves it — the
                                                             secret itself never rides config or the logs. -->
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceS}">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{loc:Localized Settings.McpClients.AuthRef}"
                                                                       VerticalAlignment="Center" />
                                                            <TextBox Grid.Column="1"
                                                                     Text="{Binding AuthSecretRef}"
                                                                     ToolTip.Tip="{loc:Localized Settings.McpClients.AuthRef}" />
                                                        </Grid>

                                                        <!-- The honest per-entry state: exactly one label shows (the bools are
                                                             mutually exclusive by construction); the failed row carries the
                                                             transport's own reason. -->
                                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceM}">
                                                            <TextBlock IsVisible="{Binding IsDisabled}"
                                                                       Text="{loc:Localized Settings.McpClients.State.Disabled}"
                                                                       />
                                                            <TextBlock IsVisible="{Binding IsConnecting}"
                                                                       Text="{loc:Localized Settings.McpClients.State.Connecting}"
                                                                       />
                                                            <TextBlock IsVisible="{Binding IsConnected}"
                                                                       Text="{loc:Localized Settings.McpClients.State.Connected}"
                                                                       />
                                                            <TextBlock IsVisible="{Binding IsFailed}"
                                                                       Text="{loc:Localized Settings.McpClients.State.Failed}"
                                                                       Foreground="{DynamicResource Error}"
                                                                       />
                                                            <TextBlock IsVisible="{Binding IsFailed}"
                                                                       Text="{Binding DetailText}"
                                                                       TextWrapping="Wrap"
                                                                       />
                                                            <TextBlock IsVisible="{Binding !IsStateKnown}"
                                                                       Text="{loc:Localized Settings.McpClients.State.Empty}"
                                                                       Foreground="{DynamicResource TextSecondary}"
                                                                       />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Button Content="{loc:Localized Settings.McpClients.Add}"
                                        Command="{Binding AddMcpServerCommand}"
                                        HorizontalAlignment="Left" />

                                <TextBlock Text="{loc:Localized Settings.McpClients.Hint}"
                                           TextWrapping="Wrap"
                                           />
                            </StackPanel>

                            <!-- ==================== The settings port section (T-100) ====================
                                 The port section's availability rides its own stack
                                 (a hidden port never hides the MCP section beside
                                 it). The export writes the registry-owned stored
                                 keys (never secrets), the import drafts into a
                                 dry-run diff preview that unlocks the apply only
                                 after validation passed (a rejected file never
                                 touches the store — nothing coerced, nothing
                                 defaulted), and the factory reset is the
                                 destructive act behind the typed confirmation
                                 dialog. File dialogs stay in code-behind (the
                                 window's own canon); the outcome surfaces are the
                                 error, preview and status rows below. -->
                            </StackPanel>
                        </StackPanel>
                        </Border>
                        <!-- ==================== The AI chat section (T-207) ====================
                             The provider pick drafts like every other selection
                             here: only Save applies — it persists the pick and
                             the two providers' endpoint pieces, and the chat
                             routes per request, so the next send answers through
                             the newly saved provider. The pick swaps the visible
                             field stacks live. The API key is the one immediate
                             field in the window: it commits to the secret store
                             per keystroke (the secret's only home — the settings
                             file, the logs and the port export never carry it),
                             re-seeds empty on every open (the secret never
                             echoes), and a re-seed never commits (a clear of the
                             box is the user's act, not the window's). -->
                        <Border Classes="section-card">
                            <StackPanel Spacing="{StaticResource SpaceM}">
                                <ToggleButton x:Name="AiSectionToggle"
                                              Classes="section-toggle"
                                              IsChecked="False"
                                              AutomationProperties.AutomationId="AiSectionToggle">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                                            <Border Classes="section-tick" />
                                            <TextBlock Classes="section-header"
                                                       Text="{loc:Localized Settings.Section.Ai}" />
                                        </StackPanel>
                                        <Path Classes="section-chevron" Grid.Column="1" />
                                    </Grid>
                                </ToggleButton>
                                <StackPanel x:Name="AiSectionBody"
                                            Spacing="{StaticResource SpaceM}"
                                            IsVisible="{Binding #AiSectionToggle.IsChecked}">
                                <StackPanel Spacing="{StaticResource SpaceL}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceS}">
                                        <TextBlock Grid.Column="0"
                                                   Text="{loc:Localized Settings.Ai.Provider}"
                                                   VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1"
                                                  SelectedIndex="{Binding AiProviderIndex}"
                                                  MinWidth="170"
                                                  HorizontalAlignment="Left">
                                            <ComboBoxItem Content="{loc:Localized Settings.Ai.ProviderOllama}" />
                                            <ComboBoxItem Content="{loc:Localized Settings.Ai.ProviderOpenAiCompatible}" />
                                        </ComboBox>
                                    </Grid>

                                    <!-- The Ollama fields: endpoint + model tag (blank
                                         stored values resolve to the shipped local
                                         defaults at the provider). -->
                                    <StackPanel IsVisible="{Binding IsAiOllama}" Spacing="{StaticResource SpaceS}">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceS}">
                                            <TextBlock Grid.Column="0"
                                                       Text="{loc:Localized Settings.Ai.OllamaBaseUrl}"
                                                       VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding OllamaUrlDraft}"
                                                     ToolTip.Tip="{loc:Localized Settings.Ai.OllamaBaseUrl}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceS}">
                                            <TextBlock Grid.Column="0"
                                                       Text="{loc:Localized Settings.Ai.OllamaModel}"
                                                       VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding OllamaModelDraft}"
                                                     ToolTip.Tip="{loc:Localized Settings.Ai.OllamaModel}" />
                                        </Grid>
                                    </StackPanel>

                                    <!-- The OpenAI-compatible fields: endpoint + model +
                                         the immediate API key (the masked box commits to
                                         the secret store as typed; a local server needs
                                         no key — an empty box travels unauthenticated). -->
                                    <StackPanel IsVisible="{Binding IsAiOpenAiCompatible}" Spacing="{StaticResource SpaceS}">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceS}">
                                            <TextBlock Grid.Column="0"
                                                       Text="{loc:Localized Settings.Ai.OpenAiBaseUrl}"
                                                       VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding OpenAiBaseUrlDraft}"
                                                     ToolTip.Tip="{loc:Localized Settings.Ai.OpenAiBaseUrl}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceS}">
                                            <TextBlock Grid.Column="0"
                                                       Text="{loc:Localized Settings.Ai.OpenAiModel}"
                                                       VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding OpenAiModelDraft}"
                                                     ToolTip.Tip="{loc:Localized Settings.Ai.OpenAiModel}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceS}">
                                            <TextBlock Grid.Column="0"
                                                       Text="{loc:Localized Settings.Ai.OpenAiApiKey}"
                                                       VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding OpenAiApiKeyDraft}"
                                                     PasswordChar="●"
                                                     PlaceholderText="{loc:Localized Settings.Ai.OpenAiKeyWatermark}"
                                                     ToolTip.Tip="{loc:Localized Settings.Ai.OpenAiApiKey}" />
                                        </Grid>
                                        <TextBlock Text="{loc:Localized Settings.Ai.OpenAiKeyHint}"
                                                   TextWrapping="Wrap"
                                                   />
                                    </StackPanel>
                                </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- The exchange-credentials section (T-227): the
                             adapters' per-venue key pairs commit to the
                             secret store (the pair's only home), each row's
                             Save applies its own whole pair atomically and
                             the secret never echoes — the boxes re-seed
                             empty on every window open. -->
                        <Border Classes="section-card">
                            <StackPanel Spacing="{StaticResource SpaceM}">
                                <ToggleButton x:Name="CredentialsSectionToggle"
                                              Classes="section-toggle"
                                              IsChecked="False"
                                              AutomationProperties.AutomationId="CredentialsSectionToggle">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                                            <Border Classes="section-tick" />
                                            <TextBlock Classes="section-header"
                                                       Text="{loc:Localized Settings.Section.Credentials}" />
                                        </StackPanel>
                                        <Path Classes="section-chevron" Grid.Column="1" />
                                    </Grid>
                                </ToggleButton>
                                <StackPanel x:Name="CredentialsSectionBody"
                                            Spacing="{StaticResource SpaceM}"
                                            IsVisible="{Binding #CredentialsSectionToggle.IsChecked}">
                                    <TextBlock Text="{loc:Localized Settings.Credentials.Hint}"
                                               TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding CredentialSlots}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CredentialSlot">
                                                <Border BorderThickness="1"
                                                        BorderBrush="{DynamicResource Border}"
                                                        CornerRadius="4"
                                                        Padding="{StaticResource InsetM}"
                                                        Margin="0,0,4,0">
                                                    <StackPanel Spacing="{StaticResource SpaceS}">
                                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="{StaticResource SpaceS}">
                                                            <TextBlock Grid.Column="0"
                                                                       Classes="section-header"
                                                                       Text="{Binding VenueTitle}"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding StatusText}"
                                                                       VerticalAlignment="Center" />
                                                            <Button Grid.Column="2"
                                                                    Content="{loc:Localized Settings.Credentials.Clear}"
                                                                    Command="{Binding ClearCommand}"
                                                                    AutomationProperties.AutomationId="CredentialClearButton"
                                                                    MinWidth="80" />
                                                            <Button Grid.Column="3"
                                                                    Content="{loc:Localized Settings.Credentials.Save}"
                                                                    Command="{Binding SaveCommand}"
                                                                    AutomationProperties.AutomationId="CredentialSaveButton"
                                                                    MinWidth="80" />
                                                        </Grid>
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceS}">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{loc:Localized Settings.Credentials.Key}"
                                                                       VerticalAlignment="Center" />
                                                            <TextBox Grid.Column="1"
                                                                     Text="{Binding KeyText}"
                                                                     PasswordChar="●"
                                                                     ToolTip.Tip="{Binding KeySecretName}" />
                                                        </Grid>
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceS}">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{loc:Localized Settings.Credentials.Secret}"
                                                                       VerticalAlignment="Center" />
                                                            <TextBox Grid.Column="1"
                                                                     Text="{Binding SecretText}"
                                                                     PasswordChar="●"
                                                                     ToolTip.Tip="{Binding SecretSecretName}" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Classes="section-card" IsVisible="{Binding IsPortAvailable}">
                            <StackPanel Spacing="{StaticResource SpaceM}">
                                <ToggleButton x:Name="PortSectionToggle"
                                              Classes="section-toggle"
                                              IsChecked="False"
                                              AutomationProperties.AutomationId="PortSectionToggle">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                                            <Border Classes="section-tick" />
                                            <TextBlock Classes="section-header"
                                                       Text="{loc:Localized Settings.Section.Port}" />
                                        </StackPanel>
                                        <Path Classes="section-chevron" Grid.Column="1" />
                                    </Grid>
                                </ToggleButton>
                                <StackPanel x:Name="PortSectionBody"
                                            Spacing="{StaticResource SpaceM}"
                                            IsVisible="{Binding #PortSectionToggle.IsChecked}">
                                <StackPanel Spacing="{StaticResource SpaceL}">

                                <!-- The export block: one button, the honest hint. -->
                                <Button Content="{loc:Localized Port.Export}"
                                        Click="OnExportClick"
                                        HorizontalAlignment="Left" />
                                <TextBlock Text="{loc:Localized Port.Hint}"
                                           TextWrapping="Wrap"
                                           />

                                <!-- The import block: pick → validated preview → apply. -->
                                <Button Content="{loc:Localized Port.Import}"
                                        Click="OnImportClick"
                                        HorizontalAlignment="Left" />

                                <TextBlock IsVisible="{Binding HasImportError}"
                                           Text="{Binding ImportErrorText}"
                                           Foreground="{DynamicResource Error}"
                                           TextWrapping="Wrap"
                                           />

                                <StackPanel IsVisible="{Binding IsImportPreviewVisible}" Spacing="{StaticResource SpaceM}">
                                    <TextBlock Text="{loc:Localized Port.PreviewHeader}"
                                               FontWeight="SemiBold" />
                                    <ScrollViewer MaxHeight="180"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <!-- The inner viewport carries the same gutter (T-169). -->
                                        <ItemsControl ItemsSource="{Binding ImportPreview}"
                                                      Margin="0,0,16,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="{StaticResource SpaceXs}" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="services:PortImportRow">
                                                    <StackPanel Spacing="{StaticResource SpaceXs}">
                                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                                                            <TextBlock Text="{Binding Section}" FontWeight="SemiBold" />
                                                            <TextBlock Text="." VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Key}" FontWeight="SemiBold" />
                                                            <TextBlock IsVisible="{Binding IsAdded}"
                                                                       Text="{loc:Localized Port.Change.Added}"
                                                                       />
                                                            <TextBlock IsVisible="{Binding IsChanged}"
                                                                       Text="{loc:Localized Port.Change.Changed}"
                                                                       />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}" IsVisible="{Binding IsChanged}">
                                                            <TextBlock Text="{loc:Localized Port.From}"
                                                                       VerticalAlignment="Top"
                                                                       Foreground="{DynamicResource TextSecondary}" />
                                                            <TextBlock Text="{Binding CurrentValueJson}"
                                                                       TextWrapping="Wrap"
                                                                       MaxWidth="380"
                                                                       Foreground="{DynamicResource TextSecondary}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                                                            <TextBlock Text="{loc:Localized Port.To}"
                                                                       VerticalAlignment="Top"
                                                                       />
                                                            <TextBlock Text="{Binding ImportedValueJson}"
                                                                       TextWrapping="Wrap"
                                                                       MaxWidth="380"
                                                                       />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <Button x:Name="ApplyImportButton"
                                            Content="{loc:Localized Port.Apply}"
                                            Command="{Binding ApplyImportCommand}"
                                            HorizontalAlignment="Left" />
                                </StackPanel>

                                <!-- The factory reset: the destructive one. The typed confirmation dialog
                                     (IConfirmationService) gates it — the button only opens that gate. -->
                                <TextBlock Text="{loc:Localized Port.Reset}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{loc:Localized Port.Reset.Hint}"
                                           TextWrapping="Wrap"
                                           />
                                <Button Content="{loc:Localized Port.Reset.Button}"
                                        Click="OnResetClick"
                                        HorizontalAlignment="Left" />

                                <TextBlock IsVisible="{Binding HasPortStatusText}"
                                           Text="{Binding PortStatusText}"
                                           TextWrapping="Wrap"
                                           />
                            </StackPanel>
                        </StackPanel>
                        </StackPanel>
                        </Border>
                        <Border Classes="section-card" IsVisible="{Binding IsBackupAvailable}">
                            <StackPanel Spacing="{StaticResource SpaceM}">
                                <ToggleButton x:Name="BackupSectionToggle"
                                              Classes="section-toggle"
                                              IsChecked="False"
                                              AutomationProperties.AutomationId="BackupSectionToggle">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                                            <Border Classes="section-tick" />
                                            <TextBlock Classes="section-header"
                                                       Text="{loc:Localized Settings.Section.Backup}" />
                                        </StackPanel>
                                        <Path Classes="section-chevron" Grid.Column="1" />
                                    </Grid>
                                </ToggleButton>
                                <StackPanel x:Name="BackupSectionBody"
                                            Spacing="{StaticResource SpaceM}"
                                            IsVisible="{Binding #BackupSectionToggle.IsChecked}">
                                <StackPanel Spacing="{StaticResource SpaceL}">

                                <!-- The backup block: one button, the honest hint (secrets never ride the archive). -->
                                <Button Content="{loc:Localized Backup.Backup}"
                                        Click="OnBackupClick"
                                        HorizontalAlignment="Left" />
                                <TextBlock Text="{loc:Localized Backup.Hint}"
                                           TextWrapping="Wrap"
                                           />

                                <!-- The restore block: pick → validated preview → apply. The typed
                                     confirmation dialog (IConfirmationService) gates the apply — the
                                     Apply button only feeds the service's own gate. -->
                                <Button Content="{loc:Localized Backup.Restore}"
                                        Click="OnRestoreClick"
                                        HorizontalAlignment="Left" />
                                <TextBlock Text="{loc:Localized Backup.Restore.Hint}"
                                           TextWrapping="Wrap"
                                           />

                                <TextBlock IsVisible="{Binding HasRestoreError}"
                                           Text="{Binding RestoreErrorText}"
                                           Foreground="{DynamicResource Error}"
                                           TextWrapping="Wrap"
                                           />

                                <StackPanel IsVisible="{Binding IsRestorePreviewVisible}" Spacing="{StaticResource SpaceM}">
                                    <TextBlock Text="{loc:Localized Backup.PreviewHeader}"
                                               FontWeight="SemiBold" />
                                    <ScrollViewer MaxHeight="180"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <!-- The inner viewport carries the same gutter (T-169). -->
                                        <ItemsControl ItemsSource="{Binding RestorePreview}"
                                                      Margin="0,0,16,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="{StaticResource SpaceXs}" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:BackupPreviewRow">
                                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding SizeText}"
                                                                   Foreground="{DynamicResource TextSecondary}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <Button x:Name="ApplyRestoreButton"
                                            Content="{loc:Localized Backup.Apply}"
                                            Command="{Binding ApplyRestoreCommand}"
                                            HorizontalAlignment="Left" />
                                </StackPanel>

                                <TextBlock IsVisible="{Binding HasBackupStatusText}"
                                           Text="{Binding BackupStatusText}"
                                           TextWrapping="Wrap"
                                           />
                            </StackPanel>
                        </StackPanel>
                        </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== Workspace (T-145) ====================
                 The workspace surface: both pairs marks (the classic
                 two-list dialog shape: the left list holds the workspace
                 exchange's all pairs with a star button on every row (a
                 starred pair pins to the list head and never hides until
                 unstarred), the right one the hidden names, the move buttons
                 in the center column) and the hotkey manager's editor (T-102:
                 one row per registry action, the names and verdicts
                 localized by the shared hotkey manager's VM — injected
                 through the window's styled property, so the settings
                 ViewModel stays untouched by the seam). Every edit diagnoses
                 at edit time (invalid, plain and conflicting verdicts) and a
                 valid text commits at once — the service's live map rebinds
                 every consumer (the window's key route, the menu's
                 advertised gestures, the cheat sheet) without a restart.
                 Per-row commit, per-row reset; the sheet's read-only mirror
                 lives on the main window's Help-menu "?" overlay. The
                 retired tab headers survive as the sections' captions; the
                 pairs lists keep a fixed-height viewport (their own
                 scrollbars, the original discipline) so the merged tab's
                 body scrolls as one. -->
            <TabItem Classes="rail-item">
                <TabItem.Header>
                    <!-- The rail item's mark: the stroke workspace grid beside
                         the caption; the caption keeps the tab key. -->
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}" VerticalAlignment="Center">
                        <Grid Width="16" Height="16">
                            <Path Stroke="{Binding $parent[TabItem].Foreground}"
                                  StrokeThickness="1.5"
                                  Data="M 1.75 1.75 L 6.25 1.75 L 6.25 6.25 L 1.75 6.25 Z M 9.75 1.75 L 14.25 1.75 L 14.25 6.25 L 9.75 6.25 Z M 1.75 9.75 L 6.25 9.75 L 6.25 14.25 L 1.75 14.25 Z M 9.75 9.75 L 14.25 9.75 L 14.25 14.25 L 9.75 14.25 Z" />
                        </Grid>
                        <TextBlock Text="{loc:Localized Settings.Tab.Workspace}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <!-- The hotkeys rows scroll in their own viewport: its
                     scrollbar carries the same right gutter as every
                     scroll content (T-169) - the gesture boxes never
                     sit under the scrollbar's strip. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="{StaticResource SpaceL}" Margin="{StaticResource InsetL}">
                        <Border Classes="section-card">
                            <StackPanel Spacing="{StaticResource SpaceM}">
                                <ToggleButton x:Name="PairsSectionToggle"
                                              Classes="section-toggle"
                                              IsChecked="True"
                                              AutomationProperties.AutomationId="PairsSectionToggle">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                                            <Border Classes="section-tick" />
                                            <TextBlock Classes="section-header"
                                                       Text="{loc:Localized Settings.Section.Pairs}" />
                                        </StackPanel>
                                        <Path Classes="section-chevron" Grid.Column="1" />
                                    </Grid>
                                </ToggleButton>
                                <StackPanel x:Name="PairsSectionBody"
                                            Spacing="{StaticResource SpaceM}"
                                            IsVisible="{Binding #PairsSectionToggle.IsChecked}">
                                <Grid Height="236"
                                      ColumnDefinitions="*,Auto,*"
                                      ColumnSpacing="{StaticResource SpaceM}"
                                      RowDefinitions="Auto,*"
                                      RowSpacing="{StaticResource SpaceM}">
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="{loc:Localized Settings.Pairs.All}" />
                                    <TextBlock Grid.Row="0" Grid.Column="2"
                                               Text="{loc:Localized Settings.Pairs.Hidden}" />
                                    <!-- The pair lists scroll internally, so each
                                         carries its own right gutter: the overlay
                                         bar paints over the list's right strip,
                                         and the star buttons and the default rows
                                         must end a strip short of the edge. -->
                                    <ListBox Grid.Row="1" Grid.Column="0"
                                             Padding="0,0,16,0"
                                             ItemsSource="{Binding AllPairs}"
                                             SelectedItem="{Binding SelectedAllPair}">
                                        <ListBox.ItemTemplate>
                                            <!-- One row: the pair name with the star button
                                                 on the right. The row record carries the
                                                 star state (rebuilt on every draft move),
                                                 so the template binds within its own data
                                                 type; the window's DataContext supplies the
                                                 toggle command. -->
                                            <DataTemplate x:DataType="vm:PairRow">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Name}"
                                                               VerticalAlignment="Center" />
                                                    <Button Grid.Column="1"
                                                            Content="★"
                                                            FontSize="{StaticResource SubtitleStrongFontSize}"
                                                            Padding="4,4"
                                                            MinWidth="28"
                                                            VerticalAlignment="Center"
                                                            Margin="0,-2,0,-2"
                                                            Classes="pair-star"
                                                            Classes.on="{Binding IsFavorite}"
                                                            ToolTip.Tip="{loc:Localized Settings.Pairs.Star}"
                                                            AutomationProperties.Name="{loc:Localized Settings.Pairs.Star}"
                                                            CommandParameter="{Binding}"
                                                            Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).TogglePairFavoriteCommand}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <ListBox Grid.Row="1" Grid.Column="2"
                                             Padding="0,0,16,0"
                                             ItemsSource="{Binding HiddenPairs}"
                                             SelectedItem="{Binding SelectedHiddenPair}" />
                                    <StackPanel Grid.Row="1" Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="{StaticResource SpaceS}">
                                        <!-- The transfer pair rides the chrome kit's icon
                                             button (T-154, consumed as-is): borderless,
                                             state fill suppressed, the strip's opacity
                                             feedback. The chevron Path carries the flow
                                             direction like the title-bar strip's glyphs
                                             (explicit strokes, no inheritance chain); the
                                             readable captions ride the automation name and
                                             the tooltip (assistive tech and hover alike) —
                                             the glyph alone never carries meaning. -->
                                        <Button Classes="icon"
                                                Width="34" Height="30" Padding="0"
                                                ToolTip.Tip="{loc:Localized Settings.Pairs.Hide}"
                                                AutomationProperties.Name="{loc:Localized Settings.Pairs.Hide}"
                                                Command="{Binding HidePairCommand}">
                                            <Path Stretch="None"
                                                  StrokeThickness="1.5"
                                                  Stroke="{DynamicResource TextPrimary}"
                                                  Data="M 4.5 2.5 L 9.5 6 L 4.5 9.5" />
                                        </Button>
                                        <Button Classes="icon"
                                                Width="34" Height="30" Padding="0"
                                                ToolTip.Tip="{loc:Localized Settings.Pairs.Reveal}"
                                                AutomationProperties.Name="{loc:Localized Settings.Pairs.Reveal}"
                                                Command="{Binding RevealPairCommand}">
                                            <Path Stretch="None"
                                                  StrokeThickness="1.5"
                                                  Stroke="{DynamicResource TextPrimary}"
                                                  Data="M 9.5 2.5 L 4.5 6 L 9.5 9.5" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{loc:Localized Settings.Pairs.Hint}"
                                           TextWrapping="Wrap"
                                           />

                            </StackPanel>
                        </StackPanel>
                        </Border>
                        <Border Classes="section-card">
                            <StackPanel Spacing="{StaticResource SpaceM}">
                                <ToggleButton x:Name="HotkeysSectionToggle"
                                              Classes="section-toggle"
                                              IsChecked="False"
                                              AutomationProperties.AutomationId="HotkeysSectionToggle">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                                            <Border Classes="section-tick" />
                                            <TextBlock Classes="section-header"
                                                       Text="{loc:Localized Settings.Section.Hotkeys}" />
                                        </StackPanel>
                                        <Path Classes="section-chevron" Grid.Column="1" />
                                    </Grid>
                                </ToggleButton>
                                <StackPanel x:Name="HotkeysSectionBody"
                                            Spacing="{StaticResource SpaceM}"
                                            IsVisible="{Binding #HotkeysSectionToggle.IsChecked}">
                                <StackPanel Spacing="{StaticResource SpaceL}"
                                            DataContext="{Binding Hotkeys, RelativeSource={RelativeSource AncestorType={x:Type views:SettingsWindow}}}">
                                <TextBlock Text="{loc:Localized Hotkeys.Editor.Hint}"
                                           Foreground="{DynamicResource TextSecondary}"
                                           TextWrapping="Wrap"
                                           />
                                <ScrollViewer MaxHeight="150"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Rows}"
                                                  Margin="0,0,16,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:HotkeyRowViewModel">
                                                <StackPanel Spacing="{StaticResource SpaceXs}" Margin="0,4">
                                                    <Grid ColumnDefinitions="*,Auto,150,Auto"
                                                          ColumnSpacing="{StaticResource SpaceS}">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Name}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{loc:Localized Hotkeys.Editor.Default}"
                                                                   IsVisible="{Binding !IsOverridden}"
                                                                   FontStyle="Italic"
                                                                   Foreground="{DynamicResource TextSecondary}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBox Grid.Column="2"
                                                                 Text="{Binding GestureText, Mode=TwoWay}" />
                                                        <Button Grid.Column="3"
                                                                Content="{loc:Localized Hotkeys.Editor.Reset}"
                                                                IsVisible="{Binding IsOverridden}"
                                                                Command="{Binding $parent[ItemsControl].((vm:HotkeyViewModel)DataContext).ResetRowCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>
                                                    <TextBlock IsVisible="{Binding HasMessage}"
                                                               Text="{Binding Message}"
                                                               Foreground="{DynamicResource Error}"
                                                               TextWrapping="Wrap"
                                                               />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        </Panel>

        <!-- The dialog's bottom row (T-222): the approved pinned strip — the
             full-width top hairline over the title-bar fill; the quiet Close
             rides beside the ONE primary Save (the T-183 vocabulary). The
             row pins outside the tab area, never scrolled away. -->
        <Border x:Name="FooterBar"
                Grid.Row="1"
                Background="{DynamicResource TitleBar}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceM}" HorizontalAlignment="Right">
                <Button x:Name="CloseButton"
                        Content="{loc:Localized Settings.Close}"
                        MinWidth="90"
                        Click="OnCloseClick" />
                <Button x:Name="SaveButton"
                        Classes="primary"
                        AutomationProperties.AutomationId="SaveButton"
                        Content="{loc:Localized Settings.Save}"
                        MinWidth="90"
                        Click="OnSaveClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
