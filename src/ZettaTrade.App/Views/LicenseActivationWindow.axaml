<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ZettaTrade.App.ViewModels"
        xmlns:loc="using:Livery.Localization"
        x:Class="ZettaTrade.App.Views.LicenseActivationWindow"
        Classes="chrome-compact"
        Icon="/Assets/ZettaTrade.ico"
        x:DataType="vm:LicenseActivationViewModel"
        Title="{loc:Localized Settings.License.Title}"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource Background}">

    <!-- The body: the static copy is localized in XAML ({loc:Localized}),
         the verdict line is dynamic (the ViewModel's mapping through the
         localization manager). A stored activation closes the window from
         the code-behind; a refusal keeps it open with the verdict shown. -->
    <StackPanel Margin="20" Spacing="{StaticResource SpaceM}">
        <TextBlock Text="{loc:Localized Settings.License.Hint}"
                   TextWrapping="Wrap" />
        <TextBox PlaceholderText="{loc:Localized Settings.License.PluginLabel}"
                 Text="{Binding PluginId}" />
        <TextBox PlaceholderText="{loc:Localized Settings.License.KeyLabel}"
                 Text="{Binding LicenseKey}"
                 TextWrapping="Wrap"
                 AcceptsReturn="False" />
        <!-- The EULA leg: a module carrying EULA text surfaces it at the
             first activation (the wording ships in the module's package,
             never in this repo); the store waits for the accept tick. -->
        <StackPanel IsVisible="{Binding HasEula}" Spacing="6">
            <TextBlock Text="{loc:Localized Settings.License.Eula.Caption}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding EulaText}"
                           TextWrapping="Wrap"
                           />
            </ScrollViewer>
            <CheckBox Content="{loc:Localized Settings.License.Eula.AcceptLabel}"
                      IsChecked="{Binding Accepted}" />
        </StackPanel>
        <Button Content="{loc:Localized Settings.License.Activate}"
                Command="{Binding ActivateCommand}"
                MinWidth="140"
                HorizontalAlignment="Left"
                Margin="0,4,0,0" />
        <TextBlock Text="{Binding Verdict}"
                   TextWrapping="Wrap"
                   />
        <Button Content="{loc:Localized Settings.License.Close}"
                Click="OnCloseClicked"
                MinWidth="140"
                HorizontalAlignment="Right" />
    </StackPanel>
</Window>
