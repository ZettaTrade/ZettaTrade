<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ZettaTrade.Backtest</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- ZettaTrade.Backtest owns the offline deterministic replay harness
       (T-113): cached candles run through the strategy seam's contracts
       (T-111, consumed unchanged) and the fills ride the paper ledger's
       T-051-corrected semantics. No adapters, no limiter, no trading
       surface: the simulator reads the candle cache and writes nothing
       but its own in-memory report. -->
  <ItemGroup>
    <ProjectReference Include="..\ZettaTrade.Core\ZettaTrade.Core.csproj" />
    <ProjectReference Include="..\ZettaTrade.Infrastructure\ZettaTrade.Infrastructure.csproj" />
    <ProjectReference Include="..\ZettaTrade.Strategies\ZettaTrade.Strategies.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageReference Include="System.Reactive" Version="7.0.0" />
  </ItemGroup>

</Project>
