<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<RootNamespace>ZettaTrade.UI</RootNamespace>
    <AssemblyName>ZettaTrade.UI</AssemblyName>
    <Description>Charting primitives, widgets, shared observer extensions, and the app's localized strings catalog.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageReference Include="ReactiveUI" Version="26.0.1" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="System.Reactive" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Livery\Livery.csproj" />
    <ProjectReference Include="..\ZettaTrade.Charting\ZettaTrade.Charting.csproj" />
    <ProjectReference Include="..\ZettaTrade.Core\ZettaTrade.Core.csproj" />
  </ItemGroup>

  <!-- The test project pins the chart control's internal render seam (the
       snapshot export's payload): the App test project exercises it
       marshaled through the dispatcher. -->
  <ItemGroup>
    <InternalsVisibleTo Include="ZettaTrade.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
