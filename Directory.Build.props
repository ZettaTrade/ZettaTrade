<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Banned APIs: see BannedSymbols.txt (ReactiveUI.RxVoid, no blocking, no stdout writes). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt"
                     Condition="Exists('$(MSBuildThisFileDirectory)BannedSymbols.txt')"
                     Visible="false" />
  </ItemGroup>

  <!-- Common metadata -->
  <PropertyGroup>
    <Authors>ZettaTrade Contributors</Authors>
    <Company>ZettaTrade</Company>
    <Product>ZettaTrade</Product>
    <Copyright>Copyright (c) ZettaTrade Contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/zettatrade/zettatrade</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- App version: 0.1.0 while in alpha. One alpha release per board task
         that changes the app; docs-only tasks do not bump the version. Rule:
         VersionSuffix moves alpha.N -> alpha.N+1 and the release commit
         (its title follows the "chore: ship T-0NN as 0.1.0-alpha.NN" shape)
         carries the bump, the matching CHANGELOG.md section and the board
         flip. The beta flip happens by a board decision and is traced in
         the docs when it does. The version shows in the exe file
         properties (Product version), in NuGet metadata and in Help/About
         (T-153 moved it off the status strip). -->
    <VersionPrefix>0.1.0</VersionPrefix>


    <VersionSuffix>alpha.129</VersionSuffix>

  </PropertyGroup>

  <!-- The domain-neutral appearance library ships as a package (T-130):
       the standalone ZettaTrade/Livery repo publishes it to the private
       GitHub Packages feed (the root nuget.config pins the source). One
       version fact: bump this single line when a new package release
       lands, never the five consumers. -->
  <PropertyGroup>
    <LiveryVersion>0.1.11</LiveryVersion>
  </PropertyGroup>

  <!-- The standard indicator pack ships as a package (T-163): the
       standalone ZettaTrade/Plugins repo publishes the umbrella
       (ZettaTrade.Plugins.Standard - the eleven plugin DLLs) to the private
       GitHub Packages feed (the root nuget.config pins the source). One
       version fact: bump this single line when a new pack release lands,
       never the consuming test projects. -->
  <PropertyGroup>
    <PluginsVersion>0.3.0</PluginsVersion>
  </PropertyGroup>
</Project>
