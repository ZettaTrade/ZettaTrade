<?xml version="1.0" encoding="utf-8"?>
<!-- Package sources for every machine and CI: nuget.org plus the private
     GitHub Packages feed carrying the Livery package (T-130). The feed's
     credentials never live in the repository: developers add the source
     (name: zettatrade, url: https://nuget.pkg.github.com/ZettaTrade/index.json)
     with a read:packages token once per machine; CI injects the automatic
     GITHUB_TOKEN at runtime (the Livery package grants this repository
     Actions access). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="zettatrade" value="https://nuget.pkg.github.com/ZettaTrade/index.json" />
  </packageSources>
</configuration>
