    <ProjectReference Include="..\..\src\ZettaTrade.Plugins.Wma\ZettaTrade.Plugins.Wma.csproj" />
    <ProjectReference Include="..\..\src\ZettaTrade.Plugins.Rsi\ZettaTrade.Plugins.Rsi.csproj" />
    <ProjectReference Include="..\..\src\ZettaTrade.Plugins.Macd\ZettaTrade.Plugins.Macd.csproj" />
    <ProjectReference Include="..\..\src\ZettaTrade.Plugins.Atr\ZettaTrade.Plugins.Atr.csproj" />
    <ProjectReference Include="..\..\src\ZettaTrade.Plugins.Bollinger\ZettaTrade.Plugins.Bollinger.csproj" />
  </ItemGroup>

</Project>
