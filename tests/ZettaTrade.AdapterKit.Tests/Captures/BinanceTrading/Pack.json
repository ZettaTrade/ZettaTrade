{
  "adapterId": "binance",
  "adapterName": "Binance (testnet)",
  "capabilities": "Trading | AccountInfo | MarketData | OrderBook | HistoricalData",
  "connectsAtConstruction": false,
  "symbols": [ "BTC/USDT", "ETH/USDT" ],
  "strangerSymbol": "DOGE/GBP",
  "clientSideGuards": [ "blank-endpoints" ],
  "depthProfile": "delegated",
  "delegatedServedDepths": [ 5, 10, 20 ],
  "depthProbeRequests": [ 7, 20 ],
  "rejectedDepthRequest": 7,
  "bookTopicTemplate": "{symbolLower}@depth{depth}@100ms",
  "subscribeMarker": "\"method\":\"SUBSCRIBE\"",
  "reconnectMode": "transcript",
  "transcriptSessions": [
    { "script": "Session1.json", "tickerPrice": 50000.5 },
    { "script": "Session2.json", "tickerPrice": 50001.5 }
  ],
  "cannedRest": {
    "/api/v3/ticker/price": "RestCatalog.json",
    "/api/v3/userDataStream": "RestListenKey.json"
  }
}
