<Project Sdk="Microsoft.NET.Sdk">

  <!-- T-054 (BUG-014) test fixture: a VALID plugin assembly whose
       dependencies are missing at catalog-scan time — its base class
       (BrokenBase) is never staged next to it. The catalog scan must skip
       the file loudly instead of letting the ReflectionTypeLoadException
       from assembly.GetTypes() escape. The type is deliberately not an
       IIndicator: the missing base is the failure under test, not the
       registration convention. -->
  <PropertyGroup>
    <RootNamespace>ZettaTrade.Plugins.Broken</RootNamespace>
    <IsPackable>false</IsPackable>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-only: the base assembly must never reach the consumers'
         output directories (T-054 premise: the dependency is genuinely
         missing at scan time). ExcludeAssets alone did not stop the copy
         (verified on a clean rebuild, T-148); Private="false" kills the
         copy-local flow that leaked the dll from Broken/bin into the test
         output, where the LoadFrom probe of AppBase loaded and locked it,
         racing the catalog fixture's leak-delete. -->
    <ProjectReference Include="..\ZettaTrade.Plugins.BrokenBase\ZettaTrade.Plugins.BrokenBase.csproj" ExcludeAssets="runtime" Private="false" />
  </ItemGroup>

</Project>
