<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ZettaTrade.Infrastructure.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="7.2.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="System.Reactive" Version="7.0.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- FrameworkReference only: hosts the loopback Kestrel WebSocket server
       for transport e2e tests (T-020). No ASP.NET code ships in any
       product project. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ZettaTrade.Core\ZettaTrade.Core.csproj" />
    <ProjectReference Include="..\..\src\ZettaTrade.Infrastructure\ZettaTrade.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\ZettaTrade.Plugins.Sma\ZettaTrade.Plugins.Sma.csproj" />
    <!-- T-054 fixtures: the Broken plugin's dll lands in the test output
         (located by NAME by the catalog fixture — typeof would throw on its
         unresolvable base type). The base assembly stays compile-only so the
         dependency is genuinely missing when the scan loads the plugin.
         ExcludeAssets="runtime" alone did NOT keep it off disk (verified on
         a clean rebuild, T-148): the primary output still rode the
         copy-local flow, the LoadFrom probe of AppBase loaded and locked the
         leaked copy, and the catalog fixture's leak-delete raced that lock.
         Private="false" kills the copy on both the direct and the transitive
         path; the leak-delete in the fixture stays as belt-and-suspenders. -->
    <ProjectReference Include="..\ZettaTrade.Plugins.Broken\ZettaTrade.Plugins.Broken.csproj" />
    <ProjectReference Include="..\ZettaTrade.Plugins.BrokenBase\ZettaTrade.Plugins.BrokenBase.csproj" ExcludeAssets="runtime" Private="false" />
    <ProjectReference Include="..\ZettaTrade.Plugins.Fixtures\ZettaTrade.Plugins.Fixtures.csproj" />
    <ProjectReference Include="..\ZettaTrade.Plugins.Fixtures.Hazards\ZettaTrade.Plugins.Fixtures.Hazards.csproj" />
  </ItemGroup>

</Project>
