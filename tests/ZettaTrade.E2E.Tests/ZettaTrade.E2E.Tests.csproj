<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ZettaTrade.E2E.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <OutputType>Library</OutputType>
    <!-- The lane drives Windows UI Automation end to end (FlaUI 5.0 rides
         the windows TFM and its UIA3 interop is a net48 package consumed
         through the documented compatibility route), so the project
         declares the Windows platform; EnableWindowsTargeting keeps the
         solution's Linux build (the CI gate) green. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.Core" Version="5.0.0" />
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" NoWarn="NU1701" />
    <PackageReference Include="FluentAssertions" Version="7.2.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- T-227: the settings round-trip now walks the secret store at open
         (the per-venue presence seed), so the DPAPI package must ship in
         this bin. The direct reference alone is NOT enough: this lane's
         runtime closure prunes it, because the test runtimeconfig declares
         the WindowsDesktop framework (its 10.0.14 pack serves the assembly)
         - but the staged app process resolves through its OWN runtimeconfig
         under Microsoft.NETCore.App only, so the file must sit next to the
         exe. The explicit copy ships it deterministically; the version pins
         the Infrastructure reference (a bump there moves this line too). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
    <None Include="$(NuGetPackageRoot)system.security.cryptography.protecteddata\10.0.13\lib\net10.0\System.Security.Cryptography.ProtectedData.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- T-176: the lane drives the COMPILED app, so the exe ships with this
         project reference - the launch path resolves from this test's own
         bin, the same artifact the solution build staged one step earlier. -->
    <ProjectReference Include="..\..\src\ZettaTrade.App\ZettaTrade.App.csproj" />
  </ItemGroup>

</Project>
